ymbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RichContent","kind":"identifier"}],"abstract":[{"type":"text","text":"Indicates the presence of math, chemical formulas, extended descriptions"},{"type":"text","text":" "},{"type":"text","text":"for information rich images, e.g., charts, diagrams, figures, graphs,"},{"type":"text","text":" "},{"type":"text","text":"and whether these are in an accessible format or available in an"},{"type":"text","text":" "},{"type":"text","text":"alternative form, e.g., whether math and chemical formulas are navigable"},{"type":"text","text":" "},{"type":"text","text":"with assistive technologies, or whether extended descriptions are"},{"type":"text","text":" "},{"type":"text","text":"available for information-rich images. In addition, it indicates the"},{"type":"text","text":" "},{"type":"text","text":"presence of videos and if closed captions, open captions, or transcripts"},{"type":"text","text":" "},{"type":"text","text":"for prerecorded audio are available."}],"role":"symbol","type":"topic","url":"\/documentation\/readiumshared\/accessibilitymetadatadisplayguide\/richcontent-swift.struct","title":"AccessibilityMetadataDisplayGuide.RichContent","navigatorTitle":[{"text":"RichContent","kind":"identifier"}]},"doc://Readium/documentation/ReadiumShared/AccessibilityMetadataDisplayGuide":{"navigatorTitle":[{"text":"AccessibilityMetadataDisplayGuide","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AccessibilityMetadataDisplayGuide","kind":"identifier"}],"identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide","title":"AccessibilityMetadataDisplayGuide","type":"topic","abstract":[{"text":"When presenting accessibility metadata provided by the publisher, it is","type":"text"},{"text":" ","type":"text"},{"text":"suggested that the section is introduced using terms such as “claims” or","t