{"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Content","interfaceLanguage":"swift"},"metadata":{"role":"article","roleHeading":"Article","title":"Extracting the content of a publication"},"seeAlsoSections":[{"generated":true,"anchor":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"title":"Guides"}],"kind":"article","primaryContentSections":[{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"text":"The described feature is still experimental and the implementation incomplete.","type":"text"}]}],"style":"note"},{"inlineContent":[{"type":"text","text":"Many high-level features require access to the raw content (text, media, etc.) of a publication, such as:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Text-to-speech"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Accessibility reader"}]}]},{"content":[{"inlineContent":[{"text":"Basic search","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full-text search indexing"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Image or audio indexes","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ContentService"},{"type":"text","text":" provides a way to iterate through a publication’s content, extracted as semantic elements."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"First, request the publication’s "},{"code":"Content","type":"codeVoice"},{"type":"text","text":", starting from a given "},{"code":"Locator","type":"codeVoice"},{"type":"text","text":". If the locator is missing, the "},{"code":"Content","type":"codeVoice"},{"type":"text","text":" will be extracted from the beginning of the publication."}],"type":"paragraph"},{"syntax":"swift","code":["guard let content = publication.content(from: startLocator) else {","    \/\/ Abort as the content cannot be extracted","    return","}"],"type":"codeListing"},{"anchor":"Extracting-the-raw-text-content","type":"heading","level":2,"text":"Extracting the raw text content"},{"inlineContent":[{"text":"Getting the whole raw text of a publication is such a common use case that a helper is available on ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let wholeText = content.text()"],"type":"codeListing"},{"inlineContent":[{"text":"This is an expensive operation, proceed with caution and cache the result if you need to reuse it.","type":"text"}],"type":"paragraph"},{"anchor":"Iterating-through-the-content","type":"heading","level":2,"text":"Iterating through the content"},{"inlineContent":[{"text":"The individual ","type":"text"},{"type":"codeVoice","code":"Content"},{"text":" elements can be iterated through with a regular ","type":"text"},{"type":"codeVoice","code":"for"},{"text":" loop by converting it to a sequence:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["for element in content.sequence() {","    \/\/ Process element","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Alternatively, you can get the whole list of elements with "},{"type":"codeVoice","code":"content.elements()"},{"type":"text","text":", or use the lower level APIs to iterate the content manually:"}],"type":"paragraph"},{"syntax":"swift","code":["let iterator = content.iterator()","while let element = try iterator.next() {","    print(element)","}"],"type":"codeListing"},{"inlineContent":[{"text":"Some ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":" implementations support bidirectional iterations. To iterate backwards, use:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let iterator = content.iterator()","while let element = try iterator.previous() {","    print(element)","}"],"type":"codeListing"},{"anchor":"Processing-the-elements","type":"heading","level":2,"text":"Processing the elements"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":" iterator yields ","type":"text"},{"code":"ContentElement","type":"codeVoice"},{"text":" objects representing a single semantic portion of the publication, such as a heading, a paragraph or an embedded image.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Every element has a ","type":"text"},{"code":"locator","type":"codeVoice"},{"text":" property targeting it in the publication. You can use the locator, for example, to navigate to the element or to draw a ","type":"text"},{"code":"Decoration","type":"codeVoice"},{"text":" on top of it.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["navigator.go(to: element.locator)"],"type":"codeListing"},{"anchor":"Types-of-elements","type":"heading","level":3,"text":"Types of elements"},{"inlineContent":[{"type":"text","text":"Depending on the actual implementation of "},{"type":"codeVoice","code":"ContentElement"},{"type":"text","text":", more properties are available to access the actual data. The toolkit ships with a number of default implementations for common types of elements."}],"type":"paragraph"},{"anchor":"Embedded-media","type":"heading","level":4,"text":"Embedded media"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"EmbeddedContentElement","type":"codeVoice"},{"text":" protocol is implemented by any element referencing an external resource. It contains an ","type":"text"},{"code":"embeddedLink","type":"codeVoice"},{"text":" property you can use to get the actual content of the resource.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["if let element = element as? EmbeddedContentElement {","    let bytes = try publication","        .get(element.embeddedLink)","        .read().get()","}"],"type":"codeListing"},{"inlineContent":[{"text":"Here are the default available implementations:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"AudioContentElement"},{"type":"text","text":" - audio clips"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"VideoContentElement"},{"type":"text","text":" - video clips"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ImageContentElement"},{"type":"text","text":" - bitmap images, with the additional property:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"caption: String?"},{"text":" - figure caption, when available","type":"text"}],"type":"paragraph"}]}]}]}],"type":"unorderedList"},{"anchor":"Text","type":"heading","level":4,"text":"Text"},{"anchor":"Textual-elements","type":"heading","level":5,"text":"Textual elements"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"TextualContentElement","type":"codeVoice"},{"text":" protocol is implemented by any element which can be represented as human-readable text. This is useful when you want to extract the text content of a publication without caring for each individual type of elements.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let wholeText = publication.content()","    .elements()","    .compactMap { ($0 as? TextualContentElement)?.text.takeIf { !$0.isEmpty } }","    .joined(separator: \"\\n\")"],"type":"codeListing"},{"anchor":"Text-elements","type":"heading","level":5,"text":"Text elements"},{"inlineContent":[{"type":"text","text":"Actual text elements are instances of "},{"type":"codeVoice","code":"TextContentElement"},{"type":"text","text":", which represent a single block of text such as a heading, a paragraph or a list item. It is comprised of a "},{"type":"codeVoice","code":"role"},{"type":"text","text":" and a list of "},{"type":"codeVoice","code":"segments"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"role"},{"type":"text","text":" is the nature of the text element in the document. For example a heading, body, footnote or a quote. It can be used to reconstruct part of the structure of the original document."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A text element is composed of individual segments with their own "},{"code":"locator","type":"codeVoice"},{"type":"text","text":" and "},{"code":"attributes","type":"codeVoice"},{"type":"text","text":". They are useful to associate attributes with a portion of a text element. For example, given the HTML paragraph:"}],"type":"paragraph"},{"syntax":"html","code":["<p>It is pronounced <span lang=\"fr\">croissant<\/span>.<\/p>"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The following "},{"type":"codeVoice","code":"TextContentElement"},{"type":"text","text":" will be produced:"}],"type":"paragraph"},{"syntax":"swift","code":["TextContentElement(","    role: .body,","    segments: [","        TextContentElement.Segment(text: \"It is pronounced \"),","        TextContentElement.Segment(text: \"croissant\", attributes: [ContentAttribute(key: .language, value: \"fr\")]),","        TextContentElement.Segment(text: \".\")","    ]",")"],"type":"codeListing"},{"inlineContent":[{"text":"If you are not interested in the segment attributes, you can also use ","type":"text"},{"type":"codeVoice","code":"element.text"},{"text":" to get the concatenated raw text.","type":"text"}],"type":"paragraph"},{"anchor":"Element-attributes","type":"heading","level":3,"text":"Element attributes"},{"inlineContent":[{"type":"text","text":"All types of "},{"code":"ContentElement","type":"codeVoice"},{"type":"text","text":" can have associated attributes. Custom "},{"code":"ContentService","type":"codeVoice"},{"type":"text","text":" implementations can use this as an extensibility point."}],"type":"paragraph"},{"anchor":"Use-cases","type":"heading","level":2,"text":"Use cases"},{"anchor":"An-index-of-all-images-embedded-in-the-publication","type":"heading","level":3,"text":"An index of all images embedded in the publication"},{"inlineContent":[{"type":"text","text":"This example extracts all the embedded images in the publication and displays them in a SwiftUI list. Clicking on an image jumps to its location in the publication."}],"type":"paragraph"},{"syntax":"swift","code":["struct ImageIndex: View {","    struct Item: Hashable {","        let locator: Locator","        let text: String?","        let image: UIImage","    }","","    let publication: Publication","    let navigator: Navigator","    @State private var items: [Item] = []","","    init(publication: Publication, navigator: Navigator) {","        self.publication = publication","        self.navigator = navigator","    }","","    var body: some View {","        ScrollView {","            LazyVStack {","                ForEach(items, id: \\.self) { item in","                    VStack() {","                        Image(uiImage: item.image)","                        Text(item.text ?? \"No caption\")","                    }","                    .onTapGesture {","                        navigator.go(to: item.locator)","                    }","                }","            }","        }","        .onAppear {","            items = publication.content()?","                .elements()","                .compactMap { element in","                    guard","                        let element = element as? ImageContentElement,","                        let image = try? publication.get(element.embeddedLink)","                            .read().map(UIImage.init).get()","                    else {","                        return nil","                    }","","                    return Item(","                        locator: element.locator,","                        text: element.caption ?? element.accessibilityLabel,","                        image: image","                    )","                }","                ?? []","        }","    }","}"],"type":"codeListing"},{"anchor":"References","type":"heading","level":2,"text":"References"},{"items":[{"content":[{"inlineContent":[{"identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177","isActive":true,"type":"reference"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"references":{"doc://Readium/documentation/Readium/Accessibility":{"abstract":[{"type":"text","text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the "},{"isActive":true,"type":"reference","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11"},{"type":"text","text":" specification."}],"title":"Accessibility","type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","kind":"article","url":"\/documentation\/readium\/accessibility","role":"article"},"doc://Readium/documentation/Readium/NavigatorOverview":{"abstract":[{"type":"text","text":"Learn about the architecture, configuration, and usage of the Readium Navigator."}],"title":"Navigator Overview","identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","url":"\/documentation\/readium\/navigatoroverview","kind":"article","type":"topic","role":"article"},"https://www.edrlab.org/readium-lcp/":{"titleInlineContent":[{"text":"Readium LCP","type":"text"}],"url":"https:\/\/www.edrlab.org\/readium-lcp\/","title":"Readium LCP","type":"link","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/"},"https://www.w3.org/TR/epub-a11y-11":{"url":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"link","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","title":"EPUB Accessibility","titleInlineContent":[{"type":"text","text":"EPUB Accessibility"}]},"https://github.com/readium/architecture/pull/177":{"titleInlineContent":[{"text":"Content Iterator proposal","type":"text"}],"url":"https:\/\/github.com\/readium\/architecture\/pull\/177","title":"Content Iterator proposal","type":"link","identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177"},"doc://Readium/documentation/Readium/Readium-LCP":{"type":"topic","abstract":[{"text":"You can use the Readium Swift toolkit to download and read publications that are protected with the ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/"},{"text":" DRM.","type":"text"}],"url":"\/documentation\/readium\/readium-lcp","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","title":"Supporting Readium LCP","role":"article","kind":"article"},"doc://Readium/documentation/Readium/TTS":{"role":"article","title":"Text-to-speech","kind":"article","url":"\/documentation\/readium\/tts","type":"topic","abstract":[],"identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS"},"doc://Readium/documentation/Readium/Open-Publication":{"abstract":[{"text":"To open a publication with Readium, you need to instantiate a couple of components: an ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":" and a ","type":"text"},{"type":"codeVoice","code":"PublicationOpener"},{"text":".","type":"text"}],"url":"\/documentation\/readium\/open-publication","kind":"article","title":"Opening a publication","role":"article","type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication"},"doc://Readium/documentation/Readium/Search":{"type":"topic","url":"\/documentation\/readium\/search","abstract":[{"type":"text","text":"The Search API lets you look for a textual query in the content of a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":". EPUB and PDF publications are supported."}],"kind":"article","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","title":"Searching a publication"},"doc://Readium/documentation/Readium/Getting-Started":{"type":"topic","url":"\/documentation\/readium\/getting-started","kind":"article","abstract":[{"text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics.","type":"text"}],"title":"Getting started","identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","role":"article"},"doc://Readium/documentation/Readium/Migration-Guide":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","title":"Migration Guide","kind":"article","url":"\/documentation\/readium\/migration-guide","abstract":[{"type":"text","text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file."}],"role":"article"},"doc://Readium/documentation/Readium":{"url":"\/documentation\/readium","role":"collection","title":"Readium","kind":"article","abstract":[{"text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin.","type":"text"}],"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium"}}}