actory","type":"codeVoice"},{"text":" which handles the URL schemes through which you can access content.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ArchiveOpener"},{"type":"text","text":" which determines the types of archives (ZIP, RAR, etc.) that can be opened by the "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FormatSniffer"},{"type":"text","text":" which identifies the file formats that "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":" can recognize."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use either the default implementations or implement your own for each of these components using the composite pattern. The toolkit’s "},{"type":"codeVoice","code":"CompositeResourceFactory"},{"type":"text","text":", "},{"type":"codeVoice","code":"CompositeArchiveOpener"},{"type":"text","text":", and "},{"type":"codeVoice","code":"CompositeFormatSniffer"},{"type":"text","text":" provide a simple resolution strategy."}]}],"kind":"content"}],"kind":"article","references":{"doc://Readium/documentation/Readium/NavigatorOverview":{"abstract":[{"type":"text","text":"Learn about the architecture, configuration, and usage of the Readium Navigator."}],"title":"Navigator Overview","identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","url":"\/documentation\/readium\/navigatoroverview","kind":"article","type":"topic","role":"article"},"doc://Readium/documentation/Readium/Content":{"url":"\/documentation\/readium\/content","identifier":"doc:\/\/Readium\/documentation\/Readium\/Content","kind":"article","type":"topic","role":"article","abstract":[],"title":"Extracting the content of a publication"},"doc://Readium/documentation/Readium/TTS":{"role":"article","title":"Text-to-speech","kind":"article","url":"\/documentation\/readiu