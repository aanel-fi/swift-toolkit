{"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","interfaceLanguage":"swift"},"kind":"article","metadata":{"title":"Supporting Readium LCP","roleHeading":"Article","role":"article"},"seeAlsoSections":[{"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility"],"generated":true,"title":"Guides","anchor":"Guides"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!IMPORTANT]"},{"type":"text","text":" "},{"type":"text","text":"To use LCP with the Readium toolkit, you must first obtain the "},{"type":"codeVoice","code":"R2LCPClient"},{"type":"text","text":" private library by contacting "},{"type":"reference","identifier":"https:\/\/www.edrlab.org\/contact\/","isActive":true},{"type":"text","text":"."}]}]},{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An LCP publication is protected with a "},{"type":"emphasis","inlineContent":[{"text":"user passphrase","type":"text"}]},{"type":"text","text":" and distributed using an LCP License Document ("},{"type":"codeVoice","code":".lcpl"},{"type":"text","text":") ."}]},{"type":"paragraph","inlineContent":[{"text":"The user flow typically goes as follows:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user imports a "},{"type":"codeVoice","code":".lcpl"},{"type":"text","text":" file into your application."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The application uses the Readium toolkit to download the protected publication from the ","type":"text"},{"code":".lcpl","type":"codeVoice"},{"text":" file to the user’s bookshelf. The downloaded file can be a ","type":"text"},{"code":".epub","type":"codeVoice"},{"text":", ","type":"text"},{"code":".lcpdf","type":"codeVoice"},{"text":" (PDF), or ","type":"text"},{"code":".lcpa","type":"codeVoice"},{"text":" (audiobook) package.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The user opens the protected publication from the bookshelf.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If the passphrase isn’t already recorded in the "},{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" internal database, the user will be asked to enter it to unlock the contents."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The publication is decrypted and rendered on the screen."}],"type":"paragraph"}]}]},{"level":2,"type":"heading","text":"Setup","anchor":"Setup"},{"type":"paragraph","inlineContent":[{"text":"To support LCP in your application, you require two components:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"code":"ReadiumLCP","type":"codeVoice"},{"text":" package from the toolkit provides APIs for downloading and decrypting protected publications. Import it as you would any other Readium package, such as ","type":"text"},{"code":"R2Navigator","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The private ","type":"text"},{"code":"R2LCPClient","type":"codeVoice"},{"text":" library customized for your application ","type":"text"},{"overridingTitleInlineContent":[{"type":"text","text":"is available from EDRLab"}],"isActive":true,"type":"reference","overridingTitle":"is available from EDRLab","identifier":"https:\/\/www.edrlab.org\/contact\/"},{"text":". They will provide instructions for integrating the ","type":"text"},{"code":"R2LCPClient","type":"codeVoice"},{"text":" framework into your application.","type":"text"}]}]}]},{"level":3,"type":"heading","text":"File formats","anchor":"File-formats"},{"type":"paragraph","inlineContent":[{"text":"Readium LCP specifies new file formats.","type":"text"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Name","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"File extension"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Media type"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lcp\/latest.html#32-content-conformance"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".lcpl"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"application\/vnd.readium.lcp.license.v1.0+json"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-pdf.html","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":".lcpdf","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"application\/pdf+lcp"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-audiobooks.html","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".lcpa"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"application\/audiobook+lcp"}]}]]],"type":"table"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"text","text":"EPUB files protected by LCP are supported without a special file extension or media type because EPUB accommodates any DRM scheme in its specification."}]}],"type":"aside","name":"Note"},{"type":"paragraph","inlineContent":[{"text":"To support these formats in your application, you need to ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/defining_file_and_data_types_for_your_app"},{"text":" as imported types.","type":"text"}]},{"code":["<dict>","    <key>UTImportedTypeDeclarations<\/key>","    <array>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpl<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.json<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP License Document<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpl<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/vnd.readium.lcp.license.v1.0+json<\/string>","            <\/dict>","        <\/dict>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpdf<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.archive<\/string>","                <string>public.zip-archive<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP for PDF package<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpdf<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/pdf+lcp<\/string>","            <\/dict>","        <\/dict>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpa<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.archive<\/string>","                <string>public.zip-archive<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP for Audiobooks package<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpa<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/audiobook+lcp<\/string>","            <\/dict>","        <\/dict>","    <\/array>","<\/dict>"],"syntax":"xml","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Next, declare the imported types as "},{"type":"reference","isActive":true,"identifier":"https:\/\/help.apple.com\/xcode\/mac\/current\/#\/devddd273fdd"},{"type":"text","text":" in the "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" to have your application listed in the “Open with…” dialogs."}]},{"code":["<dict>","    <key>CFBundleDocumentTypes<\/key>","    <array>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP License Document<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpl<\/string>","            <\/array>","        <\/dict>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP for PDF package<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpdf<\/string>","            <\/array>","        <\/dict>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP for Audiobooks package<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpa<\/string>","            <\/array>","        <\/dict>","    <\/array>","<\/dict>"],"syntax":"xml","type":"codeListing"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!TIP]"},{"type":"text","text":" "},{"type":"text","text":"If EPUB is not included in your document types, now is a good time to add it."}]}],"type":"aside","name":"Note"},{"anchor":"Allow-insecure-HTTP-requests","text":"Allow insecure HTTP requests","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A file required by the LCP library needs to be downloaded from an insecure HTTP location. You must authorize this download by adding the following to your "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" file:"}]},{"code":["<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSExceptionDomains<\/key>","    <dict>","        <key>crl.edrlab.telesec.de<\/key>","        <dict>","            <key>NSExceptionAllowsInsecureHTTPLoads<\/key>","            <true\/>","        <\/dict>","    <\/dict>","<\/dict>"],"syntax":"xml","type":"codeListing"},{"level":3,"anchor":"Device-name-for-LCP-registration","type":"heading","text":"Device name for LCP registration"},{"inlineContent":[{"text":"When registering a license with an LSD server, Readium LCP identifies the device by name using ","type":"text"},{"code":"UIDevice.current.name","type":"codeVoice"},{"text":". Since iOS 16, this returns a generic string such as “iPhone” instead of the user-assigned device name.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To obtain the actual device name, add the "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/bundleresources\/entitlements\/com_apple_developer_device-information_user-assigned-device-name","isActive":true},{"type":"text","text":" entitlement to your app’s "},{"type":"codeVoice","code":".entitlements"},{"type":"text","text":" file. This entitlement requires approval from Apple."}],"type":"paragraph"},{"code":["<key>com.apple.developer.device-information.user-assigned-device-name<\/key>","<true\/>"],"syntax":"xml","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Alternatively, you can supply your own device name when initializing "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":" via the "},{"type":"codeVoice","code":"deviceName"},{"type":"text","text":" parameter."}],"type":"paragraph"},{"level":2,"anchor":"Initializing-the-LCPService","type":"heading","text":"Initializing the `LCPService`"},{"inlineContent":[{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" offers an "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":" object that exposes its API. Since the "},{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" package is not linked with "},{"type":"codeVoice","code":"R2LCPClient"},{"type":"text","text":", you need to create your own adapter when setting up the "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"LCPService"},{"text":" expects repositories to store the opened licenses and passphrases. ","type":"text"},{"type":"codeVoice","code":"ReadiumLCP"},{"text":" provides built-in Keychain-based implementations that store data securely in the iOS\/macOS Keychain. Unlike database-based storage, Keychain data persists across app reinstalls and can optionally be synchronized across the user’s devices via iCloud Keychain.","type":"text"}],"type":"paragraph"},{"code":["import R2LCPClient","import ReadiumLCP","","let httpClient = DefaultHTTPClient()","","let assetRetriever = AssetRetriever(","    httpClient: httpClient",")","","let lcpService = LCPService(","    client: LCPClientAdapter(),","    licenseRepository: LCPKeychainLicenseRepository(),","    passphraseRepository: LCPKeychainPassphraseRepository(),","    assetRetriever: assetRetriever,","    httpClient: httpClient",")","","\/\/\/ Facade to the private R2LCPClient.framework.","class LCPClientAdapter: ReadiumLCP.LCPClient {","    func createContext(jsonLicense: String, hashedPassphrase: LCPPassphraseHash, pemCrl: String) throws -> LCPClientContext {","        try R2LCPClient.createContext(jsonLicense: jsonLicense, hashedPassphrase: hashedPassphrase, pemCrl: pemCrl)","    }","","    func decrypt(data: Data, using context: LCPClientContext) -> Data? {","        R2LCPClient.decrypt(data: data, using: context as! DRMContext)","    }","","    func findOneValidPassphrase(jsonLicense: String, hashedPassphrases: [LCPPassphraseHash]) -> LCPPassphraseHash? {","        R2LCPClient.findOneValidPassphrase(jsonLicense: jsonLicense, hashedPassphrases: hashedPassphrases)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"To disable iCloud synchronization, pass ","type":"text"},{"type":"codeVoice","code":"synchronizable: false"},{"type":"text","text":" when creating the repositories."}],"type":"paragraph"},{"inlineContent":[{"text":"You may also implement your own persistence layer by conforming to ","type":"text"},{"code":"LCPLicenseRepository","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"LCPPassphraseRepository","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Acquiring-a-publication-from-a-License-Document-LCPL","type":"heading","text":"Acquiring a publication from a License Document (LCPL)"},{"inlineContent":[{"text":"Users need to import a License Document into your application to download the protected publication (","type":"text"},{"code":".epub","type":"codeVoice"},{"text":", ","type":"text"},{"code":".lcpdf","type":"codeVoice"},{"text":", or ","type":"text"},{"code":".lcpa","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"LCPService"},{"text":" offers an API to retrieve the full publication from an LCPL on the filesystem.","type":"text"}],"type":"paragraph"},{"code":["let result = await lcpService.acquirePublication(","    from: .file(lcplURL),","    onProgress: { progress in","        switch progress {","            case .indefinite:","                \/\/ Display an activity indicator.","            case .percent(let percent):","                \/\/ Display a progress bar with percent from 0 to 1.","        }","    }",")","","switch result {","case let .success(publication):","    \/\/ Import the `publication.localURL` file as any publication.","case let .failure(error):","    \/\/ Display the error message.","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"After the download is completed, import the "},{"code":"publication.localURL","type":"codeVoice"},{"text":" file into the bookshelf like any other publication file.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Opening-a-publication-protected-with-LCP","type":"heading","text":"Opening a publication protected with LCP"},{"level":3,"anchor":"Initializing-the-PublicationOpener","type":"heading","text":"Initializing the `PublicationOpener`"},{"inlineContent":[{"text":"A publication protected with LCP can be opened using the ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":" component, just like a non-protected publication. However, you must provide a ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/readium.org\/architecture\/proposals\/006-content-protection.html"},{"text":" implementation when initializing the ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":" to enable LCP. Luckily, ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":" has you covered.","type":"text"}],"type":"paragraph"},{"code":["let httpClient = DefaultHTTPClient()","","let authentication = LCPDialogAuthentication()","","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: AssetRetriever(httpClient: httpClient),","        pdfFactory: DefaultPDFDocumentFactory()","    ),","    contentProtections: [","        lcpService.contentProtection(with: authentication)","    ]",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"An LCP package is secured with a ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"user passphrase","type":"text"}]},{"text":" for decrypting the content. The ","type":"text"},{"type":"codeVoice","code":"LCPAuthenticating"},{"text":" protocol used by ","type":"text"},{"type":"codeVoice","code":"LCPService.contentProtection(with:)"},{"text":" provides the passphrase when needed. You can use the default UIKit ","type":"text"},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"text":" which displays a pop-up to enter the passphrase, or implement your own method for passphrase retrieval. If your application is built using SwiftUI, ","type":"text"},{"identifier":"#using-the-swiftui-lcp-authentication-dialog","type":"reference","isActive":true}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"text":"The user will be prompted once per passphrase since ","type":"text"},{"code":"ReadiumLCP","type":"codeVoice"},{"text":" stores known passphrases on the device.","type":"text"}]}],"style":"note","type":"aside","name":"Note"},{"level":3,"anchor":"Opening-the-publication","type":"heading","text":"Opening the publication"},{"inlineContent":[{"type":"text","text":"You are now ready to open the publication file with your "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":" instance."}],"type":"paragraph"},{"code":["\/\/ Retrieve an `Asset` to access the file content.","let url = FileURL(path: \"\/path\/to\/lcp-protected-book.epub\", isDirectory: false)","let asset = try await assetRetriever.retrieve(url: url).get()"," ","\/\/ Open a `Publication` from the `Asset`.","let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    sender: hostViewController",")","","switch result {","case .success(let publication):","    \/\/ Import or present the publication.","case .failure(let error):","    \/\/ Present the error.","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" and "},{"type":"codeVoice","code":"sender"},{"type":"text","text":" arguments are forwarded to the "},{"type":"codeVoice","code":"LCPAuthenticating"},{"type":"text","text":" implementation when the passphrase is unknown. "},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"type":"text","text":" shows a pop-up only if "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"text":", using the ","type":"text"},{"code":"sender","type":"codeVoice"},{"text":" as the pop-up’s host ","type":"text"},{"code":"UIViewController","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When importing the publication to the bookshelf, set "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" as you don’t need the passphrase for accessing the publication metadata and cover. If you intend to present the publication using a Navigator, set "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" as decryption will be required."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"[!TIP]"},{"type":"text","text":" "},{"type":"text","text":"To check if an asset is protected with LCP before opening it, you can use "},{"code":"asset.format.conformsTo(.lcp)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"level":3,"anchor":"Using-the-opened-Publication","type":"heading","text":"Using the opened `Publication`"},{"inlineContent":[{"type":"text","text":"After obtaining a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" instance, you can access the publication’s metadata to import it into the user’s bookshelf. The user passphrase is not needed for reading the metadata or cover."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"However, if you want to display the publication with a Navigator, verify it is not restricted. It could be restricted if the user passphrase is unknown or if the license is no longer valid (e.g., expired loan, revoked purchase, etc.)."}],"type":"paragraph"},{"code":["if publication.isRestricted {","    if let error = publication.protectionError as? LCPError {","        \/\/ The user is not allowed to open the publication. You should display the error.","    } else {","        \/\/ We don't have the user passphrase.","        \/\/ You may use `publication` to access its metadata, but not to render its content.","    }","} else {","    \/\/ The publication is not restricted, you may render it with a Navigator component.","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Streaming-an-LCP-protected-package","type":"heading","text":"Streaming an LCP protected package"},{"inlineContent":[{"text":"If the server hosting the LCP protected package supports the ","type":"text"},{"identifier":"https:\/\/httpwg.org\/specs\/rfc9110.html#HEAD","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"https:\/\/httpwg.org\/specs\/rfc7233.html","isActive":true,"type":"reference"},{"text":", it is possible to stream directly an LCP protected publication from a License Document (","type":"text"},{"code":".lcpl","type":"codeVoice"},{"text":") file, without downloading the whole publication first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Simply open the License Document directly using the "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":". Make sure you provide an "},{"type":"codeVoice","code":"HTTPClient"},{"type":"text","text":" (or an "},{"type":"codeVoice","code":"HTTPResourceFactory"},{"type":"text","text":" for additional customization) to the "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["\/\/ Instantiate the required components.","let httpClient = DefaultHTTPClient()","let assetRetriever = AssetRetriever(httpClient: httpClient)","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever","    ),","    contentProtections: [","        lcpService.contentProtection(with: LCPDialogAuthentication()),","    ]",")","","\/\/ Retrieve an `Asset` to access the LCPL content.","let url = FileURL(path: \"\/path\/to\/license.lcpl\", isDirectory: false)","let asset = try await assetRetriever.retrieve(url: url).get()"," ","\/\/ Open a `Publication` from the LCPL `Asset`.","let publication = try await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    sender: hostViewController",").get()","    ","print(\"Opened \\(publication.metadata.title)\")"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Obtaining-information-on-an-LCP-license","type":"heading","text":"Obtaining information on an LCP license"},{"inlineContent":[{"type":"text","text":"An LCP License Document contains metadata such as its expiration date, the remaining number of characters to copy and the user name. You can access this information using an "},{"code":"LCPLicense","type":"codeVoice"},{"type":"text","text":" object."}],"type":"paragraph"},{"inlineContent":[{"text":"Use the ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":" to retrieve the ","type":"text"},{"code":"LCPLicense","type":"codeVoice"},{"text":" instance for a publication.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let result = await lcpService.retrieveLicense(","    from: asset,","    authentication: LCPDialogAuthentication(),","    allowUserInteraction: true,","    sender: hostViewController",")","","switch result {","case .success(let lcpLicense):","    if let user = lcpLicense.license.user.name {","        print(\"The publication was acquired by \\(user)\")","    }","    if let endDate = lcpLicense.license.rights.end {","        print(\"The loan expires on \\(endDate)\")","    }","    if let copyLeft = await lcpLicense.charactersToCopyLeft() {","        print(\"You can copy up to \\(copyLeft) characters remaining.\")","    }","case .failure(let error):","    \/\/ Display the error.","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If you have already opened a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":", you can directly obtain the "},{"type":"codeVoice","code":"LCPLicense"},{"type":"text","text":" using "},{"type":"codeVoice","code":"publication.lcpLicense"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Managing a loan","level":2,"type":"heading","anchor":"Managing-a-loan"},{"inlineContent":[{"text":"Readium LCP allows borrowing publications for a specific period. Use the ","type":"text"},{"code":"LCPLicense","type":"codeVoice"},{"text":" object to manage a loan and retrieve its end date using ","type":"text"},{"code":"lcpLicense.license.rights.end","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Returning a loan","level":3,"type":"heading","anchor":"Returning-a-loan"},{"inlineContent":[{"text":"Some loans can be returned before the end date. You can confirm this by using ","type":"text"},{"type":"codeVoice","code":"lcpLicense.canReturnPublication"},{"text":". To return the publication, execute:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let result = await lcpLicense.returnPublication()","switch result {","case .success:","    \/\/ The publication was returned.","case .failure(let error):","    \/\/ Present the error.","}"],"type":"codeListing"},{"text":"Renewing a loan","level":3,"type":"heading","anchor":"Renewing-a-loan"},{"inlineContent":[{"type":"text","text":"The loan end date may also be extended. You can confirm this by using "},{"code":"lcpLicense.canRenewLoan","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Readium LCP supports ","type":"text"},{"identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lsd\/latest#35-renewing-a-license","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Programmatic: You show your own user interface."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Interactive: You display a web view, and the Readium LSD server manages the renewal for you."}]}]}]},{"inlineContent":[{"type":"text","text":"You need to support both interactions by implementing the "},{"type":"codeVoice","code":"LCPRenewDelegate"},{"type":"text","text":" protocol. A default implementation is available with "},{"type":"codeVoice","code":"LCPDefaultRenewDelegate"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["let result = await lcpLicense.renewLoan(","    with: LCPDefaultRenewDelegate(","        presentingViewController: hostViewController","    )",")","","switch result {","case .success:","    \/\/ The publication was renewed.","case let .failure(error):","    \/\/ Display the error.","}"],"type":"codeListing"},{"text":"Handling `LCPError`","level":2,"type":"heading","anchor":"Handling-LCPError"},{"inlineContent":[{"text":"The APIs may fail with an ","type":"text"},{"code":"LCPError","type":"codeVoice"},{"text":". These errors ","type":"text"},{"inlineContent":[{"text":"must","type":"text"}],"type":"strong"},{"text":" be displayed to the user with a suitable message.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For an example, "},{"type":"reference","identifier":"https:\/\/github.com\/readium\/swift-toolkit\/blob\/3.0.0\/TestApp\/Sources\/App\/Readium.swift#L221","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Using the SwiftUI LCP Authentication dialog","level":2,"type":"heading","anchor":"Using-the-SwiftUI-LCP-Authentication-dialog"},{"inlineContent":[{"text":"If your application is built using SwiftUI, you cannot use ","type":"text"},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"text":" because it requires a UIKit view controller as its host. Instead, use an ","type":"text"},{"type":"codeVoice","code":"LCPObservableAuthentication"},{"text":" combined with our SwiftUI ","type":"text"},{"type":"codeVoice","code":"LCPDialog"},{"text":" presented as a sheet.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@main","struct MyApp: App {","    private let lcpService: LCPService","    private let publicationOpener: PublicationOpener","","    @StateObject private var lcpAuthentication: LCPObservableAuthentication","","    init() {","        \/\/ Create an `LCPObservableAuthentication` which will be used","        \/\/ to initialize the `LCPContentProtection`.","        \/\/","        \/\/ With SwiftUI, it must be stored in a `@StateObject` property","        \/\/ to observe the authentication requests.","        let lcpAuthentication = LCPObservableAuthentication()","        _lcpAuthentication = StateObject(wrappedValue: lcpAuthentication)","","        lcpService = LCPService(...)","","        publicationOpener = PublicationOpener(","            ...,","            contentProtections: [","                lcpService.contentProtection(with: lcpAuthentication)","            ]","        )","    }","","    var body: some Scene {","        WindowGroup {","            ContentView()","                \/\/ You can present an `LCPDialog` when the `LCPObservableAuthentication`","                \/\/ `request` property is updated.","                .sheet(item: $lcpAuthentication.request) {","                    LCPDialog(request: $0)","                }","            }","        }","    }","}"],"type":"codeListing"}]}],"sections":[],"abstract":[{"text":"You can use the Readium Swift toolkit to download and read publications that are protected with the ","type":"text"},{"isActive":true,"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","type":"reference"},{"text":" DRM.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://Readium/documentation/Readium/Search":{"type":"topic","url":"\/documentation\/readium\/search","abstract":[{"type":"text","text":"The Search API lets you look for a textual query in the content of a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":". EPUB and PDF publications are supported."}],"kind":"article","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","title":"Searc