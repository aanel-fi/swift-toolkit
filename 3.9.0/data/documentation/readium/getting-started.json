{"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started"},"abstract":[{"text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics.","type":"text"}],"seeAlsoSections":[{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"sections":[],"metadata":{"role":"article","roleHeading":"Article","title":"Getting started"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"text":"Readium offers only low-level tools. You are responsible for creating a user interface for reading and managing books, as well as a data layer to store the user’s publications. The Test App is an example of such integration.","type":"text"}],"type":"paragraph"}]},{"text":"Design principles","type":"heading","level":2,"anchor":"Design-principles"},{"type":"paragraph","inlineContent":[{"text":"The toolkit has been designed following these core tenets:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Modular","type":"text"}],"type":"strong"},{"type":"text","text":": It is divided into separate modules that can be used independently."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Extensible","type":"text"}]},{"type":"text","text":": Integrators should be able to support a custom DRM, publication format or inject their own stylesheets without modifying the toolkit itself."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Opiniated"}],"type":"strong"},{"text":": We adhere to open standards but sometimes interpret them for practicality.","type":"text"}]}]}]},{"text":"Packages","type":"heading","level":2,"anchor":"Packages"},{"text":"Main packages","type":"heading","level":3,"anchor":"Main-packages"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"ReadiumShared"},{"type":"text","text":" contains shared "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" models and utilities."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ReadiumStreamer","type":"codeVoice"},{"text":" parses publication files (e.g. an EPUB) into a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" object.","type":"text"}]}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"Navigator\/Navigator.md","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"text":"Specialized packages","type":"heading","level":3,"anchor":"Specialized-packages"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"ReadiumOPDS","type":"codeVoice"},{"text":" parses ","type":"text"},{"identifier":"https:\/\/opds.io","isActive":true,"type":"reference"},{"text":" (both OPDS 1 and 2).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"Readium%20LCP.md","isActive":true},{"type":"text","text":"."}]}]}]},{"text":"Overview of the shared models (`ReadiumShared`)","type":"heading","level":2,"anchor":"Overview-of-the-shared-models-ReadiumShared"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Readium toolkit provides models used as exchange types between packages."}]},{"text":"Publication models","type":"heading","level":3,"anchor":"Publication-models"},{"text":"Publication","type":"heading","level":4,"anchor":"Publication"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Publication"},{"text":" and its sub-components represent a single publication – ebook, audiobook or comic. It is loosely based on the ","type":"text"},{"type":"reference","identifier":"https:\/\/readium.org\/webpub-manifest\/","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" instance:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"holds the metadata of a publication, such as its author or table of contents,","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"allows to read the contents of a publication, e.g. XHTML or audio resources,","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"provides additional services, for example content extraction or text search.","type":"text"}]}]}]},{"text":"Link","type":"heading","level":4,"anchor":"Link"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"reference","identifier":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object","isActive":true},{"text":" holds a pointer (URL) to a resource or service along with additional metadata, such as its media type or title.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" contains several "},{"type":"codeVoice","code":"Link"},{"type":"text","text":" collections, for example:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"readingOrder","type":"codeVoice"},{"type":"text","text":" lists the publication resources arranged in the order they should be read."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"resources"},{"text":" contains secondary resources necessary for rendering the ","type":"text"},{"type":"codeVoice","code":"readingOrder"},{"text":", such as an image or a font file.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"tableOfContents","type":"codeVoice"},{"type":"text","text":" represents the table of contents as a tree of "},{"code":"Link","type":"codeVoice"},{"type":"text","text":" objects."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"links"},{"type":"text","text":" exposes additional resources, such as a canonical link to the manifest or a search web service."}],"type":"paragraph"}]}]},{"text":"Locator","type":"heading","level":4,"anchor":"Locator"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"https:\/\/readium.org\/architecture\/models\/locators\/"},{"type":"text","text":" represents a precise location in a publication resource in a format that can be stored and shared across reading systems. It is more accurate than a "},{"code":"Link","type":"codeVoice"},{"type":"text","text":" and contains additional information about the location, e.g. progression percentage, position or textual context."}]},{"type":"paragraph","inlineContent":[{"code":"Locator","type":"codeVoice"},{"type":"text","text":" objects are used for various features, including:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"reporting the current progression in the publication"}]}]},{"content":[{"inlineContent":[{"text":"saving bookmarks, highlights and annotations","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"navigating search results"}],"type":"paragraph"}]}]},{"text":"Data models","type":"heading","level":3,"anchor":"Data-models"},{"text":"Asset","type":"heading","level":4,"anchor":"Asset"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":" represents a single file or package and provides access to its content. There are two types of "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"ContainerAsset"},{"text":" for packages which contains several resources, such as a ZIP archive.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ResourceAsset"},{"type":"text","text":" for accessing a single resource, such as a JSON or PDF file."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"code":"Asset","type":"codeVoice"},{"text":" instances are obtained through an ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use the "},{"type":"codeVoice","code":"asset.format"},{"type":"text","text":" to identify the media type and capabilities of the asset."}]},{"type":"codeListing","syntax":"swift","code":["if asset.format.conformsTo(.lcp) {","    \/\/ The asset is protected with LCP.","}","if asset.format.conformsTo(.epub) {","    \/\/ The asset represents an EPUB publication.","}"]},{"text":"Resource","type":"heading","level":4,"anchor":"Resource"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"Resource"},{"text":" provides read access to a single resource, such as a file or an entry in an archive.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Resource"},{"text":" instances are usually created by a ","type":"text"},{"type":"codeVoice","code":"ResourceFactory"},{"text":". The toolkit ships with various implementations supporting different data access protocols such as local files or HTTP.","type":"text"}]},{"text":"Container","type":"heading","level":4,"anchor":"Container"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"Container","type":"codeVoice"},{"type":"text","text":" provides read access to a collection of resources. "},{"code":"Container","type":"codeVoice"},{"type":"text","text":" instances representing an archive are usually created by an "},{"code":"ArchiveOpener","type":"codeVoice"},{"type":"text","text":". The toolkit ships with a "},{"code":"ZIPArchiveOpener","type":"codeVoice"},{"type":"text","text":" supporting both local and remote (HTTP) ZIP files."}]},{"type":"paragraph","inlineContent":[{"code":"Publication","type":"codeVoice"},{"type":"text","text":" objects internally use a "},{"code":"Container","type":"codeVoice"},{"type":"text","text":" to expose its content."}]},{"text":"Opening a publication (`ReadiumStreamer`)","type":"heading","level":2,"anchor":"Opening-a-publication-ReadiumStreamer"},{"type":"paragraph","inlineContent":[{"text":"To retrieve a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" object from a publication file like an EPUB or audiobook, you can use an ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Instantiate the required components.","let httpClient = DefaultHTTPClient()","let assetRetriever = AssetRetriever(","    httpClient: httpClient",")","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever,","        pdfFactory: DefaultPDFDocumentFactory()","    )",")","","let url: URL = URL(...)","","\/\/ Retrieve an `Asset` to access the file content.","switch await assetRetriever.retrieve(url: url.anyURL.absoluteURL!) {","case .success(let asset):","    \/\/ Open a `Publication` from the `Asset`.","    switch await publicationOpener.open(asset: asset, allowUserInteraction: true, sender: view) {","    case .success(let publication):","        print(\"Opened \\(publication.metadata.title)\")","","    case .failure(let error):","        \/\/ Failed to access or parse the publication","    }","","case .failure(let error):","    \/\/ Failed to retrieve the asset","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" parameter is useful when supporting a DRM like Readium LCP. It indicates if the toolkit can prompt the user for credentials when the publication is protected."}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"Open%20Publication.md"},{"type":"text","text":"."}]},{"text":"Accessing the metadata of a publication","type":"heading","level":2,"anchor":"Accessing-the-metadata-of-a-publication"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After opening a publication, you may want to read its metadata to insert a new entity into your bookshelf database, for instance. The "},{"type":"codeVoice","code":"publication.metadata"},{"type":"text","text":" object contains everything you need, including "},{"type":"codeVoice","code":"title"},{"type":"text","text":", "},{"type":"codeVoice","code":"authors"},{"type":"text","text":" and the "},{"type":"codeVoice","code":"published"},{"type":"text","text":" date."}]},{"type":"paragraph","inlineContent":[{"text":"You can retrieve the publication cover using ","type":"text"},{"code":"await publication.cover()","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"Rendering the publication on the screen (`ReadiumNavigator`)","type":"heading","level":2,"anchor":"Rendering-the-publication-on-the-screen-ReadiumNavigator"},{"type":"paragraph","inlineContent":[{"text":"You can use a Readium navigator to present the publication to the user. The ","type":"text"},{"type":"codeVoice","code":"Navigator"},{"text":" renders resources on the screen and offers APIs and user interactions for navigating the contents.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Please refer to the "},{"identifier":"Navigator\/Navigator.md","type":"reference","overridingTitle":"Navigator guide","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"Navigator guide"}]},{"type":"text","text":" for more information."}]}]}],"references":{"doc://Readium/documentation/Readium":{"url":"\/documentation\/readium","role":"collection","title":"Readium","kind":"article","abstract":[{"text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin.","type":"text"}],"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium"},"doc://Readium/documentation/Readium/Open-Publication":{"abstract":[{"text":"To open a publication with Readium, you need to instantiate a couple of components: an ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":" and a ","type":"text"},{"type":"codeVoice","code":"PublicationOpener"},{"text":".","type":"text"}],"url":"\/documentation\/readium\/open-publication","kind":"article","title":"Opening a publication","role":"article","type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication"},"https://readium.org/webpub-manifest/":{"type":"link","url":"https:\/\/readium.org\/webpub-manifest\/","titleInlineContent":[{"text":"Readium Web Publication Manifest","type":"text"}],"identifier":"https:\/\/readium.org\/webpub-manifest\/","title":"Readium Web Publication Manifest"},"Readium%20LCP.md":{"url":"Readium%20LCP.md","identifier":"Readium%20LCP.md","title":"ReadiumLCP downloads and decrypts LCP-protected publications","type":"link","titleInlineContent":[{"code":