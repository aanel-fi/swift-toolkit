text":"user and stop there. The message to the user must be clear about the status"},{"type":"text","text":" "},{"type":"text","text":"of the license: don’t display “expired” if the status is “revoked”. The"},{"type":"text","text":" "},{"type":"text","text":"date and time corresponding to the new status should be displayed (e.g."},{"type":"text","text":" "},{"type":"text","text":"“The license expired on 01 January 2018”)."}]},{"type":"paragraph","inlineContent":[{"text":"If the license has been revoked, the user message should display the number","type":"text"},{"text":" ","type":"text"},{"text":"of devices which registered to the server. This count can be calculated","type":"text"},{"text":" ","type":"text"},{"text":"from the number of “register” events in the status document. If no event is","type":"text"},{"text":" ","type":"text"},{"text":"logged in the status document, no such message should appear (certainly not","type":"text"},{"text":" ","type":"text"},{"text":"“The license was registered by 0 devices”).","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/readiumlcp\/statuserror"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Readium/documentation/ReadiumLCP/StatusError/returned(_:)":{"url":"\/documentation\/readiumlcp\/statuserror\/returned(_:)","identifier":"doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError\/returned(_:)","role":"symbol","type":"topic","title":"StatusError.returned(_:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"returned","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Date","preciseIdentifier":"s:10Foundation4DateV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"text":"This license has been returned on the given date.","type":"text"}],"kind":"symbol"},"doc://Readium/documentation/ReadiumLCP/StatusError/revoked(_:devicesCount:)":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"This license was revoked on the given date, af