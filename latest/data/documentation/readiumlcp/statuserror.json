{"sections":[],"abstract":[{"type":"text","text":"Errors while checking the status of the License, using the Status Document."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/readiumlcp\/statuserror"]}],"kind":"symbol","topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError\/cancelled(_:)","doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError\/expired(start:end:)","doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError\/returned(_:)","doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError\/revoked(_:devicesCount:)"],"anchor":"Enumeration-Cases","generated":true},{"title":"Default Implementations","identifiers":["doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError\/Error-Implementations"],"anchor":"Default-Implementations","generated":true}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/Readium\/s5ErrorP","doc:\/\/Readium\/s8SendableP"],"type":"conformsTo"}],"metadata":{"symbolKind":"enum","externalID":"s:10ReadiumLCP11StatusErrorO","navigatorTitle":[{"text":"StatusError","kind":"identifier"}],"modules":[{"name":"ReadiumLCP"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StatusError","kind":"identifier"}],"title":"StatusError","roleHeading":"Enumeration"},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError"},"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/ReadiumLCP"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StatusError","kind":"identifier"}],"platforms":["iOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"inlineContent":[{"text":"For the case (revoked, returned, cancelled, expired), app should notify the","type":"text"},{"text":" ","type":"text"},{"text":"user and stop there. The message to the user must be clear about the status","type":"text"},{"text":" ","type":"text"},{"text":"of the license: don’t display “expired” if the status is “revoked”. The","type":"text"},{"text":" ","type":"text"},{"text":"date and time corresponding to the new status should be displayed (e.g.","type":"text"},{"text":" ","type":"text"},{"text":"“The license expired on 01 January 2018”).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the license has been revoked, the user message should display the number","type":"text"},{"text":" ","type":"text"},{"text":"of devices which registered to the server. This count can be calculated","type":"text"},{"text":" ","type":"text"},{"text":"from the number of “register” events in the status document. If no event is","type":"text"},{"text":" ","type":"text"},{"text":"logged in the status document, no such message should appear (certainly not","type":"text"},{"text":" ","type":"text"},{"text":"“The license was registered by 0 devices”).","type":"text"}],"type":"paragraph"}]}],"references":{"doc://Readium/documentation/ReadiumLCP/StatusError/Error-Implementations":{"kind":"article","title":"Error Implementations","role":"collectionGroup","identifier":"doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError\/Error-Implementations","abstract":[],"url":"\/documentation\/readiumlcp\/statuserror\/error-implementations","type":"topic"},"doc://Readium/documentation/ReadiumLCP/StatusError/returned(_:)":{"type":"topic","url":"\/documentation\/readiumlcp\/statuserror\/returned(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"returned"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DateV","text":"Date"},{"kind":"text","text":")"}],"abstract":[{"text":"This license has been returned on the given date.