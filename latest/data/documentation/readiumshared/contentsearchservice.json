{"abstract":[{"type":"text","text":"Implementation of "},{"type":"codeVoice","code":"SearchService"},{"type":"text","text":" using the Content API ("},{"type":"codeVoice","code":"ContentService"},{"type":"text","text":")."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContentSearchService"}],"platforms":["iOS"]}]},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It supports cross-element matching within the same resource via a"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"sliding window"}],"type":"emphasis"},{"type":"text","text":" over the resource’s concatenated element texts. The window"},{"type":"text","text":" "},{"type":"text","text":"maintains a "},{"inlineContent":[{"type":"text","text":"danger zone"}],"type":"emphasis"},{"type":"text","text":" (last "},{"inlineContent":[{"type":"text","text":"T"}],"type":"emphasis"},{"type":"text","text":" characters) where matches are deferred"},{"type":"text","text":" "},{"type":"text","text":"to the next iteration, enabling queries that span element boundaries (e.g.,"},{"type":"text","text":" "},{"code":"<p>The quick<\/p><p>brown fox.<\/p>","type":"codeVoice"},{"type":"text","text":" matches “quick brown”)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cross-resource matching is intentionally not supported (the window is"},{"type":"text","text":" "},{"type":"text","text":"flushed at every resource boundary)."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Regex limitation:","type":"text"}]},{"type":"text","text":" for variable-length or greedy patterns the danger-zone"},{"type":"text","text":" "},{"type":"text","text":"heuristic (last 256 chars) is an approximation. A greedy pattern that starts"},{"type":"text","text":" "},{"type":"text","text":"before the danger zone but could extend further into the next element may be"},{"type":"text","text":" "},{"type":"text","text":"emitted prematurely, with a shorter-than-optimal match. Plain-text queries"},{"type":"text","text":" "},{"type":"text","text":"are not affected by this limitation."}]},{"type":"paragraph","inlineContent":[{"text":"This service requires the publication to have a configured ","type":"text"},{"code":"ContentService","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/Closeable","doc:\/\/Readium\/documentation\/ReadiumShared\/Loggable","doc:\/\/Readium\/documentation\/ReadiumShared\/PublicationService","doc:\/\/Readium\/documentation\/ReadiumShared\/SearchService"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/readiumshared\/contentsearchservice"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"generated":true,"identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/ContentSearchService\/init(publication:language:snippetLength:searchAlgorithm:)"],"title":"Initializers","anchor":"Initializers"},{"generated":true,"identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/ContentSearchService\/options"],"title":"Instance Properties","anchor":"Instance-Properties"},{"generated":true,"identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/ContentSearchService\/search(query:options:)"],"title":"Instance Methods","anchor":"Instance-Methods"},{"generated":true,"identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/ContentSearchService\/makeFactory(snippetLength:searchAlgorithm:)"],"title":"Type Methods","anchor":"Type-Methods"},{"generated":true,"identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/ContentSearchService\/Closeable-Implementations","