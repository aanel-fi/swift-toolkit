{"abstract":[{"type":"text","text":"This construct enables a serializable representation of a DOM Range."}],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/ReadiumShared"]]},"topicSections":[{"anchor":"Structures","generated":true,"identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/DOMRange\/Point"],"title":"Structures"},{"anchor":"Initializers","generated":true,"identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/DOMRange\/init(json:warnings:)","doc:\/\/Readium\/documentation\/ReadiumShared\/DOMRange\/init(start:end:)"],"title":"Initializers"},{"anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/DOMRange\/jsonObject"],"title":"Instance Properties"},{"anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/DOMRange\/Equatable-Implementations","doc:\/\/Readium\/documentation\/ReadiumShared\/DOMRange\/JSONObjectEncodable-Implementations","doc:\/\/Readium\/documentation\/ReadiumShared\/DOMRange\/JSONValueDecodable-Implementations","doc:\/\/Readium\/documentation\/ReadiumShared\/DOMRange\/JSONValueEncodable-Implementations"],"title":"Default Implementations"}],"relationshipsSections":[{"identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/JSONObjectEncodable","doc:\/\/Readium\/documentation\/ReadiumShared\/JSONValueDecodable","doc:\/\/Readium\/documentation\/ReadiumShared\/JSONValueEncodable","doc:\/\/Readium\/SQ","doc:\/\/Readium\/SH"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/readiumshared\/domrange"]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DOMRange","kind":"identifier"}],"navigatorTitle":[{"text":"DOMRange","kind":"identifier"}],"symbolKind":"struct","externalID":"s:13ReadiumShared8DOMRangeV","role":"symbol","modules":[{"name":"ReadiumShared"}],"roleHeading":"Structure","title":"DOMRange"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DOMRange","kind":"identifier"}],"platforms":["iOS"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"In a DOM Range object, the startContainer + startOffset tuple represents the ","type":"text"},{"type":"codeVoice","code":"start"},{"text":" boundary","type":"text"},{"text":" ","type":"text"},{"text":"point. Similarly, the the endContainer + endOffset tuple represents the ","type":"text"},{"type":"codeVoice","code":"end"},{"text":" boundary point.","type":"text"},{"text":" ","type":"text"},{"text":"In both cases, the start\/endContainer property is a pointer to either a DOM text node, or a DOM","type":"text"},{"text":" ","type":"text"},{"text":"element (this typically depends on the mechanism from which the DOM Range instance originates,","type":"text"},{"text":" ","type":"text"},{"text":"for example when obtaining the currently-selected document fragment using the ","type":"text"},{"type":"codeVoice","code":"window.selection"},{"text":" ","type":"text"},{"text":"API). In the case of a DOM text node, the start\/endOffset corresponds to a position within the","type":"text"},{"text":" ","type":"text"},{"text":"character data. In the case of a DOM element node, the start\/endOffset corresponds to a position","type":"text"},{"text":" ","type":"text"},{"text":"that designates a child text node.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that "},{"type":"codeVoice","code":"end"},{"type":"text","text":" field is optional. When only the start field is specified, the domRange object"},{"type":"text","text":" "},{"type":"text","text":"represents a “collapsed” range that has identical "},{"type":"codeVoice","code":"start"},{"type":"text","text":" and "},{"type":"codeVoice","code":"end"},{"type":"text","text":" boundary points."}]},{"type":"paragraph","inlineContent":[{"text":"https:\/\/github.com\/readium\/architecture\/blob\/master\/models\/locators\/extensions\/html.md#the-domrange-object","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/ReadiumShared\/DOMRange"},"references":{"doc://Readium/documentation/ReadiumShared/DOMRange/JSONValueDecodable-Implementations":{"abstract":[],"type":"topic","title":"JSONValueDecodable Implementations","role":"collectionGroup","kind":"article","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/DOMRange\/JSONValueDecodable-Implementations","url":"\/documentation\/readiumshared\/domrange\/jsonvaluedecodable-implementations"},"doc://Readium/documentation/ReadiumShared/DOMRange/JSONValueEncodable-Implementations":{"abstract":[],"type":"topic","title":"JSONValueEncodable Implementations","role":"collectionGroup","kind":"article","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/DOMRange\/JSONValueEncodable-Implementations","url":"\/documentation\/readiumshared\/domrange\/jsonvalueencodable-implementations"},"doc://Readium/documentation/ReadiumShared/DOMRange/init(json:warnings:)":{"kind":"symbol","abstract":[],"identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/DOMRange\/init(json:warnings:)","role":"symbol","url":"\/documentation\/readiumshared\/domrange\/init(json:warnings:)","title":"init(json:warnings:)","fragments":[{"text":"init","kind":"identifier"},{"text":"?<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"json","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13ReadiumShared8DOMRangeV4json8warningsACSgxSg_AA13WarningLogger_pSgtKcAA18JSONValueEncodableRzlufc1TL_xmfp","text":"T","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"tex