{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/ReadiumShared\/BufferingResource"},"topicSections":[{"identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/BufferingResource\/init(resource:bufferSize:)-48h5z","doc:\/\/Readium\/documentation\/ReadiumShared\/BufferingResource\/init(resource:bufferSize:)-54cd7"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/BufferingResource\/sourceURL"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/BufferingResource\/estimatedLength()","doc:\/\/Readium\/documentation\/ReadiumShared\/BufferingResource\/properties()","doc:\/\/Readium\/documentation\/ReadiumShared\/BufferingResource\/stream(range:consume:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"},{"identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/BufferingResource\/Actor-Implementations","doc:\/\/Readium\/documentation\/ReadiumShared\/BufferingResource\/Closeable-Implementations","doc:\/\/Readium\/documentation\/ReadiumShared\/BufferingResource\/Loggable-Implementations","doc:\/\/Readium\/documentation\/ReadiumShared\/BufferingResource\/Resource-Implementations","doc:\/\/Readium\/documentation\/ReadiumShared\/BufferingResource\/Streamable-Implementations"],"title":"Default Implementations","generated":true,"anchor":"Default-Implementations"}],"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/Closeable","doc:\/\/Readium\/documentation\/ReadiumShared\/Loggable","doc:\/\/Readium\/documentation\/ReadiumShared\/Resource","doc:\/\/Readium\/documentation\/ReadiumShared\/Streamable","doc:\/\/Readium\/s8SendableP","doc:\/\/Readium\/ScA"],"title":"Conforms To","kind":"relationships"}],"abstract":[{"type":"text","text":"Wraps an existing "},{"type":"codeVoice","code":"Resource"},{"type":"text","text":" and buffers its content."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"tokens":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"BufferingResource"}],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Expensive interaction with the underlying resource is minimized, since most"},{"type":"text","text":" "},{"type":"text","text":"(smaller) requests can be satisfied by accessing the buffer alone. The"},{"type":"text","text":" "},{"type":"text","text":"drawback is that some extra space is required to hold the buffer and that"},{"type":"text","text":" "},{"type":"text","text":"copying takes place when filling that buffer, but this is usually"},{"type":"text","text":" "},{"type":"text","text":"outweighed by the performance benefits."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that this implementation is pretty limited and the benefits are only"},{"type":"text","text":" "},{"type":"text","text":"apparent when reading forward and consecutively – e.g. when downloading the"},{"type":"text","text":" "},{"type":"text","text":"resource by chunks. The buffer is ignored when reading backward or far"},{"type":"text","text":" "},{"type":"text","text":"ahead."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/readiumshared\/bufferingresource"]}],"sections":[],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/ReadiumShared"]]},"metadata":{"externalID":"s:13ReadiumShared17BufferingResourceC","navigatorTitle":[{"text":"BufferingResource","kind":"identifier"}],"symbolKind":"class","modules":[{"name":"ReadiumShared"}],"role":"symbol","roleHeading":"Class","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"t