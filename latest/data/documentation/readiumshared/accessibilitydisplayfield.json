ition, it indicates the"},{"type":"text","text":" "},{"type":"text","text":"presence of videos and if closed captions, open captions, or transcripts"},{"type":"text","text":" "},{"type":"text","text":"for prerecorded audio are available."}],"identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide\/RichContent-swift.struct","kind":"symbol","type":"topic","title":"AccessibilityMetadataDisplayGuide.RichContent","url":"\/documentation\/readiumshared\/accessibilitymetadatadisplayguide\/richcontent-swift.struct"},"doc://Readium/documentation/ReadiumShared/AccessibilityMetadataDisplayGuide/Legal-swift.struct":{"title":"AccessibilityMetadataDisplayGuide.Legal","role":"symbol","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide\/Legal-swift.struct","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Legal"}],"url":"\/documentation\/readiumshared\/accessibilitymetadatadisplayguide\/legal-swift.struct","abstract":[{"text":"In some jurisdictions publishers may be able to claim an exemption from","type":"text"},{"text":" ","type":"text"},{"text":"the provision of accessible publications, including the provision of","type":"text"},{"text":" ","type":"text"},{"text":"accessibility metadata. This should always be subject to clarification","type":"text"},{"text":" ","type":"text"},{"text":"by legal counsel for each jurisdiction.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Legal"}]},"doc://Readium/documentation/ReadiumShared/AccessibilityMetadataDisplayGuide/AccessibilitySummary-swift.struct":{"url":"\/documentation\/readiumshared\/accessibilitymetadatadisplayguide\/accessibilitysummary-swift.struct","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide\/AccessibilitySummary-swift.struct","kind":"symbol","abstract":[{"text":"The accessibility summary was intended (in EPUB Accessibility 1.0) to","type":"text"},{"text":" ","type":"text"},{"text":"describe in human-readable prose the accessibility features present in","type":"text"},{"text":" ","type":"text"},{"text":"the publication as well as any shortcomings. Starting with EPUB","type":"text"},{"text":" ","type":"text"},{"text":"Accessibility version 1.1 the accessibility summary became a human-","type":"text"},{"text":" ","type":"text"},{"text":"readable summary of the accessibility that complements, but does not","type":"text"},{"text":" ","type":"text"},{"text":"duplicate, the other discoverability metadata.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AccessibilitySummary","kind":"identifier"}],"navigatorTitle":[{"text":"AccessibilitySummary","kind":"identifier"}],"title":"AccessibilityMetadataDisplayGuide.AccessibilitySummary"},"doc://Readium/documentation/ReadiumShared/AccessibilityDisplayField":{"abstract":[{"type":"text","text":"Represents a collection of related accessibility claims which should be"},{"type":"text","text":" "},{"type":"text","text":"displayed together in a section"}],"navigatorTitle":[{"kind":"identifier","text":"AccessibilityDisplayField"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AccessibilityDisplayField"}],"type":"topic","kind":"symbol","title":"AccessibilityDisplayField","role":"symbol","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityDisplayField","url":"\/documentation\/readiumshared\/accessibilitydisplayfield"},"doc://Readium/s12IdentifiableP":{"title":"Swift.Identifiable","type":"unresolvable","identifier":"doc:\/\/Readium\/s12IdentifiableP"}}}