{"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/ReadiumShared","doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide","doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide\/RichContent-swift.struct"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/readiumshared\/accessibilitymetadatadisplayguide\/richcontent-swift.struct\/shoulddisplay"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Instance Property","role":"symbol","modules":[{"name":"ReadiumShared"}],"externalID":"s:13ReadiumShared33AccessibilityMetadataDisplayGuideV11RichContentV06shouldE0Sbvp","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"shouldDisplay"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"title":"shouldDisplay","symbolKind":"property"},"abstract":[{"type":"text","text":"Indicates whether this display field should be rendered in the user"},{"type":"text","text":" "},{"type":"text","text":"interface, because it contains useful information."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"shouldDisplay"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}]},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"A field with "},{"type":"codeVoice","code":"shouldDisplay"},{"type":"text","text":" set to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" might have for only"},{"type":"text","text":" "},{"type":"text","text":"statement “No information is available”."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide\/RichContent-swift.struct\/shouldDisplay","interfaceLanguage":"swift"},"references":{"doc://Readium/documentation/ReadiumShared/AccessibilityMetadataDisplayGuide/RichContent-swift.struct":{"identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide\/RichContent-swift.struct","navigatorTitle":[{"text":"RichContent","kind":"identifier"}],"type":"topic","title":"AccessibilityMetadataDisplayGuide.RichContent","url":"\/documentation\/readiumshared\/accessibilitymetadatadisplayguide\/richcontent-swift.struct","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RichContent","kind":"identifier"}],"abstract":[{"type":"text","text":"Indicates the presence of math, chemical formulas, extended descriptions"},{"type":"text","text":" "},{"type":"text","text":"for information rich images, e.g., charts, diagrams, figures, graphs,"},{"type":"text","text":" "},{"type":"text","text":"and whether these are in an accessible format or available in an"},{"type":"text","text":" "},{"type":"text","text":"alternative form, e.g., whether math and chemical formulas are navigable"},{"type":"text","text":" "},{"type":"text","text":"with assistive technologies, or whether extended descriptions are"},{"type":"text","text":" "},{"type":"text","text":"available for information-rich images. In addition, it indicates the"},{"type":"text","text":" "},{"type":"text","text":"presence of videos and if closed captions, open captions, or transcripts"},{"type":"text","text":" "},{"type":"text","text":"for prerecorded audio are available."}]},"doc://Readium/documentation/ReadiumShared/AccessibilityMetadataDisplayGuide":{"abstract":[{"type":"text","text":"When presenting accessibility metadata provided by the publisher, it is"},{"type":"text","text":" "},{"type":"text","text":"sugge