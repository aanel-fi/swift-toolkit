ions are"},{"type":"text","text":" "},{"type":"text","text":"available for information-rich images. In addition, it indicates the"},{"type":"text","text":" "},{"type":"text","text":"presence of videos and if closed captions, open captions, or transcripts"},{"type":"text","text":" "},{"type":"text","text":"for prerecorded audio are available."}],"identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide\/RichContent-swift.struct","kind":"symbol","type":"topic","title":"AccessibilityMetadataDisplayGuide.RichContent","url":"\/documentation\/readiumshared\/accessibilitymetadatadisplayguide\/richcontent-swift.struct"},"doc://Readium/documentation/ReadiumShared/AccessibilityMetadataDisplayGuide/RichContent-swift.struct/shouldDisplay":{"url":"\/documentation\/readiumshared\/accessibilitymetadatadisplayguide\/richcontent-swift.struct\/shoulddisplay","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"shouldDisplay","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"title":"shouldDisplay","kind":"symbol","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide\/RichContent-swift.struct\/shouldDisplay","abstract":[{"type":"text","text":"Indicates whether this display field should be rendered in the user"},{"type":"text","text":" "},{"type":"text","text":"interface, because it contains useful information."}],"role":"symbol","type":"topic"},"doc://Readium/documentation/ReadiumShared":{"url":"\/documentation\/readiumshared","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared","abstract":[],"kind":"symbol","type":"topic","role":"collection","title":"ReadiumShared"}}}