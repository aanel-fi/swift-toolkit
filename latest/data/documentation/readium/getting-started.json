de":"Publication"},{"type":"text","text":". EPUB and PDF publications are supported."}],"title":"Searching a publication","type":"topic","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","kind":"article"},"https://opds.io":{"title":"OPDS catalog feeds","type":"link","titleInlineContent":[{"type":"text","text":"OPDS catalog feeds"}],"identifier":"https:\/\/opds.io","url":"https:\/\/opds.io"},"Readium%20LCP.md":{"type":"link","identifier":"Readium%20LCP.md","titleInlineContent":[{"code":"ReadiumLCP","type":"codeVoice"},{"type":"text","text":" downloads and decrypts LCP-protected publications"}],"url":"Readium%20LCP.md","title":"ReadiumLCP downloads and decrypts LCP-protected publications"},"doc://Readium/documentation/Readium/TTS":{"url":"\/documentation\/readium\/tts","identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","type":"topic","kind":"article","role":"article","abstract":[],"title":"Text-to-speech"},"doc://Readium/documentation/Readium/Open-Publication":{"url":"\/documentation\/readium\/open-publication","role":"article","abstract":[{"type":"text","text":"To open a publication with Readium, you need to instantiate a couple of components: an "},{"code":"AssetRetriever","type":"codeVoice"},{"type":"text","text":" and a "},{"code":"PublicationOpener","type":"codeVoice"},{"type":"text","text":"."}],"kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","title":"Opening a publication","type":"topic"},"https://readium.org/architecture/models/locators/":{"title":"Locator object","type":"link","titleInlineContent":[{"code":"Locator","type":"codeVoice"},{"text":" object","type":"text"}],"identifier":"https:\/\/readium.org\/architecture\/models\/locators\/","url":"https:\/\/readium.org\/architecture\/models\/locators\/"},"https://www.w3.org/TR/epub-a11y-11":{"type":"link","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","title":"EPUB Accessibility","url":"https:\/\/www.w3.org\/TR\/epub-a11y-11