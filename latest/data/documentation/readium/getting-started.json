{"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","interfaceLanguage":"swift"},"seeAlsoSections":[{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"generated":true}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"abstract":[{"type":"text","text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics."}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"content":[{"inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"text","text":"Readium offers only low-level tools. You are responsible for creating a user interface for reading and managing books, as well as a data layer to store the user’s publications. The Test App is an example of such integration."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"level":2,"text":"Design principles","type":"heading","anchor":"Design-principles"},{"inlineContent":[{"type":"text","text":"The toolkit has been designed following these core tenets:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Modular"}]},{"type":"text","text":": It is divided into separate modules that can be used independently."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Extensible"}]},{"type":"text","text":": Integrators should be able to support a custom DRM, publication format or inject their own stylesheets without modifying the toolkit itself."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Opiniated"}]},{"type":"text","text":": We adhere to open standards but sometimes interpret them for practicality."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Packages","type":"heading","anchor":"Packages"},{"level":3,"text":"Main packages","type":"heading","anchor":"Main-packages"},{"items":[{"content":[{"inlineContent":[{"code":"ReadiumShared","type":"codeVoice"},{"text":" contains shared ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" models and utilities.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ReadiumStreamer","type":"codeVoice"},{"text":" parses publication files (e.g. an EPUB) into a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" object.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"Navigator\/Navigator.md","isActive":true},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"level":3,"text":"Specialized packages","type":"heading","anchor":"Specialized-packages"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ReadiumOPDS"},{"type":"text","text":" parses "},{"isActive":true,"type":"reference","identifier":"https:\/\/opds.io"},{"type":"text","text":" (both OPDS 1 and 2)."}]}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"Readium%20LCP.md","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Overview of the shared models (`ReadiumShared`)","type":"heading","anchor":"Overview-of-the-shared-models-ReadiumShared"},{"inlineContent":[{"type":"text","text":"The Readium toolkit provides models used as exchange types between packages."}],"type":"paragraph"},{"level":3,"text":"Publication models","type":"heading","anchor":"Publication-models"},{"level":4,"text":"Publication","type":"heading","anchor":"Publication"},{"inlineContent":[{"type":"codeVoice","code":"Publication"},{"type":"text","text":" and its sub-components represent a single publication – ebook, audiobook or comic. It is loosely based on the "},{"type":"reference","identifier":"https:\/\/readium.org\/webpub-manifest\/","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" instance:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"holds the metadata of a publication, such as its author or table of contents,","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"allows to read the contents of a publication, e.g. XHTML or audio resources,","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"provides additional services, for example content extraction or text search."}]}]}],"type":"unorderedList"},{"level":4,"text":"Link","type":"heading","anchor":"Link"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object","type":"reference","isActive":true},{"text":" holds a pointer (URL) to a resource or service along with additional metadata, such as its media type or title.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" contains several ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":" collections, for example:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"readingOrder"},{"text":" lists the publication resources arranged in the order they should be read.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"resources"},{"type":"text","text":" contains secondary resources necessary for rendering the "},{"type":"codeVoice","code":"readingOrder"},{"type":"text","text":", such as an image or a font file."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"tableOfContents"},{"type":"text","text":" represents the table of contents as a tree of "},{"type":"codeVoice","code":"Link"},{"type":"text","text":" objects."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"links"},{"type":"text","text":" exposes additional resources, such as a canonical link to the manifest or a search web service."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":4,"text":"Locator","type":"heading","anchor":"Locator"},{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"https:\/\/readium.org\/architecture\/models\/locators\/"},{"type":"text","text":" represents a precise location in a publication resource in a format that can be stored and shared across reading systems. It is more accurate than a "},{"type":"codeVoice","code":"Link"},{"type":"text","text":" and contains additional information about the location, e.g. progression percentage, position or textual context."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"code":"Locator","type":"codeVoice"},{"text":" objects are used for various features, including:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"reporting the current progression in the publication","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"saving bookmarks, highlights and annotations"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"navigating search results"}]}]}]},{"type":"heading","anchor":"Data-models","level":3,"text":"Data models"},{"type":"heading","anchor":"Asset","level":4,"text":"Asset"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"code":"Asset","type":"codeVoice"},{"text":" represents a single file or package and provides access to its content. There are two types of ","type":"text"},{"code":"Asset","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"ContainerAsset","type":"codeVoice"},{"text":" for packages which contains several resources, such as a ZIP archive.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ResourceAsset"},{"text":" for accessing a single resource, such as a JSON or PDF file.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"code":"Asset","type":"codeVoice"},{"type":"text","text":" instances are obtained through an "},{"code":"AssetRetriever","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"You can use the ","type":"text"},{"code":"asset.format","type":"codeVoice"},{"text":" to identify the media type and capabilities of the asset.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["if asset.format.conformsTo(.lcp) {","    \/\/ The asset is protected with LCP.","}","if asset.format.conformsTo(.epub) {","    \/\/ The asset represents an EPUB publication.","}"]},{"type":"heading","anchor":"Resource","level":4,"text":"Resource"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Resource"},{"type":"text","text":" provides read access to a single resource, such as a file or an entry in an archive."}]},{"type":"paragraph","inlineContent":[{"code":"Resource","type":"codeVoice"},{"type":"text","text":" instances are usually created by a "},{"code":"ResourceFactory","type":"codeVoice"},{"type":"text","text":". The toolkit ships with various implementations supporting different data access protocols such as local files or HTTP."}]},{"type":"heading","anchor":"Container","level":4,"text":"Container"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"Container","type":"codeVoice"},{"text":" provides read access to a collection of resources. ","type":"text"},{"code":"Container","type":"codeVoice"},{"text":" instances representing an archive are usually created by an ","type":"text"},{"code":"ArchiveOpener","type":"codeVoice"},{"text":". The toolkit ships with a ","type":"text"},{"code":"ZIPArchiveOpener","type":"codeVoice"},{"text":" supporting both local and remote (HTTP) ZIP files.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"Publication","type":"codeVoice"},{"type":"text","text":" objects internally use a "},{"code":"Container","type":"codeVoice"},{"type":"text","text":" to expose its content."}]},{"type":"heading","anchor":"Opening-a-publication-ReadiumStreamer","level":2,"text":"Opening a publication (`ReadiumStreamer`)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To retrieve a "},{"code":"Publication","type":"codeVoice"},{"type":"text","text":" object from a publication file like an EPUB or audiobook, you can use an "},{"code":"AssetRetriever","type":"codeVoice"},{"type":"text","text":" and "},{"code":"PublicationOpener","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Instantiate the required components.","let httpClient = DefaultHTTPClient()","let assetRetriever = AssetRetriever(","    httpClient: httpClient",")","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever,","        pdfFactory: DefaultPDFDocumentFactory()","    )",")","","let url: URL = URL(...)","","\/\/ Retrieve an `Asset` to access the file content.","switch await assetRetriever.retrieve(url: url.anyURL.absoluteURL!) {","case .success(let asset):","    \/\/ Open a `Publication` from the `Asset`.","    switch await publicationOpener.open(asset: asset, allowUserInteraction: true, sender: view) {","    case .success(let publication):","        print(\"Opened \\(publication.metadata.title)\")","","    case .failure(let error):","        \/\/ Failed to access or parse the publication","    }","","case .failure(let error):","    \/\/ Failed to retrieve the asset","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"allowUserInteraction"},{"text":" parameter is useful when supporting a DRM like Readium LCP. It indicates if the toolkit can prompt the user for credentials when the publication is protected.","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"Open%20Publication.md","type":"reference"},{"text":".","type":"text"}]},{"type":"heading","level":2,"text":"Accessing the metadata of a publication","anchor":"Accessing-the-metadata-of-a-publication"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After opening a publication, you may want to read its metadata to insert a new entity into your bookshelf database, for instance. The "},{"code":"publication.metadata","type":"codeVoice"},{"type":"text","text":" object contains everything you need, including "},{"code":"title","type":"codeVoice"},{"type":"text","text":", "},{"code":"authors","type":"codeVoice"},{"type":"text","text":" and the "},{"code":"published","type":"codeVoice"},{"type":"text","text":" date."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can retrieve the publication cover using "},{"code":"await publication.cover()","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Rendering the publication on the screen (`ReadiumNavigator`)","anchor":"Rendering-the-publication-on-the-screen-ReadiumNavigator"},{"type":"paragraph","inlineContent":[{"text":"You can use a Readium navigator to present the 