{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"content":[{"inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"text":"Readium offers only low-level tools. You are responsible for creating a user interface for reading and managing books, as well as a data layer to store the user’s publications. The Test App is an example of such integration.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"level":2,"anchor":"Design-principles","type":"heading","text":"Design principles"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The toolkit has been designed following these core tenets:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Modular"}],"type":"strong"},{"type":"text","text":": It is divided into separate modules that can be used independently."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Extensible","type":"text"}]},{"type":"text","text":": Integrators should be able to support a custom DRM, publication format or inject their own stylesheets without modifying the toolkit itself."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Opiniated"}]},{"text":": We adhere to open standards but sometimes interpret them for practicality.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Packages","type":"heading","text":"Packages"},{"level":3,"anchor":"Main-packages","type":"heading","text":"Main packages"},{"items":[{"content":[{"inlineContent":[{"code":"ReadiumShared","type":"codeVoice"},{"text":" contains shared ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" models and utilities.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ReadiumStreamer"},{"text":" parses publication files (e.g. an EPUB) into a ","type":"text"},{"type":"codeVoice","code":"Publication"},{"text":" object.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"Navigator\/Navigator.md","type":"reference","isActive":true},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"level":3,"anchor":"Specialized-packages","type":"heading","text":"Specialized packages"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"ReadiumOPDS","type":"codeVoice"},{"text":" parses ","type":"text"},{"identifier":"https:\/\/opds.io","isActive":true,"type":"reference"},{"text":" (both OPDS 1 and 2).","type":"text"}]}]},{"content":[{"inlineContent":[{"identifier":"Readium%20LCP.md","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"anchor":"Overview-of-the-shared-models-ReadiumShared","type":"heading","text":"Overview of the shared models (`ReadiumShared`)"},{"type":"paragraph","inlineContent":[{"text":"The Readium toolkit provides models used as exchange types between packages.","type":"text"}]},{"level":3,"anchor":"Publication-models","type":"heading","text":"Publication models"},{"level":4,"anchor":"Publication","type":"heading","text":"Publication"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Publication"},{"type":"text","text":" and its sub-components represent a single publication – ebook, audiobook or comic. It is loosely based on the "},{"identifier":"https:\/\/readium.org\/webpub-manifest\/","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" instance:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"holds the metadata of a publication, such as its author or table of contents,","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"allows to read the contents of a publication, e.g. XHTML or audio resources,","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"provides additional services, for example content extraction or text search."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":4,"anchor":"Link","type":"heading","text":"Link"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object","isActive":true,"type":"reference"},{"type":"text","text":" holds a pointer (URL) to a resource or service along with additional metadata, such as its media type or title."}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"Publication"},{"text":" contains several ","type":"text"},{"type":"codeVoice","code":"Link"},{"text":" collections, for example:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"readingOrder"},{"text":" lists the publication resources arranged in the order they should be read.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"resources","type":"codeVoice"},{"text":" contains secondary resources necessary for rendering the ","type":"text"},{"code":"readingOrder","type":"codeVoice"},{"text":", such as an image or a font file.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"tableOfContents","type":"codeVoice"},{"text":" represents the table of contents as a tree of ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":" objects.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"links","type":"codeVoice"},{"type":"text","text":" exposes additional resources, such as a canonical link to the manifest or a search web service."}]}]}],"type":"unorderedList"},{"level":4,"anchor":"Locator","type":"heading","text":"Locator"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"https:\/\/readium.org\/architecture\/models\/locators\/","type":"reference","isActive":true},{"text":" represents a precise location in a publication resource in a format that can be stored and shared across reading systems. It is more accurate than a ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":" and contains additional information about the location, e.g. progression percentage, position or textual context.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"Locator","type":"codeVoice"},{"type":"text","text":" objects are used for various features, including:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"reporting the current progression in the publication"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"saving bookmarks, highlights and annotations"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"navigating search results"}]}]}],"type":"unorderedList"},{"level":3,"anchor":"Data-models","type":"heading","text":"Data models"},{"level":4,"anchor":"Asset","type":"heading","text":"Asset"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"code":"Asset","type":"codeVoice"},{"type":"text","text":" represents a single file or package and provides access to its content. There are two types of "},{"code":"Asset","type":"codeVoice"},{"type":"text","text":":"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ContainerAsset"},{"type":"text","text":" for packages which contains several resources, such as a ZIP archive."}]}]},{"content":[{"inlineContent":[{"code":"ResourceAsset","type":"codeVoice"},{"type":"text","text":" for accessing a single resource, such as a JSON or PDF file."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Asset"},{"type":"text","text":" instances are obtained through an "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use the "},{"type":"codeVoice","code":"asset.format"},{"type":"text","text":" to identify the media type and capabilities of the asset."}]},{"code":["if asset.format.conformsTo(.lcp) {","    \/\/ The asset is protected with LCP.","}","if asset.format.conformsTo(.epub) {","    \/\/ The asset represents an EPUB publication.","}"],"syntax":"swift","type":"codeListing"},{"level":4,"anchor":"Resource","type":"heading","text":"Resource"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Resource"},{"type":"text","text":" provides read access to a single resource, such as a file or an entry in an archive."}]},{"type":"paragraph","inlineContent":[{"code":"Resource","type":"codeVoice"},{"type":"text","text":" instances are usually created by a "},{"code":"ResourceFactory","type":"codeVoice"},{"type":"text","text":". The toolkit ships with various implementations supporting different data access protocols such as local files or HTTP."}]},{"level":4,"anchor":"Container","type":"heading","text":"Container"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"Container","type":"codeVoice"},{"text":" provides read access to a collection of resources. ","type":"text"},{"code":"Container","type":"codeVoice"},{"text":" instances representing an archive are usually created by an ","type":"text"},{"code":"ArchiveOpener","type":"codeVoice"},{"text":". The toolkit ships with a ","type":"text"},{"code":"ZIPArchiveOpener","type":"codeVoice"},{"text":" supporting both local and remote (HTTP) ZIP files.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"Publication","type":"codeVoice"},{"text":" objects internally use a ","type":"text"},{"code":"Container","type":"codeVoice"},{"text":" to expose its content.","type":"text"}]},{"level":2,"anchor":"Opening-a-publication-ReadiumStreamer","type":"heading","text":"Opening a publication (`ReadiumStreamer`)"},{"type":"paragraph","inlineContent":[{"text":"To retrieve a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" object from a publication file like an EPUB or audiobook, you can use an ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["\/\/ Instantiate the required components.","let httpClient = DefaultHTTPClient()","let assetRetriever = AssetRetriever(","    httpClient: httpClient",")","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever,","        pdfFactory: DefaultPDFDocumentFactory()","    )",")","","let url: URL = URL(...)","","\/\/ Retrieve an `Asset` to access the file content.","switch await assetRetriever.retrieve(url: url.anyURL.absoluteURL!) {","case .success(let asset):","    \/\/ Open a `Publication` from the `Asset`.","    switch await publicationOpener.open(asset: asset, allowUserInteraction: true, sender: view) {","    case .success(let publication):","        print(\"Opened \\(publication.metadata.title)\")","","    case .failure(let error):","        \/\/ Failed to access or parse the publication","    }","","case .failure(let error):","    \/\/ Failed to retrieve the asset","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"allowUserInteraction"},{"text":" parameter is useful when supporting a DRM like Readium LCP. It indicates if the toolkit can prompt the user for credentials when the publication is protected.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"Open%20Publication.md","type":"reference","isActive":true},{"text":".","type":"text"}]},{"level":2,"anchor":"Accessing-the-metadata-of-a-publication","type":"heading","text":"Accessing the metadata of a publication"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After opening a publication, you may want to read its metadata to insert a new entity into your bookshelf database, for instance. The "},{"type":"codeVoice","code":"publication.metadata"},{"type":"text","text":" object contains everything you need, including "},{"type":"codeVoice","code":"title"},{"type":"text","text":", "},{"type":"codeVoice","code":"authors"},{"type":"text","text":" and the "},{"type":"codeVoice","code":"published"},{"type":"text","text":" date."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can retrieve the publication cover using "},{"type":"codeVoice","code":"await publication.cover()"},{"type":"text","text":"."}]},{"level":2,"anchor":"Rendering-the-publication-on-the-screen-ReadiumNavigator","type":"heading","text":"Rendering the publication on the screen (`ReadiumNavigator`)"},{"type":"paragraph","inlineContent":[{"text":"You can use a Readium navigator to present the publication to the user. The ","type":"text"},{"type":"codeVoice","code":"Navigator"},{"text":" renders resources on the screen and offers APIs and user interactions for navigating the contents.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Please refer to the ","type":"text"},{"identifier":"Navigator\/Navigator.md","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"Navigator guide"}],"type":"reference","overridingTitle":"Navigator guide"},{"text":" for more information.","type":"text"}]}]}],"sections":[],"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","interfaceLanguage":"swift"},"metadata":{"role":"article","title":"Getting started","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"seeAlsoSections":[{"generated":true,"anchor":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"title":"Guides"}],"abstract":[{"text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics.","type":"text"}],"kind":"article","references":{"doc://Readium/documentation/Readium/NavigatorOverview":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","kind":"article","abstract":[{"text":"Learn about the architecture, configuration, and usage of the Readium Navigator.","type":"text"}],"title":"Navigator Overview","type":"topic","url":"\/documentation\/readium\/navigatoroverview","role":"article"},"doc://Readium/documentation/Readium":{"type":"topic","kind":"article","abstract":[{"text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin.","type":"text"}],"title":"Readium","role":"collection","url":"\/documentation\/readium","identifier":"doc:\/\/Readium\/documentation\/Readium"},"Navigator/Navigator.md":{"identifier":"Navigator\/Navigator.md","titleInlineContent":[{"type":"codeVoice","code":"ReadiumNavigator"},{"type":"text","text":" renders the content of a publication"}],"title":"ReadiumNavigator renders the content of a publication","url":"Navigator\/Navigator.md","type":"link"},"https://opds.io":{"identifier":"https:\/\/opds.io","titleInlineContent":[{"type":"text","text":"OPDS catalog feeds"}],"title":"OPDS catalog feeds","url":"https:\/\/opds.io","type":"link"},"https://www.edrlab.org/readium-lcp/":{"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","titleInlineContent":[{"type":"text","text":"Readium LCP"}],"title":"Readium LCP","url":"https:\/\/www.edrlab.org\/readium-lcp\/","type":"link"},"https://readium.org/webpub-manifest/#24-the-link-object":{"identifier":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object","titleInlineContent":[{"type":"codeVoice","code":"Link"},{"type":"text","text":" object"}],"title":"Link object","url":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object","type":"link"},"https://readium.org/architecture/models/locators/":{"identifier":"https:\/\/readium.org\/architecture\/models\/locators\/","titleInlineContent":[{"type":"codeVoice","code":"Locator"},{"type":"text","text":" object"}],"title":"Locator object","url":"https:\/\/readium.org\/architecture\/models\/locators\/","type":"link"},"doc://Readium/documentation/Readium/Content":{"kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Content","url":"\/documentation\/readium\/content","type":"topic","role":"article","abstract":[],"title":"Extracting the content of a publication"},"Readium%20LCP.md":{"identifier":"Readium%20LCP.md","titleInlineContent":[{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" downloads and decrypts LCP-protected publications"}],"title":"ReadiumLCP downloads and decrypts LCP-protected publications","url":"Readium%20LCP.md","type":"link"},"doc://Readium/documentation/Readium/Search":{"abstract":[{"type":"text","text":"The Search API lets you look for a textual query in the content of a "},{"code":"Publication","type":"codeVoice"},{"type":"text","text":". EPUB and PDF publications are supported."}],"type":"topic","title":"Searching a publication","kind":"article","url":"\/documentation\/readium\/search","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","role":"article"},"Open%20Publication.md":{"identifier":"Open%20Publication.md","titleInlineContent":[{"type":"text","text":"See the dedicated user guide for more information"}],"title":"See the dedicated user guide for more information","url":"Open%20Publication.md","type":"link"},"doc://Readium/documentation/Readium/Open-Publication":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","kind":"article","title":"Opening a publication","type":"topic","abstract":[{"type":"text","text":"To open a publication with Readium, you need to instantiate a couple of components: an "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":"."}],"url":"\/documentation\/readium\/open-publication","role":"article"},"doc://Readium/documentation/Readium/Migration-Guide":{"type":"topic","title":"Migration Guide","abstract":[{"text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file.","type":"text"}],"identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","kind":"article","role":"article","url":"\/documentation\/readium\/migration-guide"},"doc://Readium/documentation/Readium/TTS":{"type":"topic","title":"Text-to-speech","abstract":[],"identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","kind":"article","role":"article","url":"\/documentation\/readium\/tts"},"doc://Readium/documentation/Readium/Readium-LCP":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","title":"Supporting Readium LCP","kind":"article","role":"article","type":"topic","abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"type":"reference","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","isActive":true},{"type":"text","text":" DRM."}],"url":"\/documentation\/readium\/readium-lcp"},"https://www.w3.org/TR/epub-a11y-11":{"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","titleInlineContent":[{"type":"text","text":"EPUB Accessibility"}],"title":"EPUB Accessibility","url":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"link"},"https://readium.org/webpub-manifest/":{"identifier":"https:\/\/readium.org\/webpub-manifest\/","titleInlineContent":[{"type":"text","text":"Readium Web Publication Manifest"}],"title":"Readium Web Publication Manifest","url":"https:\/\/readium.org\/webpub-manifest\/","type":"link"},"doc://Readium/documentation/Readium/Accessibility":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","url":"\/documentation\/readium\/accessibility","type":"topic","role":"article","abstract":[{"type":"text","text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the "},{"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"reference","isActive":true},{"type":"text","text":" specification."}],"title":"Accessibility","kind":"article"}}}