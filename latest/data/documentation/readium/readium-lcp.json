{"seeAlsoSections":[{"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility"],"generated":true,"title":"Guides","anchor":"Guides"}],"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"aside","name":"Note","content":[{"inlineContent":[{"text":"[!IMPORTANT]","type":"text"},{"text":" ","type":"text"},{"text":"To use LCP with the Readium toolkit, you must first obtain the ","type":"text"},{"code":"R2LCPClient","type":"codeVoice"},{"text":" private library by contacting ","type":"text"},{"identifier":"https:\/\/www.edrlab.org\/contact\/","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}],"style":"note"},{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"inlineContent":[{"text":"An LCP publication is protected with a ","type":"text"},{"inlineContent":[{"type":"text","text":"user passphrase"}],"type":"emphasis"},{"text":" and distributed using an LCP License Document (","type":"text"},{"code":".lcpl","type":"codeVoice"},{"text":") .","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The user flow typically goes as follows:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"The user imports a ","type":"text"},{"type":"codeVoice","code":".lcpl"},{"text":" file into your application.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The application uses the Readium toolkit to download the protected publication from the "},{"code":".lcpl","type":"codeVoice"},{"type":"text","text":" file to the user’s bookshelf. The downloaded file can be a "},{"code":".epub","type":"codeVoice"},{"type":"text","text":", "},{"code":".lcpdf","type":"codeVoice"},{"type":"text","text":" (PDF), or "},{"code":".lcpa","type":"codeVoice"},{"type":"text","text":" (audiobook) package."}]}]},{"content":[{"inlineContent":[{"text":"The user opens the protected publication from the bookshelf.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If the passphrase isn’t already recorded in the ","type":"text"},{"code":"ReadiumLCP","type":"codeVoice"},{"text":" internal database, the user will be asked to enter it to unlock the contents.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The publication is decrypted and rendered on the screen.","type":"text"}]}]}]},{"type":"heading","text":"Setup","anchor":"Setup","level":2},{"inlineContent":[{"type":"text","text":"To support LCP in your application, you require two components:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"ReadiumLCP"},{"text":" package from the toolkit provides APIs for downloading and decrypting protected publications. Import it as you would any other Readium package, such as ","type":"text"},{"type":"codeVoice","code":"R2Navigator"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The private ","type":"text"},{"code":"R2LCPClient","type":"codeVoice"},{"text":" library customized for your application ","type":"text"},{"identifier":"https:\/\/www.edrlab.org\/contact\/","isActive":true,"overridingTitle":"is available from EDRLab","overridingTitleInlineContent":[{"type":"text","text":"is available from EDRLab"}],"type":"reference"},{"text":". They will provide instructions for integrating the ","type":"text"},{"code":"R2LCPClient","type":"codeVoice"},{"text":" framework into your application.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"File formats","anchor":"File-formats","level":3},{"inlineContent":[{"type":"text","text":"Readium LCP specifies new file formats."}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Name","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"File extension"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Media type","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lcp\/latest.html#32-content-conformance","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"code":".lcpl","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"application\/vnd.readium.lcp.license.v1.0+json","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-pdf.html"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".lcpdf"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"application\/pdf+lcp"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-audiobooks.html","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".lcpa"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"application\/audiobook+lcp"}],"type":"paragraph"}]]]},{"type":"aside","content":[{"inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"text":"EPUB files protected by LCP are supported without a special file extension or media type because EPUB accommodates any DRM scheme in its specification.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To support these formats in your application, you need to "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/defining_file_and_data_types_for_your_app","isActive":true},{"type":"text","text":" as imported types."}]},{"type":"codeListing","code":["<dict>","    <key>UTImportedTypeDeclarations<\/key>","    <array>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpl<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.json<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP License Document<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpl<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/vnd.readium.lcp.license.v1.0+json<\/string>","            <\/dict>","        <\/dict>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpdf<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.archive<\/string>","                <string>public.zip-archive<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP for PDF package<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpdf<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/pdf+lcp<\/string>","            <\/dict>","        <\/dict>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpa<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.archive<\/string>","                <string>public.zip-archive<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP for Audiobooks package<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpa<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/audiobook+lcp<\/string>","            <\/dict>","        <\/dict>","    <\/array>","<\/dict>"],"syntax":"xml"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Next, declare the imported types as "},{"isActive":true,"type":"reference","identifier":"https:\/\/help.apple.com\/xcode\/mac\/current\/#\/devddd273fdd"},{"type":"text","text":" in the "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":" to have your application listed in the “Open with…” dialogs."}]},{"type":"codeListing","code":["<dict>","    <key>CFBundleDocumentTypes<\/key>","    <array>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP License Document<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpl<\/string>","            <\/array>","        <\/dict>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP for PDF package<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpdf<\/string>","            <\/array>","        <\/dict>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP for Audiobooks package<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpa<\/string>","            <\/array>","        <\/dict>","    <\/array>","<\/dict>"],"syntax":"xml"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"[!TIP]"},{"type":"text","text":" "},{"type":"text","text":"If EPUB is not included in your document types, now is a good time to add it."}],"type":"paragraph"}],"style":"note","name":"Note"},{"type":"heading","level":3,"anchor":"Allow-insecure-HTTP-requests","text":"Allow insecure HTTP requests"},{"type":"paragraph","inlineContent":[{"text":"A file required by the LCP library needs to be downloaded from an insecure HTTP location. You must authorize this download by adding the following to your ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" file:","type":"text"}]},{"type":"codeListing","code":["<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSExceptionDomains<\/key>","    <dict>","        <key>crl.edrlab.telesec.de<\/key>","        <dict>","            <key>NSExceptionAllowsInsecureHTTPLoads<\/key>","            <true\/>","        <\/dict>","    <\/dict>","<\/dict>"],"syntax":"xml"},{"text":"Device name for LCP registration","type":"heading","level":3,"anchor":"Device-name-for-LCP-registration"},{"inlineContent":[{"type":"text","text":"When registering a license with an LSD server, Readium LCP identifies the device by name using "},{"type":"codeVoice","code":"UIDevice.current.name"},{"type":"text","text":". Since iOS 16, this returns a generic string such as “iPhone” instead of the user-assigned device name."}],"type":"paragraph"},{"inlineContent":[{"text":"To obtain the actual device name, add the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/bundleresources\/entitlements\/com_apple_developer_device-information_user-assigned-device-name"},{"text":" entitlement to your app’s ","type":"text"},{"code":".entitlements","type":"codeVoice"},{"text":" file. This entitlement requires approval from Apple.","type":"text"}],"type":"paragraph"},{"code":["<key>com.apple.developer.device-information.user-assigned-device-name<\/key>","<true\/>"],"type":"codeListing","syntax":"xml"},{"inlineContent":[{"text":"Alternatively, you can supply your own device name when initializing ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":" via the ","type":"text"},{"code":"deviceName","type":"codeVoice"},{"text":" parameter.","type":"text"}],"type":"paragraph"},{"text":"Initializing the `LCPService`","type":"heading","level":2,"anchor":"Initializing-the-LCPService"},{"inlineContent":[{"code":"ReadiumLCP","type":"codeVoice"},{"text":" offers an ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":" object that exposes its API. Since the ","type":"text"},{"code":"ReadiumLCP","type":"codeVoice"},{"text":" package is not linked with ","type":"text"},{"code":"R2LCPClient","type":"codeVoice"},{"text":", you need to create your own adapter when setting up the ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"LCPService"},{"text":" expects repositories to store the opened licenses and passphrases. ","type":"text"},{"type":"codeVoice","code":"ReadiumLCP"},{"text":" provides built-in Keychain-based implementations that store data securely in the iOS\/macOS Keychain. Unlike database-based storage, Keychain data persists across app reinstalls and can optionally be synchronized across the user’s devices via iCloud Keychain.","type":"text"}],"type":"paragraph"},{"code":["import R2LCPClient","import ReadiumLCP","","let httpClient = DefaultHTTPClient()","","let assetRetriever = AssetRetriever(","    httpClient: httpClient",")","","let lcpService = LCPService(","    client: LCPClientAdapter(),","    licenseRepository: LCPKeychainLicenseRepository(),","    passphraseRepository: LCPKeychainPassphraseRepository(),","    assetRetriever: assetRetriever,","    httpClient: httpClient",")","","\/\/\/ Facade to the private R2LCPClient.framework.","class LCPClientAdapter: ReadiumLCP.LCPClient {","    func createContext(jsonLicense: String, hashedPassphrase: LCPPassphraseHash, pemCrl: String) throws -> LCPClientContext {","        try R2LCPClient.createContext(jsonLicense: jsonLicense, hashedPassphrase: hashedPassphrase, pemCrl: pemCrl)","    }","","    func decrypt(data: Data, using context: LCPClientContext) -> Data? {","        R2LCPClient.decrypt(data: data, using: context as! DRMContext)","    }","","    func findOneValidPassphrase(jsonLicense: String, hashedPassphrases: [LCPPassphraseHash]) -> LCPPassphraseHash? {","        R2LCPClient.findOneValidPassphrase(jsonLicense: jsonLicense, hashedPassphrases: hashedPassphrases)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"To disable iCloud synchronization, pass ","type":"text"},{"code":"synchronizable: false","type":"codeVoice"},{"text":" when creating the repositories.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You may also implement your own persistence layer by conforming to ","type":"text"},{"code":"LCPLicenseRepository","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"LCPPassphraseRepository","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Acquiring a publication from a License Document (LCPL)","type":"heading","level":2,"anchor":"Acquiring-a-publication-from-a-License-Document-LCPL"},{"inlineContent":[{"type":"text","text":"Users need to import a License Document into your application to download the protected publication ("},{"type":"codeVoice","code":".epub"},{"type":"text","text":", "},{"type":"codeVoice","code":".lcpdf"},{"type":"text","text":", or "},{"type":"codeVoice","code":".lcpa"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":" offers an API to retrieve the full publication from an LCPL on the filesystem."}],"type":"paragraph"},{"code":["let result = await lcpService.acquirePublication(","    from: .file(lcplURL),","    onProgress: { progress in","        switch progress {","            case .indefinite:","                \/\/ Display an activity indicator.","            case .percent(let percent):","                \/\/ Display a progress bar with percent from 0 to 1.","        }","    }",")","","switch result {","case let .success(publication):","    \/\/ Import the `publication.localURL` file as any publication.","case let .failure(error):","    \/\/ Display the error message.","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"After the download is completed, import the "},{"type":"codeVoice","code":"publication.localURL"},{"type":"text","text":" file into the bookshelf like any other publication file."}],"type":"paragraph"},{"text":"Opening a publication protected with LCP","type":"heading","level":2,"anchor":"Opening-a-publication-protected-with-LCP"},{"text":"Initializing the `PublicationOpener`","type":"heading","level":3,"anchor":"Initializing-the-PublicationOpener"},{"inlineContent":[{"type":"text","text":"A publication protected with LCP can be opened using the "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":" component, just like a non-protected publication. However, you must provide a "},{"isActive":true,"type":"reference","identifier":"https:\/\/readium.org\/architecture\/proposals\/006-content-protection.html"},{"type":"text","text":" implementation when initializing the "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":" to enable LCP. Luckily, "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":" has you covered."}],"type":"paragraph"},{"code":["let httpClient = DefaultHTTPClient()","","let authentication = LCPDialogAuthentication()","","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: AssetRetriever(httpClient: httpClient),","        pdfFactory: DefaultPDFDocumentFactory()","    ),","    contentProtections: [","        lcpService.contentProtection(with: authentication)","    ]",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"An LCP package is secured with a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"user passphrase"}]},{"type":"text","text":" for decrypting the content. The "},{"type":"codeVoice","code":"LCPAuthenticating"},{"type":"text","text":" protocol used by "},{"type":"codeVoice","code":"LCPService.contentProtection(with:)"},{"type":"text","text":" provides the passphrase when needed. You can use the default UIKit "},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"type":"text","text":" which displays a pop-up to enter the passphrase, or implement your own method for passphrase retrieval. If your application is built using SwiftUI, "},{"type":"reference","identifier":"#using-the-swiftui-lcp-authentication-dialog","isActive":true}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"text":"The user will be prompted once per passphrase since ","type":"text"},{"code":"ReadiumLCP","type":"codeVoice"},{"text":" stores known passphrases on the device.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"text":"Opening the publication","type":"heading","level":3,"anchor":"Opening-the-publication"},{"inlineContent":[{"text":"You are now ready to open the publication file with your ","type":"text"},{"type":"codeVoice","code":"PublicationOpener"},{"text":" instance.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Retrieve an `Asset` to access the file content.","let url = FileURL(path: \"\/path\/to\/lcp-protected-book.epub\", isDirectory: false)","let asset = try await assetRetriever.retrieve(url: url).get()"," ","\/\/ Open a `Publication` from the `Asset`.","let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    sender: hostViewController",")","","switch result {","case .success(let publication):","    \/\/ Import or present the publication.","case .failure(let error):","    \/\/ Present the error.","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"allowUserInteraction"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"sender"},{"text":" arguments are forwarded to the ","type":"text"},{"type":"codeVoice","code":"LCPAuthenticating"},{"text":" implementation when the passphrase is unknown. ","type":"text"},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"text":" shows a pop-up only if ","type":"text"},{"type":"codeVoice","code":"allowUserInteraction"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", using the ","type":"text"},{"type":"codeVoice","code":"sender"},{"text":" as the pop-up’s host ","type":"text"},{"type":"codeVoice","code":"UIViewController"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When importing the publication to the bookshelf, set ","type":"text"},{"type":"codeVoice","code":"allowUserInteraction"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" as you don’t need the passphrase for accessing the publication metadata and cover. If you intend to present the publication using a Navigator, set ","type":"text"},{"type":"codeVoice","code":"allowUserInteraction"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" as decryption will be required.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!TIP]"},{"type":"text","text":" "},{"type":"text","text":"To check if an asset is protected with LCP before opening it, you can use "},{"code":"asset.format.conformsTo(.lcp)","type":"codeVoice"},{"type":"text","text":"."}]}],"type":"aside"},{"text":"Using the opened `Publication`","type":"heading","level":3,"anchor":"Using-the-opened-Publication"},{"inlineContent":[{"type":"text","text":"After obtaining a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" instance, you can access the publication’s metadata to import it into the user’s bookshelf. The user passphrase is not needed for reading the metadata or cover."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"However, if you want to display the publication with a Navigator, verify it is not restricted. It could be restricted if the user passphrase is unknown or if the license is no longer valid (e.g., expired loan, revoked purchase, etc.)."}],"type":"paragraph"},{"code":["if publication.isRestricted {","    if let error = publication.protectionError as? LCPError {","        \/\/ The user is not allowed to open the publication. You should display the error.","    } else {","        \/\/ We don't have the user passphrase.","        \/\/ You may use `publication` to access its metadata, but not to render its content.","    }","} else {","    \/\/ The publication is not restricted, you may render it with a Navigator component.","}"],"type":"codeListing","syntax":"swift"},{"text":"Streaming an LCP protected package","type":"heading","level":2,"anchor":"Streaming-an-LCP-protected-package"},{"inlineContent":[{"type":"text","text":"If the server hosting the LCP protected package supports the "},{"isActive":true,"identifier":"https:\/\/httpwg.org\/specs\/rfc9110.html#HEAD","type":"reference"},{"type":"text","text":" and "},{"isActive":true,"identifier":"https:\/\/httpwg.org\/specs\/rfc7233.html","type":"reference"},{"type":"text","text":", it is possible to stream directly an LCP protected publication from a License Document ("},{"type":"codeVoice","code":".lcpl"},{"type":"text","text":") file, without downloading the whole publication first."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Simply open the License Document directly using the "},{"code":"PublicationOpener","type":"codeVoice"},{"type":"text","text":". Make sure you provide an "},{"code":"HTTPClient","type":"codeVoice"},{"type":"text","text":" (or an "},{"code":"HTTPResourceFactory","type":"codeVoice"},{"type":"text","text":" for additional customization) to the "},{"code":"AssetRetriever","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["\/\/ Instantiate the required components.","let httpClient = DefaultHTTPClient()","let assetRetriever = AssetRetriever(httpClient: httpClient)","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever","    ),","    contentProtections: [","        lcpService.contentProtection(with: LCPDialogAuthentication()),","    ]",")","","\/\/ Retrieve an `Asset` to access the LCPL content.","let url = FileURL(path: \"\/path\/to\/license.lcpl\", isDirectory: false)","let asset = try await assetRetriever.retrieve(url: url).get()"," ","\/\/ Open a `Publication` from the LCPL `Asset`.","let publication = try await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    sender: hostViewController",").get()","    ","print(\"Opened \\(publication.metadata.title)\")"],"type":"codeListing","syntax":"swift"},{"text":"Obtaining information on an LCP license","type":"heading","level":2,"anchor":"Obtaining-information-on-an-LCP-license"},{"inlineContent":[{"text":"An LCP License Document contains metadata such as its expiration date, the remaining number of characters to copy and the user name. You can access this information using an ","type":"text"},{"code":"LCPLicense","type":"codeVoice"},{"text":" object.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use the ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":" to retrieve the ","type":"text"},{"code":"LCPLicense","type":"codeVoice"},{"text":" instance for a publication.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let result = await lcpService.retrieveLicense(","    from: asset,","    authentication: LCPDialogAuthentication(),","    allowUserInteraction: true,","    sender: hostViewController",")","","switch result {","case .success(let lcpLicense):","    if let user = lcpLicense.license.user.name {","        print(\"The publication was acquired by \\(user)\")","    }","    if let endDate = lcpLicense.license.rights.end {","        print(\"The loan expires on \\(endDate)\")","    }","    if let copyLeft = await lcpLicense.charactersToCopyLeft() {","        print(\"You can copy up to \\(copyLeft) characters remaining.\")","    }","case .failure(let error):","    \/\/ Display the error.","}"],"type":"codeListing"},{"inlineContent":[{"text":"If you have already opened a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":", you can directly obtain the ","type":"text"},{"code":"LCPLicense","type":"codeVoice"},{"text":" using ","type":"text"},{"code":"publication.lcpLicense","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Managing a loan","level":2,"type":"heading","anchor":"Managing-a-loan"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Readium LCP allows borrowing publications for a specific period. Use the "},{"type":"codeVoice","code":"LCPLicense"},{"type":"text","text":" object to manage a loan and retrieve its end date using "},{"type":"codeVoice","code":"lcpLicense.license.rights.end"},{"type":"text","text":"."}]},{"text":"Returning a loan","level":3,"type":"heading","anchor":"Returning-a-loan"},{"type":"paragraph","inlineContent":[{"text":"Some loans can be returned before the end date. You can confirm this by using ","type":"text"},{"code":"lcpLicense.canReturnPublication","type":"codeVoice"},{"text":". To return the publication, execute:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let result = await lcpLicense.returnPublication()","switch result {","case .success:","    \/\/ The publication was returned.","case .failure(let error):","    \/\/ Present the error.","}"]},{"text":"Renewing a loan","level":3,"type":"heading","anchor":"Renewing-a-loan"},{"type":"paragraph","inlineContent":[{"text":"The loan end date may also be extended. You can confirm this by using ","type":"text"},{"type":"codeVoice","code":"lcpLicense.canRenewLoan"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Readium LCP supports ","type":"text"},{"identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lsd\/latest#35-renewing-a-license","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Programmatic: You show your own user interface."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Interactive: You display a web view, and the Readium LSD server manages the renewal for you."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"You need to support both interactions by implementing the ","type":"text"},{"code":"LCPRenewDelegate","type":"codeVoice"},{"text":" protocol. A default implementation is available with ","type":"text"},{"code":"LCPDefaultRenewDelegate","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let result = await lcpLicense.renewLoan(","    with: LCPDefaultRenewDelegate(","        presentingViewController: hostViewController","    )",")","","switch result {","case .success:","    \/\/ The publication was renewed.","case let .failure(error):","    \/\/ Display the error.","}"]},{"text":"Handling `LCPError`","level":2,"type":"heading","anchor":"Handling-LCPError"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The APIs may fail with an "},{"type":"codeVoice","code":"LCPError"},{"type":"text","text":". These errors "},{"type":"strong","inlineContent":[{"type":"text","text":"must"}]},{"type":"text","text":" be displayed to the user with a suitable message."}]},{"type":"paragraph","inlineContent":[{"text":"For an example, ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/readium\/swift-toolkit\/blob\/3.0.0\/TestApp\/Sources\/App\/Readium.swift#L221"},{"text":".","type":"text"}]},{"text":"Using the SwiftUI LCP Authentication dialog","level":2,"type":"heading","anchor":"Using-the-SwiftUI-LCP-Authentication-dialog"},{"type":"paragraph","inlineContent":[{"text":"If your application is built using SwiftUI, you cannot use ","type":"text"},{"code":"LCPDialogAuthentication","type":"codeVoice"},{"text":" because it requires a UIKit view controller as its host. Instead, use an ","type":"text"},{"code":"LCPObservableAuthentication","type":"codeVoice"},{"text":" combined with our SwiftUI ","type":"text"},{"code":"LCPDialog","type":"codeVoice"},{"text":" presented as a sheet.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@main","struct MyApp: App {","    private let lcpService: LCPService","    private let publicationOpener: PublicationOpener","","    @StateObject private var lcpAuthentication: LCPObservableAuthentication","","    init() {","        \/\/ Create an `LCPObservableAuthentication` which will be used","        \/\/ to initialize the `LCPContentProtection`.","        \/\/","        \/\/ With SwiftUI, it must be stored in a `@StateObject` property","        \/\/ to observe the authentication requests.","        let lcpAuthentication = LCPObservableAuthentication()","        _lcpAuthentication = StateObject(wrappedValue: lcpAuthentication)","","        lcpService = LCPService(...)","","        publicationOpener = PublicationOpener(","            ...,","            contentProtections: [","                lcpService.contentProtection(with: lcpAuthentication)","            ]","        )","    }","","    var body: some Scene {","        WindowGroup {","            ContentView()","                \/\/ You can present an `LCPDialog` when the `LCPObservableAuthentication`","                \/\/ `request` property is updated.","                .sheet(item: $lcpAuthentication.request) {","                    LCPDialog(request: $0)","                }","            }","        }","    }","}"]}]}],"abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"type":"reference","isActive":true,"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/"},{"type":"text","text":" DRM."}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Article","role":"article","title":"Supporting Readium LCP"},"references":{"https://readium.org/lcp-specs/notes/lcp-for-pdf.html":{"type":"link","url":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-pdf.html","title":"LCP for PDF package","identifier":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-pdf.html","titleInlineContent":[{"text":"LCP for PDF package","type":"text"}]},"https://readium.org/lcp-specs/notes/lcp-for-audiobooks.html":{"url":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-audiobooks.html","identifier":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-audiobooks.html","type":"link","title":"LCP for Audiobooks package","titleInlineContent":[{"type":"text","text":"LCP for Audiobooks package"}]},"doc://Readium/documentation/Readium/Content":{"title":"Extracting the content of a publication","kind":"article","type":"topic","abstract":[],"url":"\/documentation\/readium\/content","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Content"},"#using-the-swiftui-lcp-authentication-dialog":{"type":"link","url":"#using-the-swiftui-lcp-authentication-dialog","title":"prefer using the new LCPDialog","identifier":"#using-the-swiftui-lcp-authentication-dialog","titleInlineContent":[{"text":"prefer using the new ","type":"text"},{"code":"LCPDialog","type":"codeVoice"}]},"https://readium.org/lcp-specs/releases/lcp/latest.html#32-content-conformance":{"url":"https:\/\/readium.org\/lcp-specs\/releases\/lcp\/latest.html#32-content-conformance","identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lcp\/latest.html#32-content-conformance","type":"link","title":"License Document","titleInlineContent":[{"type":"text","text":"License Document"}]},"https://github.com/readium/swift-toolkit/blob/3.0.0/TestApp/Sources/App/Readium.swift#L221":{"type":"link","url":"https:\/\/github.com\/readium\/swift-toolkit\/blob\/3.0.0\/TestApp\/Sources\/App\/Readium.swift#L221","title":"take a look at the Test App","identifier":"https:\/\/github.com\/readium\/swift-toolkit\/blob\/3.0.0\/TestApp\/Sources\/App\/Readium.swift#L221","titleInlineContent":[{"text":"take a look at the Test App","type":"text"}]},"doc://Readium/documentation/Readium/TTS":{"url":"\/documentation\/readium\/tts","identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","type":"topic","kind":"article","role":"article","abstract":[],"title":"Text-to-speech"},"doc://Readium/documentation/Readium/NavigatorOverview":{"abstract":[{"type":"text","text":"Learn about the architecture, configu