{"sections":[],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview"]]},"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Input","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"code":"VisualNavigator","type":"codeVoice"},{"type":"text","text":" implements "},{"code":"InputObservable","type":"codeVoice"},{"type":"text","text":", providing a way to intercept input events."}],"type":"paragraph"},{"level":2,"text":"Implementing an input observer","type":"heading","anchor":"Implementing-an-input-observer"},{"inlineContent":[{"type":"text","text":"Here’s an example of a simple "},{"type":"codeVoice","code":"InputObserving"},{"type":"text","text":" implementation that logs all key and pointer events emitted by the navigator."}],"type":"paragraph"},{"type":"codeListing","code":["navigator.addObserver(InputObserver())","","@MainActor final class InputObserver: InputObserving {","    func didReceive(_ event: PointerEvent) async -> Bool {","        print(\"Received pointer event: \\(event)\")","        return false","    }","","    func didReceive(_ event: KeyEvent) async -> Bool {","        print(\"Received key event: \\(event)\")","        return false","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"If you choose to handle a specific event, return "},{"type":"codeVoice","code":"true"},{"type":"text","text":" to prevent subsequent observers from using it. This is useful when you want to avoid triggering multiple actions upon receiving an event."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An "},{"code":"InputObserving","type":"codeVoice"},{"type":"text","text":" implementation receives low-level events that can be used to create higher-level gesture recognizers, such as taps or pinches. To assist you, the toolkit also offers helpers to observe tap, click and key press events."}],"type":"paragraph"},{"level":2,"text":"Observing tap and click events","type":"heading","anchor":"Observing-tap-and-click-events"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"ActivatePointerObserver","type":"codeVoice"},{"text":" is an implementation of ","type":"text"},{"code":"InputObserving","type":"codeVoice"},{"text":" recognizing single taps or clicks. You can use the convenient static factories to observe these events.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["navigator.addObserver(.tap { event in","    print(\"User tapped at \\(event.location)\")","    return false","})","","\/\/ Key modifiers can be used to recognize an event only when a modifier key is pressed.","navigator.addObserver(.click(modifiers: [.shift]) { event in","    print(\"User clicked at \\(event.location)\")","    return false","})"],"syntax":"swift"},{"level":2,"text":"Identifying the tapped element","type":"heading","anchor":"Identifying-the-tapped-element"},{"inlineContent":[{"text":"When supported by the navigator, a ","type":"text"},{"type":"codeVoice","code":"PointerEvent"},{"text":" carries a ","type":"text"},{"type":"codeVoice","code":"targetElement"},{"text":" property describing the content element under the pointer. This lets you respond differently depending on ","type":"text"},{"inlineContent":[{"text":"what","type":"text"}],"type":"emphasis"},{"text":" the user tapped.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Combine "},{"type":"codeVoice","code":"targetElement"},{"type":"text","text":" with an "},{"type":"codeVoice","code":".activate"},{"type":"text","text":" observer to handle specific element types:"}],"type":"paragraph"},{"type":"codeListing","code":["@_spi(ExperimentalTargetElement) import ReadiumNavigator","","navigator.addObserver(.activate { event in","    guard","        let targetElement = event.targetElement,","        let image = targetElement.content as? ImageContentElement","    else {","        return false","    }","    \/\/ Handle the tapped image.","    return true","})"],"syntax":"swift"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"content"},{"text":" property is a ","type":"text"},{"inlineContent":[{"code":"ContentElement","type":"codeVoice"}],"type":"strong"},{"text":" value. The following concrete types may be reported:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Navigators","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"ImageContentElement","type":"codeVoice"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Embedded images ("},{"code":"<img>","type":"codeVoice"},{"type":"text","text":", "},{"code":"<svg>","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"EPUB"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"SVGContentElement"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Inline SVG ("},{"code":"<svg>","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"text":"EPUB","type":"text"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"inlineContent":[{"code":"targetElement.frame","type":"codeVoice"},{"text":" gives you the element’s on-screen ","type":"text"},{"code":"CGRect","type":"codeVoice"},{"text":" relative to the navigator’s view, which you can use to anchor a popover or animate a zoom transition.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"See "},{"isActive":true,"type":"reference","identifier":"EPUB%20Image%20Preview.md"},{"type":"text","text":" for a full example."}],"type":"paragraph"},{"level":2,"text":"Observing keyboard events","type":"heading","anchor":"Observing-keyboard-events"},{"inlineContent":[{"type":"text","text":"Similarly, the "},{"type":"codeVoice","code":"KeyObserver"},{"type":"text","text":" implementation provides an easy method to intercept keyboard events."}],"type":"paragraph"},{"type":"codeListing","code":["navigator.addObserver(.key { event in","    print(\"User pressed the key \\(event.key) with modifiers \\(event.modifiers)\")","    return false","})"],"syntax":"swift"},{"inlineContent":[{"text":"It can also be used to observe a specific keyboard shortcut.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["navigator.addObserver(.key(.a) {","    self.log(.info, \"User pressed A\")","    return false","})","","navigator.addObserver(.key(.a, [.control, .shift]) {","    self.log(.info, \"User pressed Control+Shift+A\")","    return false","})"],"syntax":"swift"}]}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Navigator","doc:\/\/Readium\/documentation\/Readium\/Preferences","doc:\/\/Readium\/documentation\/Readium\/SwiftUI","doc:\/\/Readium\/documentation\/Readium\/Highlights","doc:\/\/Readium\/documentation\/Readium\/Decorations","doc:\/\/Readium\/documentation\/Readium\/EPUB-Fonts","doc:\/\/Readium\/documentation\/Readium\/EPUB-Image-Preview"],"anchor":"Essentials","title":"Essentials"}],"metadata":{"role":"article","roleHeading":"Article","title":"Observing user input"},"abstract":[{"text":"In visual publications like EPUB or PDF, users can interact with the ","type":"text"},{"code":"VisualNavigator","type":"codeVoice"},{"text":" instance using gestures, a keyboard, a mouse, a pencil, or a trackpad. When the publication does not override user input events, you may want to intercept them to trigger actions in your user interface. For example, you can turn pages or toggle the navigation bar on taps, or open a bookmarks screen when pressing the Command-Shift-D hotkey.","type":"text"}],"references":{"doc://Readium/documentation/Readium/EPUB-Fonts":{"role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/EPUB-Fonts","abstract":[{"text":"Readium allows users to customize the font family used to render a reflowable EPUB, by changing the ","type":"text"},{"identifier":"Preferences.md","isActive":true,"type":"reference"},{"text":".","type":"text"}],"url":"\/documentation\/readium\/epub-fonts","type":"topic","kind":"article","title":"Font families in the EPUB navigator"},"doc://Readium/documentation/Readium":{"type":"topic","kind":"article","abstract":[{"text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin.","type":"text"}],"title":"Readium","role":"collection","url":"\/documentation\/readium","identifier":"doc:\/\/Readium\/documentation\/Readium"},"doc://Readium/documentation/Readium/Navigator":{"title":"Navigator","url":"\/documentation\/readium\/navigator","kind":"article","type":"topic","abstract":[{"text":"You can use a Readium Navigator to present the publication to the user. The ","type":"text"},{"code":"Navigator","type":"codeVoice"},{"text":" renders resources on the screen and offers APIs and user interactions for navigating the contents.","type":"text"}],"identifier":"doc:\/\/Readium\/documentation\/Readium\/Navigator","role":"article"},"doc://Readium/documentation/Readium/EPUB-Image-Preview":{"role":"article","abstract":[{"text":"This guide explains how to detect when a user taps an image in an EPUB publication to present it in a dedicated view, using the ","type":"text"},{"code":"PointerEvent.targetElement","type":"codeVoice"},{"text":" API.","type":"text"}],"title":"EPUB Image Preview","type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/EPUB-Image-Preview","kind":"article","url":"\/documentation\/readium\/epub-image-preview"},"doc://Readium/documentation/Readium/Preferenc