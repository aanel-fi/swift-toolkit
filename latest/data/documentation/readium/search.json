{"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Checking if a publication is searchable","anchor":"Checking-if-a-publication-is-searchable","type":"heading"},{"inlineContent":[{"type":"text","text":"Not every publication has a search service attached. Check "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"isSearchable"}]},{"type":"text","text":" before offering a search UI."}],"type":"paragraph"},{"code":["guard publication.isSearchable else {","    \/\/ Hide or disable the search UI.","    return","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Performing a search","anchor":"Performing-a-search","type":"heading"},{"inlineContent":[{"type":"text","text":"Call "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"publication.search(query:options:)"}]},{"type":"text","text":" to start a new search. This method returns a "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"SearchResult<SearchIterator>"}]},{"type":"text","text":" — either a cursor to page through results, or a "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"SearchError"}]},{"type":"text","text":"."}],"type":"paragraph"},{"code":["let result = await publication.search(query: \"red panda\")","","switch result {","case .success(let iterator):","    \/\/ Use the iterator to page through results.","case .failure(let error):","    handleSearchError(error)","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Iterating through results","anchor":"Iterating-through-results","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"inlineContent":[{"code":"SearchIterator","type":"codeVoice"}],"type":"strong"},{"text":" is a cursor that fetches results one page at a time. Each page is a ","type":"text"},{"inlineContent":[{"code":"LocatorCollection","type":"codeVoice"}],"type":"strong"},{"text":" containing an array of ","type":"text"},{"inlineContent":[{"type":"codeVoice","code":"Locator"}],"type":"strong"},{"text":" values, one per match.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Call ","type":"text"},{"inlineContent":[{"type":"codeVoice","code":"iterator.next()"}],"type":"strong"},{"text":" to retrieve the next page. It returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" on success when all results have been exhausted, or ","type":"text"},{"code":".failure","type":"codeVoice"},{"text":" if a read error occurs.","type":"text"}],"type":"paragraph"},{"code":["while let page = try await iterator.next().get() {","    for locator in page.locators {","        print(\"Found result at: \\(locator.href)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"To navigate directly to a result, pass the locator to the Navigator:"}],"type":"paragraph"},{"code":["await navigator.go(to: locator)"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Pagination strategies","anchor":"Pagination-strategies","type":"heading"},{"inlineContent":[{"text":"Results may arrive in pages to progressively load results. In practice there are two common approaches:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Background load:"}]},{"type":"text","text":" start a "},{"type":"codeVoice","code":"Task"},{"type":"text","text":" that accumulates every result progressively. Simple to implement; the full list updates every time a new page is fetched."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"On-scroll load:","type":"text"}]},{"text":" hold onto the iterator and call ","type":"text"},{"type":"codeVoice","code":"next()"},{"text":" only when the user scrolls to the bottom of the current batch. This keeps memory and CPU usage low, at the cost of slightly more state management.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"Grouping results by section","anchor":"Grouping-results-by-section","type":"heading"},{"inlineContent":[{"inlineContent":[{"code":"locator.title","type":"codeVoice"}],"type":"strong"},{"text":" is the title of the table of contents entry that contains the match — for example, a chapter or section title. Use it to group consecutive results that fall within the same entry:","type":"text"}],"type":"paragraph"},{"code":["var sections: [(title: String?, locators: [Locator])] = []","for locator in page.locators {","    if locator.title == sections.last?.title {","        sections[sections.count - 1].locators.append(locator)","    } else {","        sections.append((title: locator.title, locators: [locator]))","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This preserves order and keeps sections with the same title distinct when they are not consecutive.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Displaying a result snippet","anchor":"Displaying-a-result-snippet","type":"heading"},{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"locator.text"}],"type":"strong"},{"text":" contains the matched text and its surrounding context:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"highlight"},{"type":"text","text":" — the exact string that matched the query."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"before","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"after","type":"codeVoice"},{"text":" — a short snippet of text on either side of the match.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Here is a SwiftUI view that renders a single result with the matched text in bold:","type":"text"}],"type":"paragraph"},{"code":["struct SearchResultRow: View {","    let locator: Locator","","    var body: some View {","        Text(snippet)","    }","","    private var snippet: AttributedString {","        var result = AttributedString()","        if let before = locator.text?.before {","            result += AttributedString(before)","        }","        if let highlight = locator.text?.highlight {","            var bold = AttributedString(highlight)","            bold.font = .body.bold()","            result += bold","        }","        if let after = locator.text?.after {","            result += AttributedString(after)","        }","        return result","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"In a real UI you will typically want to truncate "},{"type":"codeVoice","code":"before"},{"type":"text","text":" and "},{"type":"codeVoice","code":"after"},{"type":"text","text":" so the UI stays compact."}],"type":"paragraph"},{"level":2,"text":"Search options","anchor":"Search-options","type":"heading"},{"inlineContent":[{"text":"Pass a ","type":"text"},{"inlineContent":[{"code":"SearchOptions","type":"codeVoice"}],"type":"strong"},{"text":" value to ","type":"text"},{"code":"search(query:options:)","type":"codeVoice"},{"text":" to override the defaults. Any option you leave as ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" falls back to the default behavior.","type":"text"}],"type":"paragraph"},{"code":["let result = await publication.search(","    query: \"Red Panda\",","    options: SearchOptions(","        caseSensitive: true,","        diacriticSensitive: false","    )",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The full set of available options:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Option"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Built-in","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"caseSensitive","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Bool?"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When "},{"code":"true","type":"codeVoice"},{"type":"text","text":", the search distinguishes upper- and lower-case letters."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"diacriticSensitive"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Bool?"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", accented and unaccented letters are treated as distinct."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"wholeWord"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Bool?","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"No"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", only complete words are matched, not substrings."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"exact","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Bool?","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", the query is matched exactly, including stop words and word order."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"language","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Language?"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Overrides the publication’s language for this search."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"regularExpression","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Bool?","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", the query is interpreted as a regular expression.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"otherOptions"}],"type":"paragraph"}],[{"inlineContent":[{"code":"[String: String]","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"–"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Custom options specific to the search service implementation."}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"The "},{"type":"strong","inlineContent":[{"text":"Built-in","type":"text"}]},{"type":"text","text":" column indicates whether the default Readium configuration handles the option. Options marked "},{"type":"strong","inlineContent":[{"type":"text","text":"No"}]},{"type":"text","text":" are silently ignored unless you provide a custom algorithm that implements them."}],"type":"paragraph"},{"level":3,"text":"Supported options","anchor":"Supported-options","type":"heading"},{"inlineContent":[{"text":"Before displaying search-option controls – e.g. a case sensitivity toggle, or regex mode – inspect ","type":"text"},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"publication.searchOptions"}]},{"text":" to learn which options the service actually supports. An option whose value is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" is ","type":"text"},{"type":"strong","inlineContent":[{"text":"not supported","type":"text"}]},{"text":" by the current service; do not show it in the UI. The actual value indicates the default behavior when the option is not overridden.","type":"text"}],"type":"paragraph"},{"code":["let options = publication.searchOptions","","\/\/ Only show the case-sensitivity toggle if the service supports it.","if let caseSensitive = options.caseSensitive {","    showCaseSensitiveToggle(defaultValue: caseSensitive)","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Error handling","anchor":"Error-handling","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"code":"SearchError","type":"codeVoice"}]},{"type":"text","text":" describes what can go wrong:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".publicationNotSearchable"}]},{"type":"text","text":" – The publication has no search service. Guard on "},{"type":"codeVoice","code":"isSearchable"},{"type":"text","text":" first."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".badQuery(Error)"}]},{"type":"text","text":" – The query string is invalid. Not all implementations produce this; custom services may use it to signal a malformed query (for example, an invalid regular expression)."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".reading(ReadError)"}],"type":"strong"},{"text":" – An I\/O error occurred while reading a resource.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["switch searchError {","case .publicationNotSearchable:","    break \/\/ Should not happen if you check isSearchable first.","case .badQuery(let error):","    showAlert(\"Invalid query\")","case .reading(let error):","    showAlert(\"Failed to read the publication resources\")","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Advanced customization","anchor":"Advanced-customization","type":"heading"},{"level":3,"text":"Configuring the search service","anchor":"Configuring-the-search-service","type":"heading"},{"inlineContent":[{"text":"The default parsers automatically register ","type":"text"},{"inlineContent":[{"type":"codeVoice","code":"ContentSearchService"}],"type":"strong"},{"text":" for EPUB and PDF publications, which relies on the ","type":"text"},{"identifier":"Content.md","type":"reference","isActive":true},{"text":" to inspect the publication content. You do not need to do anything for the default behavior.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To customize the default service — for example, to adjust the snippet length or plug in a different search algorithm — override it in the "},{"code":"onCreatePublication","type":"codeVoice"},{"type":"text","text":" callback when opening a publication:"}],"type":"paragraph"},{"code":["let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    onCreatePublication: { _, _, services in","        services.setSearchServiceFactory(","            ContentSearchService.makeFactory(","                snippetLength: 300,","                searchAlgorithm: BasicStringSearchAlgorithm()","            )","        )","    }",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"snippetLength"},{"type":"text","text":" parameter controls how many characters of context are included in the "},{"type":"codeVoice","code":"before"},{"type":"text","text":" and "},{"type":"codeVoice","code":"after"},{"type":"text","text":" text of each result’s "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"Locator.Text"}]},{"type":"text","text":"."}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"code":"ContentSearchService","type":"codeVoice"},{"type":"text","text":" depends on a "},{"code":"ContentService","type":"codeVoice"},{"type":"text","text":" being registered for the publication. This is set up automatically by the default parsers."}]}],"type":"aside"},{"level":3,"text":"Implementing a custom search algorithm","anchor":"Implementing-a-custom-search-algorithm","type":"heading"},{"inlineContent":[{"text":"The actual text-matching logic is separated into the ","type":"text"},{"inlineContent":[{"code":"StringSearchAlgorithm","type":"codeVoice"}],"type":"strong"},{"text":" protocol. You can swap it out without changing anything else about the service.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"code":"BasicStringSearchAlgorithm","type":"codeVoice"}],"type":"strong"},{"text":" is the built-in implementation. It uses the native ","type":"text"},{"code":"String.range(of:options:)","type":"codeVoice"},{"text":" APIs and supports ","type":"text"},{"code":"caseSensitive","type":"codeVoice"},{"text":", ","type":"text"},{"code":"diacriticSensitive","type":"codeVoice"},{"text":", ","type":"text"},{"code":"exact","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"regularExpression","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To use a custom algorithm, pass it to "},{"type":"codeVoice","code":"ContentSearchService.makeFactory"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["ContentSearchService.makeFactory(searchAlgorithm: MyFuzzySearchAlgorithm())"],"syntax":"swift","type":"codeListing"}]}],"sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"title":"Guides"}],"abstract":[{"type":"text","text":"The Search API lets you look for a textual query in the content of a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":". EPUB and PDF publications are supported."}],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Search","interfaceLanguage":"swift"},"kind":"article","metadata":{"role":"article","roleHeading":"Article","title":"Searching a publication"},"references":{"doc://Readium/documentation/Readium/Readium-LCP":{"role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","kind":"article","abstract":[{"text":"You can use the Readium Swift toolkit to download and read publications that are protected with the ","type":"text"},{"isActive":true,"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","type":"reference"},{"text":" DRM.","type":"text"}],"title":"Supporting Readium LCP","url":"\/documentation\/readium\/readium-lcp","type":"topic"},"doc://Readium/documentation/Readium/NavigatorOverview":{"type":"topic","url":"\/documentation\/readium\/navigatoroverview","abstract":[{"type":"text","text":"Learn about the architecture, configuration, and usage of the Readium Navigator."}],"role":"article","title":"Navigator Overview","kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview"},"Content.md":{"url":"Content.md","identifier":"Content.md","titleInlineContent":[{"type":"text","text":"Content API"}],"title":"Content API","type":"link"},"doc://Readium/documentation/Readium/Content":{"type":"topic","abstract":[],"url":"\/documentation\/readium\/content","role":"article","title":"Extracting the content of a publication","kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Content"},"doc://Readium/documentation/Readium/Accessibility":{"url":"\/documentation\/readium\/accessibility","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","abstract":[{"type":"text","text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the "},{"type":"reference","isActive":true,"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11"},{"type":"text","text":" specification."}],"kind":"article","title":"Accessibility","type":"topic"},"doc://Readium/documentation/Readium/Migration-Guide":{"role":"article","type":"topic","title":"Migration Guide","kind":"article","abstract":[{"type":"text","text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file."}],"url":"\/documentation\/readium\/migration-guide","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide"},"doc://Readium/documentation/Readium/TTS":{"type":"topic","url":"\/documentation\/readium\/tts","identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","abstract":[],"kind":"article","role":"article","title":"Text-to-speech"},"doc://Readium/documentation/Readium/Getting-Started":{"title":"Getting started","abstract":[{"type":"text","text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics."}],"role":"article","kind":"article","type":"topic","url":"\/documentation\/readium\/getting-started","identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started"},"https://www.edrlab.org/readium-lcp/":{"url":"https:\/\/www.edrlab.org\/readium-lcp\/","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","titleInlineContent":[{"type":"text","text":"Readium LCP"}],"title":"Readium LCP","type":"link"},"doc://Readium/documentation/Readium/Open-Publication":{"title":"Opening a publication","type":"topic","abstract":[{"type":"text","text":"To open a publication with Readium, you need to instantiate a couple of components: an "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"Publication