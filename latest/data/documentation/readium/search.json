{"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"kind":"article","sections":[],"metadata":{"title":"Searching a publication","role":"article","roleHeading":"Article"},"seeAlsoSections":[{"anchor":"Guides","title":"Guides","generated":true,"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Checking-if-a-publication-is-searchable","text":"Checking if a publication is searchable"},{"inlineContent":[{"type":"text","text":"Not every publication has a search service attached. Check "},{"inlineContent":[{"type":"codeVoice","code":"isSearchable"}],"type":"strong"},{"type":"text","text":" before offering a search UI."}],"type":"paragraph"},{"code":["guard publication.isSearchable else {","    \/\/ Hide or disable the search UI.","    return","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","anchor":"Performing-a-search","text":"Performing a search"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"inlineContent":[{"type":"codeVoice","code":"publication.search(query:options:)"}],"type":"strong"},{"type":"text","text":" to start a new search. This method returns a "},{"inlineContent":[{"type":"codeVoice","code":"SearchResult<SearchIterator>"}],"type":"strong"},{"type":"text","text":" — either a cursor to page through results, or a "},{"inlineContent":[{"code":"SearchError","type":"codeVoice"}],"type":"strong"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["let result = await publication.search(query: \"red panda\")","","switch result {","case .success(let iterator):","    \/\/ Use the iterator to page through results.","case .failure(let error):","    handleSearchError(error)","}"]},{"level":2,"type":"heading","text":"Iterating through results","anchor":"Iterating-through-results"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"strong","inlineContent":[{"code":"SearchIterator","type":"codeVoice"}]},{"type":"text","text":" is a cursor that fetches results one page at a time. Each page is a "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"LocatorCollection"}]},{"type":"text","text":" containing an array of "},{"type":"strong","inlineContent":[{"code":"Locator","type":"codeVoice"}]},{"type":"text","text":" values, one per match."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"inlineContent":[{"type":"codeVoice","code":"iterator.next()"}],"type":"strong"},{"type":"text","text":" to retrieve the next page. It returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" on success when all results have been exhausted, or "},{"type":"codeVoice","code":".failure"},{"type":"text","text":" if a read error occurs."}]},{"syntax":"swift","type":"codeListing","code":["while let page = try await iterator.next().get() {","    for locator in page.locators {","        print(\"Found result at: \\(locator.href)\")","    }","}"]},{"inlineContent":[{"text":"To navigate directly to a result, pass the locator to the Navigator:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["await navigator.go(to: locator)"]},{"level":3,"anchor":"Pagination-strategies","type":"heading","text":"Pagination strategies"},{"inlineContent":[{"type":"text","text":"Results may arrive in pages to progressively load results. In practice there are two common approaches:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Background load:"}]},{"type":"text","text":" start a "},{"type":"codeVoice","code":"Task"},{"type":"text","text":" that accumulates every result progressively. Simple to implement; the full list updates every time a new page is fetched."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"On-scroll load:"}],"type":"strong"},{"text":" hold onto the iterator and call ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" only when the user scrolls to the bottom of the current batch. This keeps memory and CPU usage low, at the cost of slightly more state management.","type":"text"}]}]}],"type":"unorderedList"},{"level":3,"anchor":"Grouping-results-by-section","type":"heading","text":"Grouping results by section"},{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"locator.title"}],"type":"strong"},{"text":" is the title of the table of contents entry that contains the match — for example, a chapter or section title. Use it to group consecutive results that fall within the same entry:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var sections: [(title: String?, locators: [Locator])] = []","for locator in page.locators {","    if locator.title == sections.last?.title {","        sections[sections.count - 1].locators.append(locator)","    } else {","        sections.append((title: locator.title, locators: [locator]))","    }","}"]},{"inlineContent":[{"text":"This preserves order and keeps sections with the same title distinct when they are not consecutive.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Displaying-a-result-snippet","type":"heading","text":"Displaying a result snippet"},{"inlineContent":[{"type":"strong","inlineContent":[{"code":"locator.text","type":"codeVoice"}]},{"type":"text","text":" contains the matched text and its surrounding context:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"highlight"},{"type":"text","text":" — the exact string that matched the query."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"before","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"after","type":"codeVoice"},{"text":" — a short snippet of text on either side of the match.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Here is a SwiftUI view that renders a single result with the matched text in bold:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct SearchResultRow: View {","    let locator: Locator","","    var body: some View {","        Text(snippet)","    }","","    private var snippet: AttributedString {","        var result = AttributedString()","        if let before = locator.text?.before {","            result += AttributedString(before)","        }","        if let highlight = locator.text?.highlight {","            var bold = AttributedString(highlight)","            bold.font = .body.bold()","            result += bold","        }","        if let after = locator.text?.after {","            result += AttributedString(after)","        }","        return result","    }","}"]},{"inlineContent":[{"text":"In a real UI you will typically want to truncate ","type":"text"},{"type":"codeVoice","code":"before"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"after"},{"text":" so the UI stays compact.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Search-options","type":"heading","text":"Search options"},{"inlineContent":[{"text":"Pass a ","type":"text"},{"inlineContent":[{"type":"codeVoice","code":"SearchOptions"}],"type":"strong"},{"text":" value to ","type":"text"},{"code":"search(query:options:)","type":"codeVoice"},{"text":" to override the defaults. Any option you leave as ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" falls back to the default behavior.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let result = await publication.search(","    query: \"Red Panda\",","    options: SearchOptions(","        caseSensitive: true,","        diacriticSensitive: false","    )",")"]},{"inlineContent":[{"type":"text","text":"The full set of available options:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Option","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Built-in","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"caseSensitive"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Bool?"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", the search distinguishes upper- and lower-case letters.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"diacriticSensitive"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Bool?"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", accented and unaccented letters are treated as distinct."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"wholeWord","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Bool?"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"No"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", only complete words are matched, not substrings.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"exact","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Bool?"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", the query is matched exactly, including stop words and word order."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"language"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Language?"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Overrides the publication’s language for this search."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"regularExpression"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Bool?"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", the query is interpreted as a regular expression."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"otherOptions"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"[String: String]"}],"type":"paragraph"}],[{"inlineContent":[{"text":"–","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Custom options specific to the search service implementation."}],"type":"paragraph"}]]],"type":"table","header":"row"},{"inlineContent":[{"type":"text","text":"The "},{"type":"strong","inlineContent":[{"type":"text","text":"Built-in"}]},{"type":"text","text":" column indicates whether the default Readium configuration handles the option. Options marked "},{"type":"strong","inlineContent":[{"text":"No","type":"text"}]},{"type":"text","text":" are silently ignored unless you provide a custom algorithm that implements them."}],"type":"paragraph"},{"level":3,"anchor":"Supported-options","type":"heading","text":"Supported options"},{"inlineContent":[{"type":"text","text":"Before displaying search-option controls – e.g. a case sensitivity toggle, or regex mode – inspect "},{"type":"strong","inlineContent":[{"code":"publication.searchOptions","type":"codeVoice"}]},{"type":"text","text":" to learn which options the service actually supports. An option whose value is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" is "},{"type":"strong","inlineContent":[{"type":"text","text":"not supported"}]},{"type":"text","text":" by the current service; do not show it in the UI. The actual value indicates the default behavior when the option is not overridden."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let options = publication.searchOptions","","\/\/ Only show the case-sensitivity toggle if the service supports it.","if let caseSensitive = options.caseSensitive {","    showCaseSensitiveToggle(defaultValue: caseSensitive)","}"]},{"level":2,"anchor":"Error-handling","type":"heading","text":"Error handling"},{"inlineContent":[{"type":"strong","inlineContent":[{"code":"SearchError","type":"codeVoice"}]},{"text":" describes what can go wrong:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".publicationNotSearchable"}]},{"type":"text","text":" – The publication has no search service. Guard on "},{"type":"codeVoice","code":"isSearchable"},{"type":"text","text":" first."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".badQuery(Error)","type":"codeVoice"}],"type":"strong"},{"text":" – The query string is invalid. Not all implementations produce this; custom services may use it to signal a malformed query (for example, an invalid regular expression).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".reading(ReadError)"}]},{"text":" – An I\/O error occurred while reading a resource.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"codeListing","syntax":"swift","code":["switch searchError {","case .publicationNotSearchable:","    break \/\/ Should not happen if you check isSearchable first.","case .badQuery(let error):","    showAlert(\"Invalid query\")","case .reading(let error):","    showAlert(\"Failed to read the publication resources\")","}"]},{"level":2,"anchor":"Advanced-customization","type":"heading","text":"Advanced customization"},{"level":3,"anchor":"Configuring-the-search-service","type":"heading","text":"Configuring the search service"},{"inlineContent":[{"type":"text","text":"The default parsers automatically register "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"ContentSearchService"}]},{"type":"text","text":" for EPUB and PDF publications, which relies on the "},{"identifier":"Content.md","type":"reference","isActive":true},{"type":"text","text":" to inspect the publication content. You do not need to do anything for the default behavior."}],"type":"paragraph"},{"inlineContent":[{"text":"To customize the default service — for example, to adjust the snippet length or plug in a different search algorithm — override it in the ","type":"text"},{"code":"onCreatePublication","type":"codeVoice"},{"text":" callback when opening a publication:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    onCreatePublication: { _, _, services in","        services.setSearchServiceFactory(","            ContentSearchService.makeFactory(","                snippetLength: 300,","                searchAlgorithm: BasicStringSearchAlgorithm()","            )","        )","    }",")"]},{"inlineContent":[{"text":"The ","type":"text"},{"code":"snippetLength","type":"codeVoice"},{"text":" parameter controls how many characters of context are included in the ","type":"text"},{"code":"before","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"after","type":"codeVoice"},{"text":" text of each result’s ","type":"text"},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"Locator.Text"}]},{"text":".","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"codeVoice","code":"ContentSearchService"},{"type":"text","text":" depends on a "},{"type":"codeVoice","code":"ContentService"},{"type":"text","text":" being registered for the publication. This is set up automatically by the default parsers."}],"type":"paragraph"}],"name":"Note","type":"aside","style":"note"},{"level":3,"anchor":"Implementing-a-custom-search-algorithm","type":"heading","text":"Implementing a custom search algorithm"},{"inlineContent":[{"type":"text","text":"The actual text-matching logic is separated into the "},{"type":"strong","inlineContent":[{"code":"StringSearchAlgorithm","type":"codeVoice"}]},{"type":"text","text":" protocol. You can swap it out without changing anything else about the service."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"BasicStringSearchAlgorithm"}]},{"type":"text","text":" is the built-in implementation. It uses the native "},{"type":"codeVoice","code":"String.range(of:options:)"},{"type":"text","text":" APIs and supports "},{"type":"codeVoice","code":"caseSensitive"},{"type":"text","text":", "},{"type":"codeVoice","code":"diacriticSensitive"},{"type":"text","text":", "},{"type":"codeVoice","code":"exact"},{"type":"text","text":", and "},{"type":"codeVoice","code":"regularExpression"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"To use a custom algorithm, pass it to ","type":"text"},{"code":"ContentSearchService.makeFactory","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["ContentSearchServic