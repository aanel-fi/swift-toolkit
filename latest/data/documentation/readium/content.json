{"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"text","text":"The described feature is still experimental and the implementation incomplete."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"Many high-level features require access to the raw content (text, media, etc.) of a publication, such as:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Text-to-speech"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Accessibility reader","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Basic search"}]}]},{"content":[{"inlineContent":[{"text":"Full-text search indexing","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Image or audio indexes","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"ContentService","type":"codeVoice"},{"text":" provides a way to iterate through a publication’s content, extracted as semantic elements.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"First, request the publication’s "},{"type":"codeVoice","code":"Content"},{"type":"text","text":", starting from a given "},{"type":"codeVoice","code":"Locator"},{"type":"text","text":". If the locator is missing, the "},{"type":"codeVoice","code":"Content"},{"type":"text","text":" will be extracted from the beginning of the publication."}]},{"code":["guard let content = publication.content(from: startLocator) else {","    \/\/ Abort as the content cannot be extracted","    return","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Extracting-the-raw-text-content","level":2,"text":"Extracting the raw text content","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Getting the whole raw text of a publication is such a common use case that a helper is available on "},{"code":"Content","type":"codeVoice"},{"type":"text","text":":"}]},{"code":["let wholeText = content.text()"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is an expensive operation, proceed with caution and cache the result if you need to reuse it."}]},{"anchor":"Iterating-through-the-content","level":2,"text":"Iterating through the content","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The individual ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":" elements can be iterated through with a regular ","type":"text"},{"code":"for","type":"codeVoice"},{"text":" loop by converting it to a sequence:","type":"text"}]},{"code":["for element in content.sequence() {","    \/\/ Process element","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Alternatively, you can get the whole list of elements with "},{"type":"codeVoice","code":"content.elements()"},{"type":"text","text":", or use the lower level APIs to iterate the content manually:"}]},{"code":["let iterator = content.iterator()","while let element = try iterator.next() {","    print(element)","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some "},{"type":"codeVoice","code":"Content"},{"type":"text","text":" implementations support bidirectional iterations. To iterate backwards, use:"}]},{"code":["let iterator = content.iterator()","while let element = try iterator.previous() {","    print(element)","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Processing-the-elements","level":2,"text":"Processing the elements","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"Content"},{"text":" iterator yields ","type":"text"},{"type":"codeVoice","code":"ContentElement"},{"text":" objects representing a single semantic portion of the publication, such as a heading, a paragraph or an embedded image.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Every element has a ","type":"text"},{"type":"codeVoice","code":"locator"},{"text":" property targeting it in the publication. You can use the locator, for example, to navigate to the element or to draw a ","type":"text"},{"type":"codeVoice","code":"Decoration"},{"text":" on top of it.","type":"text"}]},{"code":["navigator.go(to: element.locator)"],"syntax":"swift","type":"codeListing"},{"anchor":"Types-of-elements","level":3,"text":"Types of elements","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Depending on the actual implementation of ","type":"text"},{"code":"ContentElement","type":"codeVoice"},{"text":", more properties are available to access the actual data. The toolkit ships with a number of default implementations for common types of elements.","type":"text"}]},{"anchor":"Embedded-media","level":4,"text":"Embedded media","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"EmbeddedContentElement"},{"type":"text","text":" protocol is implemented by any element referencing an external resource. It contains an "},{"type":"codeVoice","code":"embeddedLink"},{"type":"text","text":" property you can use to get the actual content of the resource."}]},{"code":["if let element = element as? EmbeddedContentElement {","    let bytes = try publication","        .get(element.embeddedLink)","        .read().get()","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here are the default available implementations:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"AudioContentElement","type":"codeVoice"},{"text":" - audio clips","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"VideoContentElement","type":"codeVoice"},{"type":"text","text":" - video clips"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ImageContentElement"},{"type":"text","text":" - bitmap images, with the additional property:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"caption: String?"},{"text":" - figure caption, when available","type":"text"}]}]}]}]}],"type":"unorderedList"},{"anchor":"Text","level":4,"text":"Text","type":"heading"},{"anchor":"Textual-elements","level":5,"text":"Textual elements","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"TextualContentElement","type":"codeVoice"},{"type":"text","text":" protocol is implemented by any element which can be represented as human-readable text. This is useful when you want to extract the text content of a publication without caring for each individual type of elements."}]},{"code":["let wholeText = publication.content()","    .elements()","    .compactMap { ($0 as? TextualContentElement)?.text.takeIf { !$0.isEmpty } }","    .joined(separator: \"\\n\")"],"syntax":"swift","type":"codeListing"},{"anchor":"Text-elements","level":5,"text":"Text elements","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Actual text elements are instances of "},{"type":"codeVoice","code":"TextContentElement"},{"type":"text","text":", which represent a single block of text such as a heading, a paragraph or a list item. It is comprised of a "},{"type":"codeVoice","code":"role"},{"type":"text","text":" and a list of "},{"type":"codeVoice","code":"segments"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"role"},{"type":"text","text":" is the nature of the text element in the document. For example a heading, body, footnote or a quote. It can be used to reconstruct part of the structure of the original document."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A text element is composed of individual segments with their own "},{"code":"locator","type":"codeVoice"},{"type":"text","text":" and "},{"code":"attributes","type":"codeVoice"},{"type":"text","text":". They are useful to associate attributes with a portion of a text element. For example, given the HTML paragraph:"}]},{"code":["<p>It is pronounced <span lang=\"fr\">croissant<\/span>.<\/p>"],"syntax":"html","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following "},{"type":"codeVoice","code":"TextContentElement"},{"type":"text","text":" will be produced:"}]},{"code":["TextContentElement(","    role: .body,","    segments: [","        TextContentElement.Segment(text: \"It is pronounced \"),","        TextContentElement.Segment(text: \"croissant\", attributes: [ContentAttribute(key: .language, value: \"fr\")]),","        TextContentElement.Segment(text: \".\")","    ]",")"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you are not interested in the segment attributes, you can also use "},{"type":"codeVoice","code":"element.text"},{"type":"text","text":" to get the concatenated raw text."}]},{"anchor":"Element-attributes","level":3,"text":"Element attributes","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"All types of ","type":"text"},{"code":"ContentElement","type":"codeVoice"},{"text":" can have associated attributes. Custom ","type":"text"},{"code":"ContentService","type":"codeVoice"},{"text":" implementations can use this as an extensibility point.","type":"text"}]},{"anchor":"Use-cases","level":2,"text":"Use cases","type":"heading"},{"anchor":"An-index-of-all-images-embedded-in-the-publication","level":3,"text":"An index of all images embedded in the publication","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This example extracts all the embedded images in the publication and displays them in a SwiftUI list. Clicking on an image jumps to its location in the publication."}]},{"code":["struct ImageIndex: View {","    struct Item: Hashable {","        let locator: Locator","        let text: String?","        let image: UIImage","    }","","    let publication: Publication","    let navigator: Navigator","    @State private var items: [Item] = []","","    init(publication: Publication, navigator: Navigator) {","        self.publication = publication","        self.navigator = navigator","    }","","    var body: some View {","        ScrollView {","            LazyVStack {","                ForEach(items, id: \\.self) { item in","                    VStack() {","                        Image(uiImage: item.image)","                        Text(item.text ?? \"No caption\")","                    }","                    .onTapGesture {","                        navigator.go(to: item.locator)","                    }","                }","            }","        }","        .onAppear {","            items = publication.content()?","                .elements()","                .compactMap { element in","                    guard","                        let element = element as? ImageContentElement,","                        let image = try? publication.get(element.embeddedLink)","                            .read().map(UIImage.init).get()","                    else {","                        return nil","                    }","","                    return Item(","                        locator: element.locator,","                        text: element.caption ?? element.accessibilityLabel,","                        image: image","                    )","                }","                ?? []","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"References","level":2,"text":"References","type":"heading"},{"items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177","type":"reference"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/Readium\/Content"},"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"generated":true,"anchor":"Guides"}],"metadata":{"roleHeading":"Article","title":"Extracting the content of a publication","role":"article"},"references":{"doc://Readium/documentation/Readium/TTS":{"type":"topic","title":"Text-to-speech","abstract":[],"identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","kind":"article","role":"article","url":"\/documentation\/readium\/tts"},"https://github.com/readium/architecture/pull/177":{"type":"link","title":"Content Iterator proposal","titleInlineContent":[{"text":"Content Iterator proposal","type":"text"}],"url":"https:\/\/github.com\/readium\/architecture\/pull\/177","identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177"},"https://www.edrlab.org/readium-lcp/":{"type":"link","title":"Readium LCP","titleInlineContent":[{"type":"text","text":"Readium LCP"}],"url":"https:\/\/www.edrlab.org\/readium-lcp\/","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/"},"doc://Readium/documentation/Readium/Accessibility":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","url":"\/documentation\/readium\/accessibility","type":"topic","role":"article","abstract":[{"type":"text","text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the "},{"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"reference","isActive":true},{"type":"text","text":" specification."}],"title":"Accessibility","kind":"article"},"doc://Readium/documentation/Readium/Open-Publication":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","kind":"article","title":"Opening a publication","type":"topic","abstract":[{"type":"text","text":"To open a publication with Readium, you need to instantiate a couple of components: an "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":"."}],"url":"\/documentation\/readium\/open-publication","role":"article"},"doc://Readium/documentation/Readium/Migration-Guide":{"type":"topic","title":"Migration Guide","abstract":[{"text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file.","type":"text"}],"identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","kind":"article","role":"article","url":"\/documentation\/readium\/migration-guide"},"https://www.w3.org/TR/epub-a11y-11":{"type":"link","title":"EPUB Accessibility","titleInlineContent":[{"text":"EPUB Accessibility","type":"text"}],"url":"https:\/\/www.w3.org\/TR\/epub-a11y-11","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11"},"doc://Readium/documentation/Readium/NavigatorOverview":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","kind":"article","abstract":[{"text":"Learn about the architecture, configuration, and usage of the Readium Navigator.","type":"text"}],"title":"Navigator Overview","type":"topic","url":"\/documentation\/readium\/navigatoroverview","role":"article"},"doc://Readium/documentation/Readium/Readium-LCP":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","title":"Supporting Readium LCP","kind":"article","role":"article","type":"topic","abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"type":"reference","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","isActive":true},{"type":"text","text":" DRM."}],"url":"\/documentation\/readium\/readium-lcp"},"doc://Readium/documentation/Readium/Getting-Started":{"type":"topic","title":"Getting started","abstract":[{"text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics.","type":"text"}],"identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","kind":"article","role":"article","url":"\/documentation\/readium\/getting-started"},"doc://Readium/documentation/Readium/Search":{"abstract":[{"type":"text","text":"The Search API lets you look for a textual query in the content of a "},{"code":"Publication","type":"codeVoice"},{"type":"text","text":". EPUB and PDF publications are supported."}],"type":"topic","title":"Searching a publication","kind":"article","url":"\/documentation\/readium\/search","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","role":"article"},"doc://Readium/documentation/Readium":{"type":"topic","kind":"article","abstract":[{"text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin.","type":"text"}],"title":"Readium","role":"collection","url":"\/documentation\/readium","identifier":"doc:\/\/Readium\/documentation\/Readium"}}}