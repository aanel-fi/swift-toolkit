{"seeAlsoSections":[{"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"anchor":"Guides","title":"Guides","generated":true}],"metadata":{"roleHeading":"Article","title":"Extracting the content of a publication","role":"article"},"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Content","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"aside","name":"Note","content":[{"inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"text","text":"The described feature is still experimental and the implementation incomplete."}],"type":"paragraph"}],"style":"note"},{"inlineContent":[{"text":"Many high-level features require access to the raw content (text, media, etc.) of a publication, such as:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Text-to-speech"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Accessibility reader","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Basic search"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Full-text search indexing","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Image or audio indexes","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"ContentService"},{"text":" provides a way to iterate through a publication’s content, extracted as semantic elements.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"First, request the publication’s "},{"type":"codeVoice","code":"Content"},{"type":"text","text":", starting from a given "},{"type":"codeVoice","code":"Locator"},{"type":"text","text":". If the locator is missing, the "},{"type":"codeVoice","code":"Content"},{"type":"text","text":" will be extracted from the beginning of the publication."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["guard let content = publication.content(from: startLocator) else {","    \/\/ Abort as the content cannot be extracted","    return","}"]},{"type":"heading","level":2,"text":"Extracting the raw text content","anchor":"Extracting-the-raw-text-content"},{"type":"paragraph","inlineContent":[{"text":"Getting the whole raw text of a publication is such a common use case that a helper is available on ","type":"text"},{"type":"codeVoice","code":"Content"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["let wholeText = content.text()"]},{"type":"paragraph","inlineContent":[{"text":"This is an expensive operation, proceed with caution and cache the result if you need to reuse it.","type":"text"}]},{"type":"heading","level":2,"text":"Iterating through the content","anchor":"Iterating-through-the-content"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The individual "},{"type":"codeVoice","code":"Content"},{"type":"text","text":" elements can be iterated through with a regular "},{"type":"codeVoice","code":"for"},{"type":"text","text":" loop by converting it to a sequence:"}]},{"type":"codeListing","syntax":"swift","code":["for element in content.sequence() {","    \/\/ Process element","}"]},{"type":"paragraph","inlineContent":[{"text":"Alternatively, you can get the whole list of elements with ","type":"text"},{"code":"content.elements()","type":"codeVoice"},{"text":", or use the lower level APIs to iterate the content manually:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let iterator = content.iterator()","while let element = try iterator.next() {","    print(element)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some "},{"type":"codeVoice","code":"Content"},{"type":"text","text":" implementations support bidirectional iterations. To iterate backwards, use:"}]},{"type":"codeListing","syntax":"swift","code":["let iterator = content.iterator()","while let element = try iterator.previous() {","    print(element)","}"]},{"type":"heading","level":2,"text":"Processing the elements","anchor":"Processing-the-elements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"Content","type":"codeVoice"},{"type":"text","text":" iterator yields "},{"code":"ContentElement","type":"codeVoice"},{"type":"text","text":" objects representing a single semantic portion of the publication, such as a heading, a paragraph or an embedded image."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every element has a "},{"code":"locator","type":"codeVoice"},{"type":"text","text":" property targeting it in the publication. You can use the locator, for example, to navigate to the element or to draw a "},{"code":"Decoration","type":"codeVoice"},{"type":"text","text":" on top of it."}]},{"type":"codeListing","syntax":"swift","code":["navigator.go(to: element.locator)"]},{"type":"heading","level":3,"text":"Types of elements","anchor":"Types-of-elements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Depending on the actual implementation of "},{"type":"codeVoice","code":"ContentElement"},{"type":"text","text":", more properties are available to access the actual data. The toolkit ships with a number of default implementations for common types of elements."}]},{"type":"heading","level":4,"text":"Embedded media","anchor":"Embedded-media"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"EmbeddedContentElement","type":"codeVoice"},{"text":" protocol is implemented by any element referencing an external resource. It contains an ","type":"text"},{"code":"embeddedLink","type":"codeVoice"},{"text":" property you can use to get the actual content of the resource.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["if let element = element as? EmbeddedContentElement {","    let bytes = try publication","        .get(element.embeddedLink)","        .read().get()","}"]},{"type":"paragraph","inlineContent":[{"text":"Here are the default available implementations:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"AudioContentElement"},{"type":"text","text":" - audio clips"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"VideoContentElement"},{"text":" - video clips","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ImageContentElement"},{"type":"text","text":" - bitmap images, with the additional property:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"caption: String?"},{"type":"text","text":" - figure caption, when available"}],"type":"paragraph"}]}],"type":"unorderedList"}]}]},{"type":"heading","level":4,"text":"Text","anchor":"Text"},{"type":"heading","level":5,"text":"Textual elements","anchor":"Textual-elements"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"TextualContentElement","type":"codeVoice"},{"text":" protocol is implemented by any element which can be represented as human-readable text. This is useful when you want to extract the text content of a publication without caring for each individual type of elements.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let wholeText = publication.content()","    .elements()","    .compactMap { ($0 as? TextualContentElement)?.text.takeIf { !$0.isEmpty } }","    .joined(separator: \"\\n\")"]},{"type":"heading","level":5,"text":"Text elements","anchor":"Text-elements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Actual text elements are instances of "},{"type":"codeVoice","code":"TextContentElement"},{"type":"text","text":", which represent a single block of text such as a heading, a paragraph or a list item. It is comprised of a "},{"type":"codeVoice","code":"role"},{"type":"text","text":" and a list of "},{"type":"codeVoice","code":"segments"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"role"},{"type":"text","text":" is the nature of the text element in the document. For example a heading, body, footnote or a quote. It can be used to reconstruct part of the structure of the original document."}]},{"type":"paragraph","inlineContent":[{"text":"A text element is composed of individual segments with their own ","type":"text"},{"code":"locator","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"attributes","type":"codeVoice"},{"text":". They are useful to associate attributes with a portion of a text element. For example, given the HTML paragraph:","type":"text"}]},{"type":"codeListing","syntax":"html","code":["<p>It is pronounced <span lang=\"fr\">croissant<\/span>.<\/p>"]},{"type":"paragraph","inlineContent":[{"text":"The following ","type":"text"},{"code":"TextContentElement","type":"codeVoice"},{"text":" will be produced:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["TextContentElement(","    role: .body,","    segments: [","        TextContentElement.Segment(text: \"It is pronounced \"),","        TextContentElement.Segment(text: \"croissant\", attributes: [ContentAttribute(key: .language, value: \"fr\")]),","        TextContentElement.Segment(text: \".\")","    ]",")"]},{"type":"paragraph","inlineContent":[{"text":"If you are not interested in the segment attributes, you can also use ","type":"text"},{"code":"element.text","type":"codeVoice"},{"text":" to get the concatenated raw text.","type":"text"}]},{"type":"heading","level":3,"text":"Element attributes","anchor":"Element-attributes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All types of "},{"type":"codeVoice","code":"ContentElement"},{"type":"text","text":" can have associated attributes. Custom "},{"type":"codeVoice","code":"ContentService"},{"type":"text","text":" implementations can use this as an extensibility point."}]},{"type":"heading","level":2,"text":"Use cases","anchor":"Use-cases"},{"type":"heading","level":3,"text":"An index of all images embedded in the publication","anchor":"An-index-of-all-images-embedded-in-the-publication"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This example extracts all the embedded images in the publication and displays them in a SwiftUI list. Clicking on an image jumps to its location in the publication."}]},{"type":"codeListing","syntax":"swift","code":["struct ImageIndex: View {","    struct Item: Hashable {","        let locator: Locator","        let text: String?","        let image: UIImage","    }","","    let publication: Publication","    let navigator: Navigator","    @State private var items: [Item] = []","","    init(publication: Publication, navigator: Navigator) {","        self.publication = publication","        self.navigator = navigator","    }","","    var body: some View {","        ScrollView {","            LazyVStack {","                ForEach(items, id: \\.self) { item in","                    VStack() {","                        Image(uiImage: item.image)","                        Text(item.text ?? \"No caption\")","                    }","                    .onTapGesture {","                        navigator.go(to: item.locator)","                    }","                }","            }","        }","        .onAppear {","            items = publication.content()?","                .elements()","                .compactMap { element in","                    guard","                        let element = element as? ImageContentElement,","                        let image = try? publication.get(element.embeddedLink)","                            .read().map(UIImage.init).get()","                    else {","                        return nil","                    }","","                    return Item(","                        locator: element.locator,","                        text: element.caption ?? element.accessibilityLabel,","                        image: image","                    )","                }","                ?? []","        }","    }","}"]},{"type":"heading","level":2,"text":"References","anchor":"References"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177","type":"reference"}]}]}]}]}],"references":{"https://www.edrlab.org/readium-lcp/":{"url":"https:\/\/www.edrlab.org\/readium-lcp\/","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","titleInlineContent":[{"type":"text","text":"Readium LCP"}],"title":"Readium LCP","type":"link"},"doc://Readium/documentation/Readium/Readium-LCP":{"role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","kind":"article","abstract":[{"text":"You can use the Readium Swift toolkit to download and read publications that are protected with the ","type":"text"},{"isActive":true,"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","type":"reference"},{"text":" DRM.","type":"text"}],"title":"Supporting Readium LCP","url":"\/documentation\/readium\/readium-lcp","type":"topic"},"doc://Readium/documentation/Readium/Search":{"abstract":[{"type":"text","text":"The Search API lets you look for a textual query in the content of a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":". EPUB and PDF publications are supported."}],"url":"\/documentation\/readium\/search","kind":"article","title":"Searching a publication","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","type":"topic","role":"article"},"doc://Readium/documentation/Readium/Accessibility":{"url":"\/documentation\/readium\/accessibility","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","abstract":[{"type":"text","text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the "},{"type":"reference","isActive":true,"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11"},{"type":"text","text":" specification."}],"kind":"article","title":"Accessibility","type":"topic"},"doc://Readium/documentation/Readium/Open-Publication":{"title":"Opening a publication","type":"topic","abstract":[{"type":"text","text":"To open a publication with Readium, you need to instantiate a couple of components: an "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":"."}],"kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","role":"article","url":"\/documentation\/readium\/open-publication"},"doc://Readium/documentation/Readium/NavigatorOverview":{"type":"topic","url":"\/documentation\/readium\/navigatoroverview","abstract":[{"type":"text","text":"Learn about the architecture, configuration, and usage of the Readium Navigator."}],"role":"article","title":"Navigator Overview","kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview"},"doc://Readium/documentation/Readium":{"title":"Readium","abstract":[{"text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin.","type":"text"}],"kind":"article","type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium","role":"collection","url":"\/documentation\/readium"},"doc://Readium/documentation/Readium/Getting-Started":{"title":"Getting started","abstract":[{"type":"text","text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics."}],"role":"article","kind":"article","type":"topic","url":"\/documentation\/readium\/getting-started","identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started"},"https://github.com/readium/architecture/pull/177":{"type":"link","titleInlineContent":[{"text":"Content Iterator proposal","type":"text"}],"identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177","title":"Content Iterator proposal","url":"https:\/\/github.com\/readium\/architecture\/pull\/177"},"doc://Readium/documentation/Readium/Migration-Guide":{"role":"article","type":"topic","title":"Migration Guide","kind":"article","abstract":[{"type":"text","text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file."}],"url":"\/documentation\/readium\/migration-guide","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide"},"https://www.w3.org/TR/epub-a11y-11":{"type":"link","titleInlineContent":[{"text":"EPUB Accessibility","type":"text"}],"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","title":"EPUB Accessibility","url":"https:\/\/www.w3.org\/TR\/epub-a11y-11"},"doc://Readium/documentation/Readium/TTS":{"type":"topic","url":"\/documentation\/readium\/tts","identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","abstract":[],"kind":"article","role":"article","title":"Text-to-speech"}}}