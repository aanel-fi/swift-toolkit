UB publication to present it in a dedicated view, using the ","type":"text"},{"code":"PointerEvent.targetElement","type":"codeVoice"},{"text":" API.","type":"text"}]},"https://developer.apple.com/documentation/swiftui/uiviewrepresentable":{"title":"UIViewRepresentable","titleInlineContent":[{"type":"codeVoice","code":"UIViewRepresentable"}],"identifier":"https:\/\/developer.apple.com\/documentation\/swiftui\/uiviewrepresentable","url":"https:\/\/developer.apple.com\/documentation\/swiftui\/uiviewrepresentable","type":"link"},"doc://Readium/documentation/Readium/Readium-LCP":{"title":"Supporting Readium LCP","url":"\/documentation\/readium\/readium-lcp","type":"topic","abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"isActive":true,"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","type":"reference"},{"type":"text","text":" DRM."}],"identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","kind":"article","role":"article"},"doc://Readium/documentation/Readium/Highlights":{"kind":"article","role":"article","type":"topic","url":"\/documentation\/readium\/highlights","identifier":"doc:\/\/Readium\/documentation\/Readium\/Highlights","abstract":[{"type":"text","text":"Highlighting lets users mark up passages in a publication for later reference - a core feature of any reading app. In Readium, highlights are built on top of the "},{"type":"strong","inlineContent":[{"text":"Decoration API","type":"text"}]},{"type":"text","text":". If you want to understand that API in depth or build a custom decoration style, see the "},{"identifier":"Decorations.md","type":"reference","isActive":true},{"type":"text","text":"."}],"title":"Implementing Highlights"},"doc://Readium/documentation/Readium/SwiftUI":{"role":"article","url":"\/documentation\/readium\/swiftui","abstract":[{"type":"text","text":"The Navigator is built with UIKit and provides "},{"code":"UIViewController","type":"codeVoice"},{"type":"text","text":" implementations. Nevertheless, you can integrate them into a SwiftUI view hierarchy using Apple’s "},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/swiftui\/uiviewrepresentable"},{"type":"text","text":"."}],"title":"Integrating the Navigator with SwiftUI","identifier":"doc:\/\/Readium\/documentation\/Readium\/SwiftUI","kind":"article","type":"topic"},"Highlights.md":{"title":"Highlighting guide","type":"link","identifier":"Highlights.md","titleInlineContent":[{"text":"Highlighting guide","type":"text"}],"url":"Highlights.md"},"doc://Readium/documentation/Readium/Accessibility":{"abstract":[{"text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11"},{"text":" specification.","type":"text"}],"kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","url":"\/documentation\/readium\/accessibility","type":"topic","role":"article","title":"Accessibility"},"https://www.w3.org/TR/epub-a11y-11":{"title":"EPUB Accessibility","titleInlineContent":[{"text":"EPUB Accessibility","type":"text"}],"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","url":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"link"},"https://www.edrlab.org/readium-lcp/":{"title":"Readium LCP","type":"link","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","titleInlineContent":[{"text":"Readium LCP","type":"text"}],"url":"https:\/\/www.edrlab.org\/readium-lcp\/"},"doc://Readium/documentation/Readium":{"type":"topic","abstract":[{"text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin.","type":"text"}],"url":"\/documentation\/readium","kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium","title":"Readium","role":"collection"},"doc://Readium/documentation/Readium/Getting-Started":{"abstract":[{"type":"text","text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics."}],"kind":"article","title":"Getting started","type":"topic","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","url":"\/documentation\/readium\/getting-started"},"doc://Readium/documentation/Readium/Decorations":{"title":"Decorations","type":"topic","url":"\/documentation\/readium\/decorations","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Decorations","kind":"article","abstract":[{"type":"text","text":"The Decoration API lets you overlay visual elements on publication content – highlights, search result markers, TTS playback indicators, page-number labels in the margin, and more. For the common case of implementing user highlights, see the "},{"type":"reference","identifier":"Highlights.md","isActive":true},{"type":"text","text":"."}]},"Preferences.md":{"title":"EPUB navigator preferences","titleInlineContent":[{"text":"EPUB navigator preferences","type":"text"}],"identifier":"Preferences.md","url":"Preferences.md","type":"link"},"../Migration%20Guide.md":{"title":"migration guide","type":"link","identifier":"..\/Migration%20Guide.md","titleInlineContent":[{"text":"migration guide","type":"text"}],"url":"..\/Migration%20Guide.md"},"doc://Readium/documentation/Readium/Navigator":{"abstract":[{"type":"text","text":"You can use a Readium Navigator to present the publication to the user. The "},{"type":"codeVoice","code":"Navigator"},{"type":"text","text":" renders resources on the screen and offers APIs and user interactions for navigating the contents."}],"title":"Navigator","role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Navigator","url":"\/documentation\/readium\/navigator"},"doc://Readium/documentation/Readium/Input":{"title":"Observing user input","kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Input","abstract":[{"type":"text","text":"In visual publications like EPUB or PDF, users can interact with the "},{"code":"VisualNavigator","type":"codeVoice"},{"type":"text","text":" instance using gestures, a keyboard, a mouse, a pencil, or a trackpad. When the publication does not override user input events, you may want to intercept them to trigger actions in your user interface. For example, you can turn pages or toggle the navigation bar on taps, or open a bookmarks screen when pressing the Command-Shift-D hotkey."}],"type":"topic","url":"\/documentation\/readium\/input","role":"article"},"doc://Readium/documentation/Readium/EPUB-Fonts":{"title":"Font families in the EPUB navigator","kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/EPUB-Fonts","abstract":[{"type":"text","text":"Readium allows users to customize the font family used to render a reflowable EPUB, by changing the "},{"type":"reference","identifier":"Preferences.md","isActive":true},{"type":"text","text":"."}],"url":"\/documentation\/readium\/epub-fonts","type":"topic","role":"article"},"doc://Readium/documentation/Readium/Migration-Guide":{"type":"topic","url":"\/documentation\/readium\/migration-guide","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","kind":"article","role":"article","title":"Migration Guide","abstract":[{"type":"text","text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file."}]}}}