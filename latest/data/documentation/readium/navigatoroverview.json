ce","identifier":"https:\/\/developer.apple.com\/documentation\/swiftui\/uiviewrepresentable"},{"type":"text","text":"."}],"type":"topic"},"../Migration%20Guide.md":{"title":"migration guide","identifier":"..\/Migration%20Guide.md","titleInlineContent":[{"text":"migration guide","type":"text"}],"url":"..\/Migration%20Guide.md","type":"link"},"doc://Readium/documentation/Readium/Search":{"abstract":[{"type":"text","text":"The Search API lets you look for a textual query in the content of a "},{"code":"Publication","type":"codeVoice"},{"type":"text","text":". EPUB and PDF publications are supported."}],"type":"topic","title":"Searching a publication","kind":"article","url":"\/documentation\/readium\/search","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","role":"article"},"doc://Readium/documentation/Readium/Input":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Input","abstract":[{"text":"In visual publications like EPUB or PDF, users can interact with the ","type":"text"},{"type":"codeVoice","code":"VisualNavigator"},{"text":" instance using gestures, a keyboard, a mouse, a pencil, or a trackpad. When the publication does not override user input events, you may want to intercept them to trigger actions in your user interface. For example, you can turn pages or toggle the navigation bar on taps, or open a bookmarks screen when pressing the Command-Shift-D hotkey.","type":"text"}],"role":"article","kind":"article","url":"\/documentation\/readium\/input","title":"Observing user input"},"https://www.w3.org/TR/epub-a11y-11":{"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","titleInlineContent":[{"text":"EPUB Accessibility","type":"text"}],"title":"EPUB Accessibility","url":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"link"},"doc://Readium/documentation/Readium/TTS":{"type":"topic","title":"Text-to-speech","abstract":[],"identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","kind":"article","role":"article","url":"\/docu