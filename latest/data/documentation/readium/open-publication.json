{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"To open a publication with Readium, you need to instantiate a couple of components: an ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" and a ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":".","type":"text"}],"metadata":{"title":"Opening a publication","role":"article","roleHeading":"Article"},"seeAlsoSections":[{"generated":true,"anchor":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"title":"Guides"}],"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"anchor":"AssetRetriever","level":2,"text":"`AssetRetriever`","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"code":"AssetRetriever","type":"codeVoice"},{"type":"text","text":" grants access to the content of an asset located at a given URL, such as a publication package, manifest, or LCP license."}],"type":"paragraph"},{"anchor":"Constructing-an-AssetRetriever","level":3,"text":"Constructing an `AssetRetriever`","type":"heading"},{"inlineContent":[{"text":"You can create an instance of ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":" with:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"code":"HTTPClient","type":"codeVoice"},{"text":" to enable the toolkit to perform HTTP requests and support the ","type":"text"},{"code":"http","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"https","type":"codeVoice"},{"text":" URL schemes. You can use ","type":"text"},{"code":"DefaultHTTPClient","type":"codeVoice"},{"text":" which provides callbacks for handling authentication when needed.","type":"text"}]}]}]},{"code":["let assetRetriever = AssetRetriever(httpClient: DefaultHTTPClient())"],"type":"codeListing","syntax":"swift"},{"anchor":"Retrieving-an-Asset","level":3,"text":"Retrieving an `Asset`","type":"heading"},{"inlineContent":[{"type":"text","text":"With your fresh instance of "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":", you can open an "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":" from any "},{"type":"codeVoice","code":"AbsoluteURL"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["\/\/ From a local file.","let url = FileURL(string: \"file:\/\/\/path\/to\/book.epub\")","\/\/ or from an HTTP URL.","let url = HTTPURL(string: \"https:\/\/domain\/book.epub\")","","switch await assetRetriever.retrieve(url: url) {","    case .success(let asset):","        ...","    case .failure(let error):","        \/\/ Failed to retrieve the asset.","}"],"type":"codeListing","syntax":"swift"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!IMPORTANT]"},{"type":"text","text":" "},{"type":"text","text":"Assets created with an HTTP URL are not downloaded; they will be streamed. If that is not your intention, you need to download the file first, for example using "},{"type":"codeVoice","code":"HTTPClient.download()"},{"type":"text","text":"."}]}],"type":"aside","style":"note","name":"Note"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" will sniff the media type of the asset, which you can store in your bookshelf database to speed up the process next time you retrieve the ","type":"text"},{"code":"Asset","type":"codeVoice"},{"text":". This will improve performance, especially with HTTP URL schemes.","type":"text"}],"type":"paragraph"},{"code":["let mediaType = asset.format.mediaType","","\/\/ Speed up the retrieval with a known media type.","let result = await assetRetriever.retrieve(url: url, mediaType: mediaType)"],"type":"codeListing","syntax":"swift"},{"anchor":"PublicationOpener","level":2,"text":"`PublicationOpener`","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":" builds a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" object from an "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":" using:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"code":"PublicationParser","type":"codeVoice"},{"text":" to parse the asset structure and publication metadata.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"DefaultPublicationParser"},{"type":"text","text":" handles all the formats supported by Readium out of the box."}]}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional list of "},{"code":"ContentProtection","type":"codeVoice"},{"type":"text","text":" to decrypt DRM-protected publications."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"If you support Readium LCP, you can get one from the ","type":"text"},{"type":"codeVoice","code":"LCPService"},{"text":".","type":"text"}]}]}]}]}]},{"code":["let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever,","        pdfFactory: DefaultPDFDocumentFactory()","    ),","    contentProtections: [","        lcpService.contentProtection(with: LCPDialogAuthentication())","    ]",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Opening-a-Publication","level":3,"text":"Opening a `Publication`","type":"heading"},{"inlineContent":[{"type":"text","text":"Now that you have a "},{"code":"PublicationOpener","type":"codeVoice"},{"type":"text","text":" ready, you can use it to create a "},{"code":"Publication","type":"codeVoice"},{"type":"text","text":" from an "},{"code":"Asset","type":"codeVoice"},{"type":"text","text":" that was previously obtained using the "},{"code":"AssetRetriever","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" parameter is useful when supporting Readium LCP. When enabled and using a "},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"type":"text","text":", the toolkit will prompt the user if the passphrase is missing."}],"type":"paragraph"},{"code":["let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    sender: sender",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Supporting-additional-formats-or-URL-schemes","level":2,"text":"Supporting additional formats or URL schemes","type":"heading"},{"inlineContent":[{"code":"DefaultPublicationParser","type":"codeVoice"},{"text":" accepts additional parsers. You also have the option to use your own parser list by using ","type":"text"},{"code":"CompositePublicationParser","type":"codeVoice"},{"text":" or create your own ","type":"text"},{"code":"PublicationParser","type":"codeVoice"},{"text":" for a fully customized parsing resolution strategy.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":" offers an additional constructor that provides greater extensibility options, using:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"ResourceFactory","type":"codeVoice"},{"text":" which handles the URL schemes through which you can access content.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"ArchiveOpener","type":"codeVoice"},{"text":" which determines the types of archives (ZIP, RAR, etc.) that can be opened by the ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"FormatSniffer","type":"codeVoice"},{"type":"text","text":" which identifies the file formats that "},{"code":"AssetRetriever","type":"codeVoice"},{"type":"text","text":" can recognize."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"You can use either the default implementations or implement your own for each of these components using the composite pattern. The toolkit’s ","type":"text"},{"code":"CompositeResourceFactory","type":"codeVoice"},{"text":", ","type":"text"},{"code":"CompositeArchiveOpener","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"CompositeFormatSniffer","type":"codeVoice"},{"text":" provide a simple resolution strategy.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://Readium/documentation/Readium/Migration-Guide":{"role":"article","type":"topic","title":"Migration Guide","kind":"article","abstract":[{"type":"text","text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file."}],"url":"\/documentation\/readium\/migration-guide","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide"},"doc://Readium/documentation/Readium/NavigatorOverview":{"type":"topic","url":"\/documentation\/readium\/navigatoroverview","abstract":[{"type":"text","text":"Learn about the architecture, configuration, and usage of the Readium Navigator."}],"role":"article","title":"Navigator Overview","kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview"},"doc://Readium/documentation/Readium/Accessibility":{"url":"\/documentation\/readium\/accessibility","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","abstract":[{"type":"text","text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the "},{"type":"reference","isActive":true,"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11"},{"type":"text","text":" specification."}],"kind":"article","title":"Accessibility","type":"topic"},"https://www.edrlab.org/readium-lcp/":{"type":"link","titleInlineContent":[{"type":"text","text":"Readium LCP"}],"url":"https:\/\/www.edrlab.org\/readium-lcp\/","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","title":"Readium LCP"},"doc://Readium/documentation/Readium":{"title":"Readium","abstract":[{"text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin.","type":"text"}],"kind":"article","type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium","role":"collection","url":"\/documentation\/readium"},"doc://Readium/documentation/Readium/Readium-LCP":{"role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","kind":"article","abstract":[{"text":"You can use the Readium Swift toolkit to download and read publications that are protected with the ","type":"text"},{"isActive":true,"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","type":"reference"},{"text":" DRM.","type":"text"}],"title":"Supporting Readium LCP","url":"\/documentation\/readium\/readium-lcp","type":"topic"},"doc://Readium/documentation/Readium/TTS":{"type":"topic","url":"\/documentation\/readium\/tts","identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","abstract":[],"kind":"article","role":"article","title":"Text-to-speech"},"doc://Readium/documentation/Readium/Getting-Started":{"title":"Getting started","abstract":[{"type":"text","text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics."}],"role":"article","kind":"article","type":"topic","url":"\/documentation\/readium\/getting-started","identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started"},"https://www.w3.org/TR/epub-a11y-11":{"title":"EPUB Accessibility","type":"link","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","titleInlineContent":[{"type":"text","text":"EPUB Accessibility"}],"url":"https:\/\/www.w3.org\/TR\/epub-a11y-11"},"doc://Readium/documentation/Readium/Search":{"abstract":[{"type":"text","text":"The Search API lets you look for a textual query in the content of a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":". EPUB and PDF publications are supported."}],"url":"\/documentation\/readium\/search","kind":"article","title":"Searching a publication","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","type":"topic","role":"article"},"doc://Readium/documentation/Readium/Content":{"type":"topic","abstract":[],"url":"\/documentation\/readium\/content","role":"article","title":"Extracting the content of a publication","kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Content"}}}