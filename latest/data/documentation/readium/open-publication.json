},{"type":"paragraph","inlineContent":[{"code":"PublicationOpener","type":"codeVoice"},{"text":" builds a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" object from an ","type":"text"},{"code":"Asset","type":"codeVoice"},{"text":" using:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"PublicationParser"},{"text":" to parse the asset structure and publication metadata.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"DefaultPublicationParser"},{"type":"text","text":" handles all the formats supported by Readium out of the box."}]}]}]}]},{"content":[{"inlineContent":[{"text":"An optional list of ","type":"text"},{"code":"ContentProtection","type":"codeVoice"},{"text":" to decrypt DRM-protected publications.","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"If you support Readium LCP, you can get one from the ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]}]}],"type":"unorderedList"},{"type":"codeListing","code":["let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever,","        pdfFactory: DefaultPDFDocumentFactory()","    ),","    contentProtections: [","        lcpService.contentProtection(with: LCPDialogAuthentication())","    ]",")"],"syntax":"swift"},{"type":"heading","text":"Opening a `Publication`","anchor":"Opening-a-Publication","level":3},{"type":"paragraph","inlineContent":[{"text":"Now that you have a ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":" ready, you can use it to create a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" from an ","type":"text"},{"code":"Asset","type":"codeVoice"},{"text":" that was previously obtained using the ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" parameter is useful when supporting Readium LCP. When enabled and using a "},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"type":"text","text":", the toolkit will prompt the user if the passphrase is missing."}]},{"type":"codeListing","code":["let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    sender: sender",")"],"syntax":"swift"},{"type":"heading","text":"Supporting additional formats or URL schemes","anchor":"Supporting-additional-formats-or-URL-schemes","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DefaultPublicationParser"},{"type":"text","text":" accepts additional parsers. You also have the option to use your own parser list by using "},{"type":"codeVoice","code":"CompositePublicationParser"},{"type":"text","text":" or create your own "},{"type":"codeVoice","code":"PublicationParser"},{"type":"text","text":" for a fully customized parsing resolution strategy."}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":" offers an additional constructor that provides greater extensibility options, using:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"ResourceFactory"},{"type":"text","text":" which handles the URL schemes through which you can access content."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ArchiveOpener"},{"type":"text","text":" which determines the types of archives (ZIP, RAR, etc.) that can be opened by the "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":"."}]}]},{"content":[{"inlineConten