ext","text":"presence of videos and if closed captions, open captions, or transcripts"},{"type":"text","text":" "},{"type":"text","text":"for prerecorded audio are available."}]},"doc://Readium/documentation/ReadiumShared/AccessibilityMetadataDisplayGuide":{"url":"\/documentation\/readiumshared\/accessibilitymetadatadisplayguide","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AccessibilityMetadataDisplayGuide"}],"role":"symbol","title":"AccessibilityMetadataDisplayGuide","navigatorTitle":[{"kind":"identifier","text":"AccessibilityMetadataDisplayGuide"}],"abstract":[{"type":"text","text":"When presenting accessibility metadata provided by the publisher, it is"},{"type":"text","text":" "},{"type":"text","text":"suggested that the section is introduced using terms such as “claims” or"},{"type":"text","text":" "},{"type":"text","text":"“declarations” (e.g., “Accessibility Claims”)."}],"kind":"symbol","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide"}}}