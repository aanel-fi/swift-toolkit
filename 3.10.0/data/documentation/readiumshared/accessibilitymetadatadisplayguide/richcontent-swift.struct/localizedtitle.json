://Readium/documentation/ReadiumShared/AccessibilityMetadataDisplayGuide/RichContent-swift.struct/localizedTitle":{"type":"topic","title":"localizedTitle","url":"\/documentation\/readiumshared\/accessibilitymetadatadisplayguide\/richcontent-swift.struct\/localizedtitle","role":"symbol","abstract":[{"text":"Localized title for this display field, for example to use as a","type":"text"},{"text":" ","type":"text"},{"text":"section header.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"localizedTitle","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"kind":"symbol","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide\/RichContent-swift.struct\/localizedTitle"},"doc://Readium/documentation/ReadiumShared/AccessibilityMetadataDisplayGuide":{"url":"\/documentation\/readiumshared\/accessibilitymetadatadisplayguide","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AccessibilityMetadataDisplayGuide"}],"role":"symbol","title":"AccessibilityMetadataDisplayGuide","navigatorTitle":[{"kind":"identifier","text":"AccessibilityMetadataDisplayGuide"}],"abstract":[{"type":"text","text":"When presenting accessibility metadata provided by the publisher, it is"},{"type":"text","text":" "},{"type":"text","text":"suggested that the section is introduced using terms such as “claims” or"},{"type":"text","text":" "},{"type":"text","text":"“declarations” (e.g., “Accessibility Claims”)."}],"kind":"symbol","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide"},"doc://Readium/documentation/ReadiumShared/AccessibilityMetadataDisplayGuide/RichContent-swift.struct":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RichContent","kind":"identifier"}],"role":"symbol","type":"topic","identifier":"doc: