[{"type":"text","text":"When presenting accessibility metadata provided by the publisher, it is"},{"type":"text","text":" "},{"type":"text","text":"suggested that the section is introduced using terms such as “claims” or"},{"type":"text","text":" "},{"type":"text","text":"“declarations” (e.g., “Accessibility Claims”)."}],"kind":"symbol","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide"},"doc://Readium/documentation/ReadiumShared":{"title":"ReadiumShared","abstract":[],"type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/readiumshared","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared"},"doc://Readium/documentation/ReadiumShared/AccessibilityMetadataDisplayGuide/RichContent-swift.struct/transcript":{"title":"transcript","kind":"symbol","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide\/RichContent-swift.struct\/transcript","abstract":[{"type":"text","text":"Transcript(s) provided."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transcript","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"type":"topic","url":"\/documentation\/readiumshared\/accessibilitymetadatadisplayguide\/richcontent-swift.struct\/transcript","role":"symbol"},"doc://Readium/documentation/ReadiumShared/AccessibilityMetadataDisplayGuide/RichContent-swift.struct":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RichContent","kind":"identifier"}],"role":"symbol","type":"topic","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide\/RichContent-swift.struct","url":"\/documentation\/readiumshared\/accessibilitymetadatadisplayguide\/richcontent-swift.struct","navigatorTitle":[{"text":"RichContent","kind":"identifier"}],"kind":"symbol","title":"AccessibilityMetadataDisplayGuide.RichContent","abstract":[{"type":"text","text":"Indicates the presence of math, chemical formulas, extended descriptions"},{"type":"text","text":" "},{"type":"text","text":"for information rich images, e.g., charts, diagrams, figures, graphs,"},{"type":"text","text":" "},{"type":"text","text":"and whether these are in an accessible format or available in an"},{"type":"text","text":" "},{"type":"text","text":"alternative form, e.g., whether math and chemical formulas are navigable"},{"type":"text","text":" "},{"type":"text","text":"with assistive technologies, or whether extended descriptions are"},{"type":"text","text":" "},{"type":"text","text":"available for information-rich images. In addition, it indicates the"},{"type":"text","text":" "},{"type":"text","text":"presence of videos and if closed captions, open captions, or transcripts"},{"type":"text","text":" "},{"type":"text","text":"for prerecorded audio are available."}]}}}