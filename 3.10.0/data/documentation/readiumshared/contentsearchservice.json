{"metadata":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ContentSearchService","kind":"identifier"}],"roleHeading":"Class","symbolKind":"class","title":"ContentSearchService","modules":[{"name":"ReadiumShared"}],"role":"symbol","externalID":"s:13ReadiumShared20ContentSearchServiceC","navigatorTitle":[{"text":"ContentSearchService","kind":"identifier"}]},"abstract":[{"text":"Implementation of ","type":"text"},{"code":"SearchService","type":"codeVoice"},{"text":" using the Content API (","type":"text"},{"code":"ContentService","type":"codeVoice"},{"text":").","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContentSearchService"}],"platforms":["iOS"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"It supports cross-element matching within the same resource via a"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"sliding window","type":"text"}]},{"type":"text","text":" over the resource’s concatenated element texts. The window"},{"type":"text","text":" "},{"type":"text","text":"maintains a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"danger zone"}]},{"type":"text","text":" (last "},{"type":"emphasis","inlineContent":[{"text":"T","type":"text"}]},{"type":"text","text":" characters) where matches are deferred"},{"type":"text","text":" "},{"type":"text","text":"to the next iteration, enabling queries that span element boundaries (e.g.,"},{"type":"text","text":" "},{"type":"codeVoice","code":"<p>The quick<\/p><p>brown fox.<\/p>"},{"type":"text","text":" matches “quick brown”)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Cross-resource matching is intentionally not supported (the window is"},{"type":"text","text":" "},{"type":"text","text":"flushed at every resource boundary)."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Regex limitation:"}]},{"type":"text","text":" for variable-length or greedy patterns the danger-zone"},{"type":"text","text":" "},{"type":"text","text":"heuristic (last 256 chars) is an approximation. A greedy pattern that starts"},{"type":"text","text":" "},{"type":"text","text":"before the danger zone but could extend further into the next element may be"},{"type":"text","text":" "},{"type":"text","text":"emitted prematurely, with a shorter-than-optimal match. Plain-text queries"},{"type":"text","text":" "},{"type":"text","text":"are not affected by this limitation."}],"type":"paragraph"},{"inlineContent":[{"text":"This service requires the publication to have a configured ","type":"text"},{"type":"codeVoice","code":"ContentService"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","variants":[{"paths":["\/documentation\/readiumshared\/contentsearchservice"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Readium\/documentation\/ReadiumShared\/ContentSearchService","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"generated":true,"identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/ContentSearchService\/init(publication:language:snippetLength:searchAlgorithm:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/ContentSearchService\/options"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/ContentSearchService\/search(query:options:)"],"anchor":"Instance-Methods","title":"Instance Methods"},{"generated":true,"identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/ContentSearchService\/makeFactory(snippetLength:searchAlgorithm:)"],"anchor":"Type-Method