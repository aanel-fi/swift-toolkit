{"kind":"article","identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Content","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"name":"Note","type":"aside","content":[{"inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"text":"The described feature is still experimental and the implementation incomplete.","type":"text"}],"type":"paragraph"}],"style":"note"},{"inlineContent":[{"text":"Many high-level features require access to the raw content (text, media, etc.) of a publication, such as:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Text-to-speech"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Accessibility reader"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Basic search"}]}]},{"content":[{"inlineContent":[{"text":"Full-text search indexing","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Image or audio indexes"}]}]}]},{"inlineContent":[{"type":"text","text":"The "},{"code":"ContentService","type":"codeVoice"},{"type":"text","text":" provides a way to iterate through a publication’s content, extracted as semantic elements."}],"type":"paragraph"},{"inlineContent":[{"text":"First, request the publication’s ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":", starting from a given ","type":"text"},{"code":"Locator","type":"codeVoice"},{"text":". If the locator is missing, the ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":" will be extracted from the beginning of the publication.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["guard let content = publication.content(from: startLocator) else {","    \/\/ Abort as the content cannot be extracted","    return","}"]},{"type":"heading","level":2,"anchor":"Extracting-the-raw-text-content","text":"Extracting the raw text content"},{"inlineContent":[{"text":"Getting the whole raw text of a publication is such a common use case that a helper is available on ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let wholeText = content.text()"]},{"inlineContent":[{"text":"This is an expensive operation, proceed with caution and cache the result if you need to reuse it.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Iterating-through-the-content","text":"Iterating through the content"},{"inlineContent":[{"text":"The individual ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":" elements can be iterated through with a regular ","type":"text"},{"code":"for","type":"codeVoice"},{"text":" loop by converting it to a sequence:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["for element in content.sequence() {","    \/\/ Process element","}"]},{"inlineContent":[{"text":"Alternatively, you can get the whole list of elements with ","type":"text"},{"code":"content.elements()","type":"codeVoice"},{"text":", or use the lower level APIs to iterate the content manually:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let iterator = content.iterator()","while let element = try iterator.next() {","    print(element)","}"]},{"inlineContent":[{"type":"text","text":"Some "},{"type":"codeVoice","code":"Content"},{"type":"text","text":" implementations support bidirectional iterations. To iterate backwards, use:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let iterator = content.iterator()","while let element = try iterator.previous() {","    print(element)","}"]},{"type":"heading","level":2,"anchor":"Processing-the-elements","text":"Processing the elements"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"Content"},{"text":" iterator yields ","type":"text"},{"type":"codeVoice","code":"ContentElement"},{"text":" objects representing a single semantic portion of the publication, such as a heading, a paragraph or an embedded image.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Every element has a ","type":"text"},{"code":"locator","type":"codeVoice"},{"text":" property targeting it in the publication. You can use the locator, for example, to navigate to the element or to draw a ","type":"text"},{"code":"Decoration","type":"codeVoice"},{"text":" on top of it.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["navigator.go(to: element.locator)"]},{"type":"heading","level":3,"anchor":"Types-of-elements","text":"Types of elements"},{"inlineContent":[{"text":"Depending on the actual implementation of ","type":"text"},{"code":"ContentElement","type":"codeVoice"},{"text":", more properties are available to access the actual data. The toolkit ships with a number of default implementations for common types of elements.","type":"text"}],"type":"paragraph"},{"type":"heading","level":4,"anchor":"Embedded-media","text":"Embedded media"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"EmbeddedContentElement","type":"codeVoice"},{"text":" protocol is implemented by any element referencing an external resource. It contains an ","type":"text"},{"code":"embeddedLink","type":"codeVoice"},{"text":" property you can use to get the actual content of the resource.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["if let element = element as? EmbeddedContentElement {","    let bytes = try publication","        .get(element.embeddedLink)","        .read().get()","}"]},{"inlineContent":[{"text":"Here are the default available implementations:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"AudioContentElement","type":"codeVoice"},{"text":" - audio clips","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"VideoContentElement"},{"text":" - video clips","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ImageContentElement","type":"codeVoice"},{"text":" - bitmap images, with the additional property:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"caption: String?"},{"type":"text","text":" - figure caption, when available"}]}]}]}]}]},{"type":"heading","level":4,"anchor":"Text","text":"Text"},{"type":"heading","level":5,"anchor":"Textual-elements","text":"Textual elements"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"TextualContentElement"},{"type":"text","text":" protocol is implemented by any element which can be represented as human-readable text. This is useful when you want to extract the text content of a publication without caring for each individual type of elements."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let wholeText = publication.content()","    .elements()","    .compactMap { ($0 as? TextualContentElement)?.text.takeIf { !$0.isEmpty } }","    .joined(separator: \"\\n\")"]},{"type":"heading","level":5,"anchor":"Text-elements","text":"Text elements"},{"inlineContent":[{"type":"text","text":"Actual text elements are instances of "},{"code":"TextContentElement","type":"codeVoice"},{"type":"text","text":", which represent a single block of text such as a heading, a paragraph or a list item. It is comprised of a "},{"code":"role","type":"codeVoice"},{"type":"text","text":" and a list of "},{"code":"segments","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"code":"role","type":"codeVoice"},{"type":"text","text":" is the nature of the text element in the document. For example a heading, body, footnote or a quote. It can be used to reconstruct part of the structure of the original document."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A text element is composed of individual segments with their own "},{"type":"codeVoice","code":"locator"},{"type":"text","text":" and "},{"type":"codeVoice","code":"attributes"},{"type":"text","text":". They are useful to associate attributes with a portion of a text element. For example, given the HTML paragraph:"}],"type":"paragraph"},{"type":"codeListing","syntax":"html","code":["<p>It is pronounced <span lang=\"fr\">croissant<\/span>.<\/p>"]},{"inlineContent":[{"type":"text","text":"The following "},{"type":"codeVoice","code":"TextContentElement"},{"type":"text","text":" will be produced:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["TextContentElement(","    role: .body,","    segments: [","        TextContentElement.Segment(text: \"It is pronounced \"),","        TextContentElement.Segment(text: \"croissant\", attributes: [ContentAttribute(key: .language, value: \"fr\")]),","        TextContentElement.Segment(text: \".\")","    ]",")"]},{"inlineContent":[{"text":"If you are not interested in the segment attributes, you can also use ","type":"text"},{"code":"element.text","type":"codeVoice"},{"text":" to get the concatenated raw text.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"Element-attributes","text":"Element attributes"},{"inlineContent":[{"type":"text","text":"All types of "},{"type":"codeVoice","code":"ContentElement"},{"type":"text","text":" can have associated attributes. Custom "},{"type":"codeVoice","code":"ContentService"},{"type":"text","text":" implementations can use this as an extensibility point."}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Use-cases","text":"Use cases"},{"type":"heading","level":3,"anchor":"An-index-of-all-images-embedded-in-the-publication","text":"An index of all images embedded in the publication"},{"inlineContent":[{"type":"text","text":"This example extracts all the embedded images in the publication and displays them in a SwiftUI list. Clicking on an image jumps to its location in the publication."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct ImageIndex: View {","    struct Item: Hashable {","        let locator: Locator","        let text: String?","        let image: UIImage","    }","","    let publication: Publication","    let navigator: Navigator","    @State private var items: [Item] = []","","    init(publication: Publication, navigator: Navigator) {","        self.publication = publication","        self.navigator = navigator","    }","","    var body: some View {","        ScrollView {","            LazyVStack {","                ForEach(items, id: \\.self) { item in","                    VStack() {","                        Image(uiImage: item.image)","                        Text(item.text ?? \"No caption\")","                    }","                    .onTapGesture {","                        navigator.go(to: item.locator)","                    }","                }","            }","        }","        .onAppear {","            items = publication.content()?","                .elements()","                .compactMap { element in","                    guard","                        let element = element as? ImageContentElement,","                        let image = try? publication.get(element.embeddedLink)","                            .read().map(UIImage.init).get()","                    else {","                        return nil","                    }","","                    return Item(","                        locator: element.locator,","                        text: element.caption ?? element.accessibilityLabel,","                        image: image","                    )","                }","                ?? []","        }","    }","}"]},{"type":"heading","level":2,"anchor":"References","text":"References"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177","type":"reference","isActive":true}],"type":"paragraph"}]}]}]}],"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"anchor":"Guides","generated":true}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"title":"Extracting the content of a publication","roleHeading":"Article","role":"article"},"sections":[],"references":{"https://github.com/readium/architecture/pull/177":{"type":"link","identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177","title":"Content Iterator proposal","titleInlineContent":[{"type":"text","text":"Content Iterator proposal"}],"url":"https:\/\/github.com\/readium\/architecture\/pull\/177"},"doc://Readium/documentation/Readium/NavigatorOverview":{"url":"\/documentation\/readium\/navigatoroverview","kind":"article","role":"article","type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","title":"Navigator Overview","abstract":[{"type":"text","text":"Learn about the architecture, configuration, and usage of the Readium Navigator."}]},"doc://Readium/documentation/Readium":{"type":"topic","role":"collection","abstract":[{"type":"text","text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin."}],"identifier":"doc:\/\/Readium\/documentation\/Readium","url":"\/documentation\/readium","kind":"article","title":"Readium"},"doc://Readium/documentation/Readium/Getting-Started":{"role":"article","type":"topic","url":"\/documentation\/readium\/getting-started","title":"Getting started","abstract":[{"text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics.","type":"text"}],"kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started"},"doc://Readium/documentation/Readium/Accessibility":{"abstract":[{"text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the ","type":"text"},{"isActive":true,"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"reference"},{"text":" specification.","type":"text"}],"type":"topic","kind":"article","title":"Accessibility","role":"article","url":"\/documentation\/readium\/accessibility","identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility"},"doc://Readium/documentation/Readium/Readium-LCP":{"title":"Supporting Readium LCP","type":"topic","kind":"article","url":"\/documentation\/readium\/readium-lcp","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","abstract":[{"text":"You can use the Readium Swift toolkit to download and read publications that are protected with the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/"},{"text":" DRM.","type":"text"}]},"doc://Readium/documentation/Readium/Migration-Guide":{"abstract":[{"text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file.","type":"text"}],"url":"\/documentation\/readium\/migration-guide","role":"article","kind":"article","title":"Migration Guide","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","type":"topic"},"doc://Readium/documentation/Readium/Search":{"kind":"article","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","abstract":[{"text":"The Search API lets you look for a textual query in the content of a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":". EPUB and PDF publications are supported.","type":"text"}],"title":"Searching a publication","url":"\/documentation\/readium\/search","type":"topic"},"https://www.w3.org/TR/epub-a11y-11":{"type":"link","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","title":"EPUB Accessibility","titleInlineContent":[{"type":"text","text":"EPUB Accessibility"}],"url":"https:\/\/www.w3.org\/TR\/epub-a11y-11"},"doc://Readium/documentation/Readium/TTS":{"abstract":[],"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","kind":"article","url":"\/documentation\/readium\/tts","title":"Text-to-speech","role":"article"},"doc://Readium/documentation/Readium/Open-Publication":{"type":"topic","title":"Opening a publication","role":"article","abstract":[{"type":"text","text":"To open a publication with Readium, you need to instantiate a couple of components: an "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":"."}],"identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","url":"\/documentation\/readium\/open-publication","kind":"article"},"https://www.edrlab.org/readium-lcp/":{"type":"link","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","title":"Readium LCP","titleInlineContent":[{"type":"text","text":"Readium LCP"}],"url":"https:\/\/www.edrlab.org\/readium-lcp\/"}}}