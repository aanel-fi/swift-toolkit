{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Search","interfaceLanguage":"swift"},"kind":"article","metadata":{"roleHeading":"Article","role":"article","title":"Searching a publication"},"primaryContentSections":[{"content":[{"level":2,"text":"Checking if a publication is searchable","anchor":"Checking-if-a-publication-is-searchable","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Not every publication has a search service attached. Check "},{"inlineContent":[{"code":"isSearchable","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" before offering a search UI."}]},{"syntax":"swift","type":"codeListing","code":["guard publication.isSearchable else {","    \/\/ Hide or disable the search UI.","    return","}"]},{"level":2,"text":"Performing a search","anchor":"Performing-a-search","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"publication.search(query:options:)"}]},{"type":"text","text":" to start a new search. This method returns a "},{"type":"strong","inlineContent":[{"code":"SearchResult<SearchIterator>","type":"codeVoice"}]},{"type":"text","text":" — either a cursor to page through results, or a "},{"type":"strong","inlineContent":[{"code":"SearchError","type":"codeVoice"}]},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["let result = await publication.search(query: \"red panda\")","","switch result {","case .success(let iterator):","    \/\/ Use the iterator to page through results.","case .failure(let error):","    handleSearchError(error)","}"]},{"level":2,"text":"Iterating through results","anchor":"Iterating-through-results","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"SearchIterator"}]},{"text":" is a cursor that fetches results one page at a time. Each page is a ","type":"text"},{"type":"strong","inlineContent":[{"code":"LocatorCollection","type":"codeVoice"}]},{"text":" containing an array of ","type":"text"},{"type":"strong","inlineContent":[{"code":"Locator","type":"codeVoice"}]},{"text":" values, one per match.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"iterator.next()"}]},{"type":"text","text":" to retrieve the next page. It returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" on success when all results have been exhausted, or "},{"type":"codeVoice","code":".failure"},{"type":"text","text":" if a read error occurs."}]},{"syntax":"swift","type":"codeListing","code":["while let page = try await iterator.next().get() {","    for locator in page.locators {","        print(\"Found result at: \\(locator.href)\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To navigate directly to a result, pass the locator to the Navigator:"}]},{"syntax":"swift","type":"codeListing","code":["await navigator.go(to: locator)"]},{"level":3,"text":"Pagination strategies","anchor":"Pagination-strategies","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Results may arrive in pages to progressively load results. In practice there are two common approaches:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Background load:"}]},{"text":" start a ","type":"text"},{"type":"codeVoice","code":"Task"},{"text":" that accumulates every result progressively. Simple to implement; the full list updates every time a new page is fetched.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"On-scroll load:","type":"text"}]},{"type":"text","text":" hold onto the iterator and call "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" only when the user scrolls to the bottom of the current batch. This keeps memory and CPU usage low, at the cost of slightly more state management."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"Grouping results by section","anchor":"Grouping-results-by-section","type":"heading"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"locator.title"}],"type":"strong"},{"text":" is the title of the table of contents entry that contains the match — for example, a chapter or section title. Use it to group consecutive results that fall within the same entry:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var sections: [(title: String?, locators: [Locator])] = []","for locator in page.locators {","    if locator.title == sections.last?.title {","        sections[sections.count - 1].locators.append(locator)","    } else {","        sections.append((title: locator.title, locators: [locator]))","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This preserves order and keeps sections with the same title distinct when they are not consecutive."}]},{"level":3,"text":"Displaying a result snippet","anchor":"Displaying-a-result-snippet","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"locator.text"}]},{"type":"text","text":" contains the matched text and its surrounding context:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"highlight","type":"codeVoice"},{"text":" — the exact string that matched the query.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"before"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"after"},{"type":"text","text":" — a short snippet of text on either side of the match."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Here is a SwiftUI view that renders a single result with the matched text in bold:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct SearchResultRow: View {","    let locator: Locator","","    var body: some View {","        Text(snippet)","    }","","    private var snippet: AttributedString {","        var result = AttributedString()","        if let before = locator.text?.before {","            result += AttributedString(before)","        }","        if let highlight = locator.text?.highlight {","            var bold = AttributedString(highlight)","            bold.font = .body.bold()","            result += bold","        }","        if let after = locator.text?.after {","            result += AttributedString(after)","        }","        return result","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"In a real UI you will typically want to truncate ","type":"text"},{"type":"codeVoice","code":"before"},{"type":"text","text":" and "},{"type":"codeVoice","code":"after"},{"type":"text","text":" so the UI stays compact."}]},{"level":2,"text":"Search options","anchor":"Search-options","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Pass a ","type":"text"},{"inlineContent":[{"code":"SearchOptions","type":"codeVoice"}],"type":"strong"},{"text":" value to ","type":"text"},{"code":"search(query:options:)","type":"codeVoice"},{"text":" to override the defaults. Any option you leave as ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" falls back to the default behavior.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let result = await publication.search(","    query: \"Red Panda\",","    options: SearchOptions(","        caseSensitive: true,","        diacriticSensitive: false","    )",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The full set of available options:"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Option"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Built-in","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"caseSensitive"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Bool?","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", the search distinguishes upper- and lower-case letters.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"diacriticSensitive"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Bool?","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", accented and unaccented letters are treated as distinct."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"wholeWord","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Bool?"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"No"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", only complete words are matched, not substrings.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"exact"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Bool?"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", the query is matched exactly, including stop words and word order.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"language","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Language?"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Overrides the publication’s language for this search.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"regularExpression","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Bool?","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", the query is interpreted as a regular expression."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"otherOptions"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"[String: String]"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"–"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Custom options specific to the search service implementation.","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"inlineContent":[{"type":"text","text":"Built-in"}],"type":"strong"},{"text":" column indicates whether the default Readium configuration handles the option. Options marked ","type":"text"},{"inlineContent":[{"type":"text","text":"No"}],"type":"strong"},{"text":" are silently ignored unless you provide a custom algorithm that implements them.","type":"text"}]},{"level":3,"text":"Supported options","anchor":"Supported-options","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Before displaying search-option controls – e.g. a case sensitivity toggle, or regex mode – inspect ","type":"text"},{"inlineContent":[{"code":"publication.searchOptions","type":"codeVoice"}],"type":"strong"},{"text":" to learn which options the service actually supports. An option whose value is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" is ","type":"text"},{"inlineContent":[{"type":"text","text":"not supported"}],"type":"strong"},{"text":" by the current service; do not show it in the UI. The actual value indicates the default behavior when the option is not overridden.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let options = publication.searchOptions","","\/\/ Only show the case-sensitivity toggle if the service supports it.","if let caseSensitive = options.caseSensitive {","    showCaseSensitiveToggle(defaultValue: caseSensitive)","}"]},{"level":2,"text":"Error handling","anchor":"Error-handling","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"SearchError","type":"codeVoice"}]},{"type":"text","text":" describes what can go wrong:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".publicationNotSearchable"}]},{"type":"text","text":" – The publication has no search service. Guard on "},{"code":"isSearchable","type":"codeVoice"},{"type":"text","text":" first."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".badQuery(Error)","type":"codeVoice"}],"type":"strong"},{"text":" – The query string is invalid. Not all implementations produce this; custom services may use it to signal a malformed query (for example, an invalid regular expression).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".reading(ReadError)","type":"codeVoice"}]},{"type":"text","text":" – An I\/O error occurred while reading a resource."}]}]}],"type":"unorderedList"},{"syntax":"swift","type":"codeListing","code":["switch searchError {","case .publicationNotSearchable:","    break \/\/ Should not happen if you check isSearchable first.","case .badQuery(let error):","    showAlert(\"Invalid query\")","case .reading(let error):","    showAlert(\"Failed to read the publication resources\")","}"]},{"level":2,"text":"Advanced customization","anchor":"Advanced-customization","type":"heading"},{"level":3,"text":"Configuring the search service","anchor":"Configuring-the-search-service","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default parsers automatically register "},{"type":"strong","inlineContent":[{"code":"ContentSearchService","type":"codeVoice"}]},{"type":"text","text":" for EPUB and PDF publications, which relies on the "},{"identifier":"Content.md","type":"reference","isActive":true},{"type":"text","text":" to inspect the publication content. You do not need to do anything for the default behavior."}]},{"type":"paragraph","inlineContent":[{"text":"To customize the default service — for example, to adjust the snippet length or plug in a different search algorithm — override it in the ","type":"text"},{"code":"onCreatePublication","type":"codeVoice"},{"text":" callback when opening a publication:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    onCreatePublication: { _, _, services in","        services.setSearchServiceFactory(","            ContentSearchService.makeFactory(","                snippetLength: 300,","                searchAlgorithm: BasicStringSearchAlgorithm()","            )","        )","    }",")"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"snippetLength"},{"text":" parameter controls how many characters of context are included in the ","type":"text"},{"type":"codeVoice","code":"before"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"after"},{"text":" text of each result’s ","type":"text"},{"type":"strong","inlineContent":[{"code":"Locator.Text","type":"codeVoice"}]},{"text":".","type":"text"}]},{"style":"note","type":"aside","name":"Note","content":[{"inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ContentSearchService"},{"text":" depends on a ","type":"text"},{"type":"codeVoice","code":"ContentService"},{"text":" being registered for the publication. This is set up automatically by the default parsers.","type":"text"}],"type":"paragraph"}]},{"level":3,"text":"Implementing a custom search algorithm","anchor":"Implementing-a-custom-search-algorithm","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The actual text-matching logic is separated into the ","type":"text"},{"inlineContent":[{"code":"StringSearchAlgorithm","type":"codeVoice"}],"type":"strong"},{"text":" protocol. You can swap it out without changing anything else about the service.","type":"text"}]},{"inlineContent":[{"type":"strong","inlineContent":[{"code":"BasicStringSearchAlgorithm","type":"codeVoice"}]},{"type":"text","text":" is the built-in implementation. It uses the native "},{"code":"String.range(of:options:)","type":"codeVoice"},{"type":"text","text":" APIs and supports "},{"code":"caseSensitive","type":"codeVoice"},{"type":"text","text":", "},{"code":"diacriticSensitive","type":"codeVoice"},{"type":"text","text":", "},{"code":"exact","type":"codeVoice"},{"type":"text","text":", and "},{"code":"regularExpression","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To use a custom algorithm, pass it to "},{"type":"codeVoice","code":"ContentSearchService.makeFactory"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["ContentSearchService.makeFactory(searchAlgorithm: MyFuzzySearchAlgorithm())"],"type":"codeListing"}],"kind":"content"}],"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readi