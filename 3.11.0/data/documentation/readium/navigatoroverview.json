esentable","type":"reference"},{"type":"text","text":"."}],"url":"\/documentation\/readium\/swiftui","type":"topic","title":"Integrating the Navigator with SwiftUI","identifier":"doc:\/\/Readium\/documentation\/Readium\/SwiftUI","kind":"article","role":"article"},"doc://Readium/documentation/Readium/Migration-Guide":{"kind":"article","abstract":[{"text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file.","type":"text"}],"role":"article","type":"topic","title":"Migration Guide","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","url":"\/documentation\/readium\/migration-guide"},"doc://Readium/documentation/Readium/Readium-LCP":{"abstract":[{"text":"You can use the Readium Swift toolkit to download and read publications that are protected with the ","type":"text"},{"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","isActive":true,"type":"reference"},{"text":" DRM.","type":"text"}],"kind":"article","url":"\/documentation\/readium\/readium-lcp","title":"Supporting Readium LCP","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","role":"article","type":"topic"},"doc://Readium/documentation/Readium/Decorations":{"role":"article","abstract":[{"type":"text","text":"The Decoration API lets you overlay visual elements on publication content – highlights, search result markers, TTS playback indicators, page-number labels in the margin, and more. For the common case of implementing user highlights, see the "},{"identifier":"Highlights.md","type":"reference","isActive":true},{"type":"text","text":"."}],"identifier":"doc:\/\/Readium\/documentation\/Readium\/Decorations","url":"\/documentation\/readium\/decorations","type":"topic","title":"Decorations","kind":"article"},"doc://Readium/documentation/Readium/Accessibility":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","type":"topic","url":"\/documentation\/readium\/accessibility","