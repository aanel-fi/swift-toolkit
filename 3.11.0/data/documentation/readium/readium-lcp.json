{"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"abstract":[{"text":"You can use the Readium Swift toolkit to download and read publications that are protected with the ","type":"text"},{"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","type":"reference","isActive":true},{"text":" DRM.","type":"text"}],"metadata":{"roleHeading":"Article","role":"article","title":"Supporting Readium LCP"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"[!IMPORTANT]","type":"text"},{"text":" ","type":"text"},{"text":"To use LCP with the Readium toolkit, you must first obtain the ","type":"text"},{"code":"R2LCPClient","type":"codeVoice"},{"text":" private library by contacting ","type":"text"},{"identifier":"https:\/\/www.edrlab.org\/contact\/","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"style":"note","name":"Note"},{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An LCP publication is protected with a "},{"inlineContent":[{"text":"user passphrase","type":"text"}],"type":"emphasis"},{"type":"text","text":" and distributed using an LCP License Document ("},{"type":"codeVoice","code":".lcpl"},{"type":"text","text":") ."}]},{"inlineContent":[{"text":"The user flow typically goes as follows:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user imports a "},{"type":"codeVoice","code":".lcpl"},{"type":"text","text":" file into your application."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The application uses the Readium toolkit to download the protected publication from the "},{"type":"codeVoice","code":".lcpl"},{"type":"text","text":" file to the user’s bookshelf. The downloaded file can be a "},{"type":"codeVoice","code":".epub"},{"type":"text","text":", "},{"type":"codeVoice","code":".lcpdf"},{"type":"text","text":" (PDF), or "},{"type":"codeVoice","code":".lcpa"},{"type":"text","text":" (audiobook) package."}]}]},{"content":[{"inlineContent":[{"text":"The user opens the protected publication from the bookshelf.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If the passphrase isn’t already recorded in the ","type":"text"},{"type":"codeVoice","code":"ReadiumLCP"},{"text":" internal database, the user will be asked to enter it to unlock the contents.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The publication is decrypted and rendered on the screen."}],"type":"paragraph"}]}]},{"level":2,"text":"Setup","type":"heading","anchor":"Setup"},{"inlineContent":[{"type":"text","text":"To support LCP in your application, you require two components:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"ReadiumLCP"},{"text":" package from the toolkit provides APIs for downloading and decrypting protected publications. Import it as you would any other Readium package, such as ","type":"text"},{"type":"codeVoice","code":"R2Navigator"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The private ","type":"text"},{"code":"R2LCPClient","type":"codeVoice"},{"text":" library customized for your application ","type":"text"},{"overridingTitle":"is available from EDRLab","isActive":true,"identifier":"https:\/\/www.edrlab.org\/contact\/","overridingTitleInlineContent":[{"type":"text","text":"is available from EDRLab"}],"type":"reference"},{"text":". They will provide instructions for integrating the ","type":"text"},{"code":"R2LCPClient","type":"codeVoice"},{"text":" framework into your application.","type":"text"}],"type":"paragraph"}]}]},{"level":3,"text":"File formats","type":"heading","anchor":"File-formats"},{"inlineContent":[{"text":"Readium LCP specifies new file formats.","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Name"}],"type":"paragraph"}],[{"inlineContent":[{"text":"File extension","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Media type","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lcp\/latest.html#32-content-conformance","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"code":".lcpl","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"application\/vnd.readium.lcp.license.v1.0+json"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-pdf.html"}],"type":"paragraph"}],[{"inlineContent":[{"code":".lcpdf","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"application\/pdf+lcp"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-audiobooks.html","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"code":".lcpa","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"application\/audiobook+lcp","type":"codeVoice"}],"type":"paragraph"}]]]},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"text":"EPUB files protected by LCP are supported without a special file extension or media type because EPUB accommodates any DRM scheme in its specification.","type":"text"}]}],"style":"note"},{"inlineContent":[{"text":"To support these formats in your application, you need to ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/defining_file_and_data_types_for_your_app"},{"text":" as imported types.","type":"text"}],"type":"paragraph"},{"syntax":"xml","type":"codeListing","code":["<dict>","    <key>UTImportedTypeDeclarations<\/key>","    <array>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpl<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.json<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP License Document<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpl<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/vnd.readium.lcp.license.v1.0+json<\/string>","            <\/dict>","        <\/dict>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpdf<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.archive<\/string>","                <string>public.zip-archive<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP for PDF package<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpdf<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/pdf+lcp<\/string>","            <\/dict>","        <\/dict>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpa<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.archive<\/string>","                <string>public.zip-archive<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP for Audiobooks package<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpa<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/audiobook+lcp<\/string>","            <\/dict>","        <\/dict>","    <\/array>","<\/dict>"]},{"inlineContent":[{"type":"text","text":"Next, declare the imported types as "},{"isActive":true,"type":"reference","identifier":"https:\/\/help.apple.com\/xcode\/mac\/current\/#\/devddd273fdd"},{"type":"text","text":" in the "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" to have your application listed in the “Open with…” dialogs."}],"type":"paragraph"},{"syntax":"xml","type":"codeListing","code":["<dict>","    <key>CFBundleDocumentTypes<\/key>","    <array>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP License Document<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpl<\/string>","            <\/array>","        <\/dict>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP for PDF package<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpdf<\/string>","            <\/array>","        <\/dict>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP for Audiobooks package<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpa<\/string>","            <\/array>","        <\/dict>","    <\/array>","<\/dict>"]},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"[!TIP]","type":"text"},{"text":" ","type":"text"},{"text":"If EPUB is not included in your document types, now is a good time to add it.","type":"text"}]}],"style":"note"},{"level":3,"text":"Allow insecure HTTP requests","type":"heading","anchor":"Allow-insecure-HTTP-requests"},{"inlineContent":[{"type":"text","text":"A file required by the LCP library needs to be downloaded from an insecure HTTP location. You must authorize this download by adding the following to your "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":" file:"}],"type":"paragraph"},{"syntax":"xml","type":"codeListing","code":["<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSExceptionDomains<\/key>","    <dict>","        <key>crl.edrlab.telesec.de<\/key>","        <dict>","            <key>NSExceptionAllowsInsecureHTTPLoads<\/key>","            <true\/>","        <\/dict>","    <\/dict>","<\/dict>"]},{"level":3,"text":"Device name for LCP registration","type":"heading","anchor":"Device-name-for-LCP-registration"},{"inlineContent":[{"text":"When registering a license with an LSD server, Readium LCP identifies the device by name using ","type":"text"},{"type":"codeVoice","code":"UIDevice.current.name"},{"text":". Since iOS 16, this returns a generic string such as “iPhone” instead of the user-assigned device name.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To obtain the actual device name, add the "},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/bundleresources\/entitlements\/com_apple_developer_device-information_user-assigned-device-name"},{"type":"text","text":" entitlement to your app’s "},{"type":"codeVoice","code":".entitlements"},{"type":"text","text":" file. This entitlement requires approval from Apple."}],"type":"paragraph"},{"syntax":"xml","type":"codeListing","code":["<key>com.apple.developer.device-information.user-assigned-device-name<\/key>","<true\/>"]},{"inlineContent":[{"type":"text","text":"Alternatively, you can supply your own device name when initializing "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":" via the "},{"type":"codeVoice","code":"deviceName"},{"type":"text","text":" parameter."}],"type":"paragraph"},{"level":2,"text":"Initializing the `LCPService`","type":"heading","anchor":"Initializing-the-LCPService"},{"inlineContent":[{"code":"ReadiumLCP","type":"codeVoice"},{"text":" offers an ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":" object that exposes its API. Since the ","type":"text"},{"code":"ReadiumLCP","type":"codeVoice"},{"text":" package is not linked with ","type":"text"},{"code":"R2LCPClient","type":"codeVoice"},{"text":", you need to create your own adapter when setting up the ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":" expects repositories to store the opened licenses and passphrases. "},{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" provides built-in Keychain-based implementations that store data securely in the iOS\/macOS Keychain. Unlike database-based storage, Keychain data persists across app reinstalls and can optionally be synchronized across the user’s devices via iCloud Keychain."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import R2LCPClient","import ReadiumLCP","","let httpClient = DefaultHTTPClient()","","let assetRetriever = AssetRetriever(","    httpClient: httpClient",")","","let lcpService = LCPService(","    client: LCPClientAdapter(),","    licenseRepository: LCPKeychainLicenseRepository(),","    passphraseRepository: LCPKeychainPassphraseRepository(),","    assetRetriever: assetRetriever,","    httpClient: httpClient",")","","\/\/\/ Facade to the private R2LCPClient.framework.","class LCPClientAdapter: ReadiumLCP.LCPClient {","    func createContext(jsonLicense: String, hashedPassphrase: LCPPassphraseHash, pemCrl: String) throws -> LCPClientContext {","        try R2LCPClient.createContext(jsonLicense: jsonLicense, hashedPassphrase: hashedPassphrase, pemCrl: pemCrl)","    }","","    func decrypt(data: Data, using context: LCPClientContext) -> Data? {","        R2LCPClient.decrypt(data: data, using: context as! DRMContext)","    }","","    func findOneValidPassphrase(jsonLicense: String, hashedPassphrases: [LCPPassphraseHash]) -> LCPPassphraseHash? {","        R2LCPClient.findOneValidPassphrase(jsonLicense: jsonLicense, hashedPassphrases: hashedPassphrases)","    }","}"]},{"inlineContent":[{"text":"To disable iCloud synchronization, pass ","type":"text"},{"type":"codeVoice","code":"synchronizable: false"},{"type":"text","text":" when creating the repositories."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You may also implement your own persistence layer by conforming to "},{"type":"codeVoice","code":"LCPLicenseRepository"},{"type":"text","text":" and "},{"type":"codeVoice","code":"LCPPassphraseRepository"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Acquiring a publication from a License Document (LCPL)","type":"heading","anchor":"Acquiring-a-publication-from-a-License-Document-LCPL"},{"inlineContent":[{"type":"text","text":"Users need to import a License Document into your application to download the protected publication ("},{"code":".epub","type":"codeVoice"},{"type":"text","text":", "},{"code":".lcpdf","type":"codeVoice"},{"type":"text","text":", or "},{"code":".lcpa","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"code":"LCPService","type":"codeVoice"},{"type":"text","text":" offers an API to retrieve the full publication from an LCPL on the filesystem."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let result = await lcpService.acquirePublication(","    from: .file(lcplURL),","    onProgress: { progress in","        switch progress {","            case .indefinite:","                \/\/ Display an activity indicator.","            case .percent(let percent):","                \/\/ Display a progress bar with percent from 0 to 1.","        }","    }",")","","switch result {","case let .success(publication):","    \/\/ Import the `publication.localURL` file as any publication.","case let .failure(error):","    \/\/ Display the error message.","}"]},{"inlineContent":[{"text":"After the download is completed, import the ","type":"text"},{"code":"publication.localURL","type":"codeVoice"},{"text":" file into the bookshelf like any other publication file.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Opening a publication protected with LCP","type":"heading","anchor":"Opening-a-publication-protected-with-LCP"},{"level":3,"text":"Initializing the `PublicationOpener`","type":"heading","anchor":"Initializing-the-PublicationOpener"},{"inlineContent":[{"type":"text","text":"A publication protected with LCP can be opened using the "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":" component, just like a non-protected publication. However, you must provide a "},{"type":"reference","identifier":"https:\/\/readium.org\/architecture\/proposals\/006-content-protection.html","isActive":true},{"type":"text","text":" implementation when initializing the "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":" to enable LCP. Luckily, "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":" has you covered."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let httpClient = DefaultHTTPClient()","","let authentication = LCPDialogAuthentication()","","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: AssetRetriever(httpClient: httpClient),","        pdfFactory: DefaultPDFDocumentFactory()","    ),","    contentProtections: [","        lcpService.contentProtection(with: authentication)","    ]",")"]},{"inlineContent":[{"type":"text","text":"An LCP package is secured with a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"user passphrase"}]},{"type":"text","text":" for decrypting the content. The "},{"type":"codeVoice","code":"LCPAuthenticating"},{"type":"text","text":" protocol used by "},{"type":"codeVoice","code":"LCPService.contentProtection(with:)"},{"type":"text","text":" provides the passphrase when needed. You can use the default UIKit "},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"type":"text","text":" which displays a pop-up to enter the passphrase, or implement your own method for passphrase retrieval. If your application is built using SwiftUI, "},{"type":"reference","identifier":"#using-the-swiftui-lcp-authentication-dialog","isActive":true}],"type":"paragraph"},{"name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"text","text":"The user will be prompted once per passphrase since "},{"code":"ReadiumLCP","type":"codeVoice"},{"type":"text","text":" stores known passphrases on the device."}],"type":"paragraph"}],"style":"note"},{"level":3,"text":"Opening the publication","type":"heading","anchor":"Opening-the-publication"},{"inlineContent":[{"type":"text","text":"You are now ready to open the publication file with your "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":" instance."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Retrieve an `Asset` to access the file content.","let url = FileURL(path: \"\/path\/to\/lcp-protected-book.epub\", isDirectory: false)","let asset = try await assetRetriever.retrieve(url: url).get()"," ","\/\/ Open a `Publication` from the `Asset`.","let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    sender: hostViewController",")","","switch result {","case .success(let publication):","    \/\/ Import or present the publication.","case .failure(let error):","    \/\/ Present the error.","}"]},{"inlineContent":[{"type":"text","text":"The "},{"code":"allowUserInteraction","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"sender","type":"codeVoice"},{"text":" arguments are forwarded to the ","type":"text"},{"code":"LCPAuthenticating","type":"codeVoice"},{"text":" implementation when the passphrase is unknown. ","type":"text"},{"code":"LCPDialogAuthentication","type":"codeVoice"},{"text":" shows a pop-up only if ","type":"text"},{"code":"allowUserInteraction","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", using the ","type":"text"},{"code":"sender","type":"codeVoice"},{"text":" as the pop-up’s host ","type":"text"},{"code":"UIViewController","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When importing the publication to the bookshelf, set ","type":"text"},{"code":"allowUserInteraction","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" as you don’t need the passphrase for accessing the publication metadata and cover. If you intend to present the publication using a Navigator, set ","type":"text"},{"code":"allowUserInteraction","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" as decryption will be required.","type":"text"}],"type":"paragraph"},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"[!TIP]","type":"text"},{"text":" ","type":"text"},{"text":"To check if an asset is protected with LCP before opening it, you can use ","type":"text"},{"code":"asset.format.conformsTo(.lcp)","type":"codeVoice"},{"text":".","type":"text"}]}],"style":"note"},{"level":3,"text":"Using the opened `Publication`","type":"heading","anchor":"Using-the-opened-Publication"},{"inlineContent":[{"type":"text","text":"After obtaining a "},{"code":"Publication","type":"codeVoice"},{"type":"text","text":" instance, you can access the publication’s metadata to import it into the user’s bookshelf. The user passphrase is not needed for reading the metadata or cover."}],"type":"paragraph"},{"inlineContent":[{"text":"However, if you want to display the publication with a Navigator, verify it is not restricted. It could be restricted if the user passphrase is unknown or if the license is no longer valid (e.g., expired loan, revoked purchase, etc.).","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["if publication.isRestricted {","    if let error = publication.protectionError as? LCPError {","        \/\/ The user is not allowed to open the publication. You should display the error.","    } else {","        \/\/ We don't have the user passphrase.","        \/\/ You may use `publication` to access its metadata, but not to render its content.","    }","} else {","    \/\/ The publication is not restricted, you may render it with a Navigator component.","}"]},{"level":2,"text":"Streaming an LCP protected package","type":"heading","anchor":"Streaming-an-LCP-protected-package"},{"inlineContent":[{"text":"If the server hosting the LCP protected package supports the ","type":"text"},{"isActive":true,"identifier":"https:\/\/httpwg.org\/specs\/rfc9110.html#HEAD","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"https:\/\/httpwg.org\/specs\/rfc7233.html","type":"reference"},{"text":", it is possible to stream directly an LCP protected publication from a License Document (","type":"text"},{"type":"codeVoice","code":".lcpl"},{"text":") file, without downloading the whole publication first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Simply open the License Document directly using the "},{"code":"PublicationOpener","type":"codeVoice"},{"type":"text","text":". Make sure you provide an "},{"code":"HTTPClient","type":"codeVoice"},{"type":"text","text":" (or an "},{"code":"HTTPResourceFactory","type":"codeVoice"},{"type":"text","text":" for additional customization) to the "},{"code":"AssetRetriever","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Instantiate the required components.","let httpClient = DefaultHTTPClient()","let assetRetriever = AssetRetriever(httpClient: httpClient)","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever","    ),","    contentProtections: [","        lcpService.contentProtection(with: LCPDialogAuthentication()),","    ]",")","","\/\/ Retrieve an `Asset` to access the LCPL content.","let url = FileURL(path: \"\/path\/to\/license.lcpl\", isDirectory: false)","let asset = try await assetRetriever.retrieve(url: url).get()"," ","\/\/ Open a `Publication` from the LCPL `Asset`.","let publication = try await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    sender: hostViewController",").get()","    ","print(\"Opened \\(publication.metadata.title)\")"]},{"level":2,"text":"Obtaining information on an LCP license","type":"heading","anchor":"Obtaining-information-on-an-LCP-license"},{"inlineContent":[{"text":"An LCP License Document contains metadata such as its expiration date, the remaining number of characters to copy and the user name. You can access this information using an ","type":"text"},{"code":"LCPLicense","type":"codeVoice"},{"text":" object.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use the ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":" to retrieve the ","type":"text"},{"code":"LCPLicense","type":"codeVoice"},{"text":" instance for a publication.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let result = await lcpService.retrieveLicense(","    from: asset,","    authentication: LCPDialogAuthentication(),","    allowUserInteraction: true,","    sender: hostViewController",")","","switch result {","case .success(let lcpLicense):","    if let user = lcpLicense.license.user.name {","        print(\"The publication was acquired by \\(user)\")","    }","    if let endDate = lcpLicense.license.rights.end {","        print(\"The loan expires on \\(endDate)\")","    }","    if let copyLeft = await lcpLicense.charactersToCopyLeft() {","        print(\"You can copy up to \\(copyLeft) characters remaining.\")","    }","case .failure(let error):","    \/\/ Display the error.","}"]},{"inlineContent":[{"text":"If you have already opened a ","type":"text"},{"type":"codeVoice","code":"Publication"},{"text":" with the ","type":"text"},{"type":"codeVoice","code":"PublicationOpener"},{"text":", you can directly obtain the ","type":"text"},{"type":"codeVoice","code":"LCPLicense"},{"text":" using ","type":"text"},{"type":"codeVoice","code":"publication.lcpLicense"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Managing a loan","type":"heading","anchor":"Managing-a-loan"},{"inlineContent":[{"text":"Readium LCP allows borrowing publications for a specific period. Use the ","type":"text"},{"type":"codeVoice","code":"LCPLicense"},{"text":" object to manage a loan and retrieve its end date using ","type":"text"},{"type":"codeVoice","code":"lcpLicense.license.rights.end"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"text":"Returning a loan","type":"heading","anchor":"Returning-a-loan"},{"inlineContent":[{"text":"Some loans can be returned before the end date. You can confirm this by using ","type":"text"},{"type":"codeVoice","code":"lcpLicense.canReturnPublication"},{"text":". To return the publication, execute:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let result = await lcpLicense.returnPublication()","switch result {","case .success:","    \/\/ The publication was returned.","case .failure(let error):","    \/\/ Present the error.","}"]},{"level":3,"text":"Renewing a loan","type":"heading","anchor":"Renewing-a-loan"},{"inlineContent":[{"type":"text","text":"The loan end date may also be extended. You can confirm this by using "},{"code":"lcpLicense.canRenewLoan","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Readium LCP supports "},{"type":"reference","isActive":true,"identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lsd\/latest#35-renewing-a-license"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Programmatic: You show your own user interface."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Interactive: You display a web view, and the Readium LSD server manages the renewal for you."}]}]}]},{"inlineContent":[{"text":"You need to support both interactions by implementing the ","type":"text"},{"type":"codeVoice","code":"LCPRenewDelegate"},{"text":" protocol. A default implementation is available with ","type":"text"},{"type":"codeVoice","code":"LCPDefaultRenewDelegate"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let result = await lcpLicense.renewLoan(","    with: LCPDefaultRenewDelegate(","        presentingViewController: hostViewController","    )",")","","switch result {","case .success:","    \/\/ The publication was renewed.","case let .failure(error):","    \/\/ Display the error.","}"]},{"level":2,"text":"Handling `LCPError`","type":"heading","anchor":"Handling-LCPError"},{"inlineContent":[{"text":"The APIs may fail with an ","type":"text"},{"code":"LCPError","type":"codeVoice"},{"text":". These errors ","type":"text"},{"inlineContent":[{"text":"must","type":"text"}],"type":"strong"},{"text":" be displayed to the user with a suitable message.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For an example, ","type":"text"},{"identifier":"https:\/\/github.com\/readium\/swift-toolkit\/blob\/3.0.0\/TestApp\/Sources\/App\/Readium.swift#L221","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Using the SwiftUI LCP Authentication dialog","type":"heading","anchor":"Using-the-SwiftUI-LCP-Authentication-dialog"},{"inlineContent":[{"type":"text","text":"If your application is built using SwiftUI, you cannot use "},{"code":"LCPDialogAuthentication","type":"codeVoice"},{"type":"text","text":" because it requires a UIKit view controller as its host. Instead, use an "},{"code":"LCPObservableAuthentication","type":"codeVoice"},{"type":"text","text":" combined with our SwiftUI "},{"code":"LCPDialog","type":"codeVoice"},{"type":"text","text":" presented as a sheet."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@main","struct MyApp: App {","    private let lcpService: LCPService","    private let publicationOpener: PublicationOpener","","    @StateObject private var lcpAuthentication: LCPObservableAuthentication","","    init() {","        \/\/ Create an `LCPObservableAuthentication` which will be used","        \/\/ to initialize the `LCPContentProtection`.","        \/\/","        \/\/ With SwiftUI, it must be stored in a `@StateObject` property","        \/\/ to observe the authentication requests.","        let lcpAuthentication = LCPObservableAuthentication()","        _lcpAuthentication = StateObject(wrappedValue: lcpAuthentication)","","        lcpService = LCPService(...)","","        publicationOpener = PublicationOpener(","            ...,","            contentProtections: [","                lcpService.contentProtection(with: lcpAuthentication)","            ]","        )","    }","","    var body: some Scene {","        WindowGroup {","            ContentView()","                \/\/ You can present an `LCPDialog` when the `LCPObservableAuthentication`","                \/\/ `request` property is updated.","                .sheet(item: $lcpAuthentication.request) {","                    LCPDialog(request: $0)","                }","            }","        }","    }","}"]}],"kind":"content"}],"kind":"article","seeAlsoSections":[{"title":"Guides","generated":true,"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility"],"anchor":"Guides"}],"references":{"https://readium.org/lcp-specs/releases/lsd/latest#35-renewing-a-license":{"type":"link","identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lsd\/latest#35-renewing-a-license","url":"https:\/\/readium.org\/lcp-specs\/releases\/lsd\/latest#35-renewing-a-license","title":"two types of renewal interactions","titleInlineContent":[{"text":"two types of renewal interactions","type":"text"}]},"https://developer.apple.com/documentation/bundleresources/entitlements/com_apple_developer_device-information_user-assigned-device-name":{"title":"com.apple.developer.device-information.user-assigned-device-name","titleInlineContent":[{"type":"codeVoice","code":"com.apple.developer.device-information.user-assigned-device-name"}],"url":"https:\/\/developer.apple.com\/documentation\/bundleresources\/entitlements\/com_apple_developer_device-information_user-assigned-device-name","type":"link","identifier":"https:\/\/developer.apple.com\/documentation\/bundleresources\/entitlements\/com_apple_developer_device-information_user-assigned-device-name"},"doc://Readium/documentation/Readium/Getting-Started":{"abstract":[{"text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics.","type":"text"}],"kind":"article","url":"\/documentation\/readium\/getting-started","type":"topic","title":"Getting started","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started"},"https://readium.org/lcp-specs/releases/lcp/latest.html#32-content-conformance":{"type":"link","identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lcp\/latest.html#32-content-conformance","url":"https:\/\/readium.org\/lcp-specs\/releases\/lcp\/latest.html#32-content-conformance","title":"License Document","titleInlineContent":[{"text":"License Document","type":"text"}]},"doc://Readium/documentation/Readium":{"type":"topic","url":"\/documentation\/readium","abstract":[{"text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin.","type":"text"}],"kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium","role":"collection","title":"Readium"},"doc://Readium/documentation/Readium/Open-Publication":{"kind":"article","type":"topic","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","url":"\/d