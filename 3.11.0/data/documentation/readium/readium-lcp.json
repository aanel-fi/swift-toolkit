tract":[{"text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the ","type":"text"},{"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","isActive":true,"type":"reference"},{"text":" specification.","type":"text"}],"title":"Accessibility","role":"article"}}}