{"primaryContentSections":[{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"text","text":"Readium offers only low-level tools. You are responsible for creating a user interface for reading and managing books, as well as a data layer to store the user’s publications. The Test App is an example of such integration."}],"type":"paragraph"}],"type":"aside","style":"note"},{"text":"Design principles","anchor":"Design-principles","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The toolkit has been designed following these core tenets:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Modular","type":"text"}],"type":"strong"},{"text":": It is divided into separate modules that can be used independently.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Extensible","type":"text"}],"type":"strong"},{"text":": Integrators should be able to support a custom DRM, publication format or inject their own stylesheets without modifying the toolkit itself.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Opiniated"}]},{"type":"text","text":": We adhere to open standards but sometimes interpret them for practicality."}]}]}],"type":"unorderedList"},{"text":"Packages","anchor":"Packages","type":"heading","level":2},{"text":"Main packages","anchor":"Main-packages","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"code":"ReadiumShared","type":"codeVoice"},{"text":" contains shared ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" models and utilities.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ReadiumStreamer"},{"text":" parses publication files (e.g. an EPUB) into a ","type":"text"},{"type":"codeVoice","code":"Publication"},{"text":" object.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"Navigator\/Navigator.md","isActive":true},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"text":"Specialized packages","anchor":"Specialized-packages","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ReadiumOPDS"},{"type":"text","text":" parses "},{"isActive":true,"type":"reference","identifier":"https:\/\/opds.io"},{"type":"text","text":" (both OPDS 1 and 2)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"Readium%20LCP.md"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"text":"Overview of the shared models (`ReadiumShared`)","anchor":"Overview-of-the-shared-models-ReadiumShared","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The Readium toolkit provides models used as exchange types between packages."}],"type":"paragraph"},{"text":"Publication models","anchor":"Publication-models","type":"heading","level":3},{"text":"Publication","anchor":"Publication","type":"heading","level":4},{"inlineContent":[{"type":"codeVoice","code":"Publication"},{"text":" and its sub-components represent a single publication – ebook, audiobook or comic. It is loosely based on the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/readium.org\/webpub-manifest\/"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"Publication"},{"text":" instance:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"holds the metadata of a publication, such as its author or table of contents,","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"allows to read the contents of a publication, e.g. XHTML or audio resources,"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"provides additional services, for example content extraction or text search."}]}]}],"type":"unorderedList"},{"text":"Link","anchor":"Link","type":"heading","level":4},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object","isActive":true,"type":"reference"},{"text":" holds a pointer (URL) to a resource or service along with additional metadata, such as its media type or title.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"code":"Publication","type":"codeVoice"},{"type":"text","text":" contains several "},{"code":"Link","type":"codeVoice"},{"type":"text","text":" collections, for example:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"readingOrder"},{"text":" lists the publication resources arranged in the order they should be read.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"resources"},{"type":"text","text":" contains secondary resources necessary for rendering the "},{"type":"codeVoice","code":"readingOrder"},{"type":"text","text":", such as an image or a font file."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"tableOfContents","type":"codeVoice"},{"text":" represents the table of contents as a tree of ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":" objects.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"links"},{"type":"text","text":" exposes additional resources, such as a canonical link to the manifest or a search web service."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Locator","anchor":"Locator","type":"heading","level":4},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"https:\/\/readium.org\/architecture\/models\/locators\/","type":"reference","isActive":true},{"text":" represents a precise location in a publication resource in a format that can be stored and shared across reading systems. It is more accurate than a ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":" and contains additional information about the location, e.g. progression percentage, position or textual context.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"Locator"},{"type":"text","text":" objects are used for various features, including:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"reporting the current progression in the publication"}]}]},{"content":[{"inlineContent":[{"text":"saving bookmarks, highlights and annotations","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"navigating search results"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Data models","anchor":"Data-models","type":"heading","level":3},{"text":"Asset","anchor":"Asset","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":" represents a single file or package and provides access to its content. There are two types of "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ContainerAsset"},{"type":"text","text":" for packages which contains several resources, such as a ZIP archive."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ResourceAsset"},{"type":"text","text":" for accessing a single resource, such as a JSON or PDF file."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"codeVoice","code":"Asset"},{"type":"text","text":" instances are obtained through an "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"You can use the ","type":"text"},{"type":"codeVoice","code":"asset.format"},{"text":" to identify the media type and capabilities of the asset.","type":"text"}],"type":"paragraph"},{"code":["if asset.format.conformsTo(.lcp) {","    \/\/ The asset is protected with LCP.","}","if asset.format.conformsTo(.epub) {","    \/\/ The asset represents an EPUB publication.","}"],"syntax":"swift","type":"codeListing"},{"text":"Resource","anchor":"Resource","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Resource"},{"type":"text","text":" provides read access to a single resource, such as a file or an entry in an archive."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"Resource"},{"text":" instances are usually created by a ","type":"text"},{"type":"codeVoice","code":"ResourceFactory"},{"text":". The toolkit ships with various implementations supporting different data access protocols such as local files or HTTP.","type":"text"}],"type":"paragraph"},{"text":"Container","anchor":"Container","type":"heading","level":4},{"inlineContent":[{"text":"A ","type":"text"},{"code":"Container","type":"codeVoice"},{"text":" provides read access to a collection of resources. ","type":"text"},{"code":"Container","type":"codeVoice"},{"text":" instances representing an archive are usually created by an ","type":"text"},{"code":"ArchiveOpener","type":"codeVoice"},{"text":". The toolkit ships with a ","type":"text"},{"code":"ZIPArchiveOpener","type":"codeVoice"},{"text":" supporting both local and remote (HTTP) ZIP files.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"Publication","type":"codeVoice"},{"text":" objects internally use a ","type":"text"},{"code":"Container","type":"codeVoice"},{"text":" to expose its content.","type":"text"}],"type":"paragraph"},{"text":"Opening a publication (`ReadiumStreamer`)","anchor":"Opening-a-publication-ReadiumStreamer","type":"heading","level":2},{"inlineContent":[{"text":"To retrieve a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" object from a publication file like an EPUB or audiobook, you can use an ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["\/\/ Instantiate the required components.","let httpClient = DefaultHTTPClient()","let assetRetriever = AssetRetriever(","    httpClient: httpClient",")","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever,","        pdfFactory: DefaultPDFDocumentFactory()","    )",")","","let url: URL = URL(...)","","\/\/ Retrieve an `Asset` to access the file content.","switch await assetRetriever.retrieve(url: url.anyURL.absoluteURL!) {","case .success(let asset):","    \/\/ Open a `Publication` from the `Asset`.","    switch await publicationOpener.open(asset: asset, allowUserInteraction: true, sender: view) {","    case .success(let publication):","        print(\"Opened \\(publication.metadata.title)\")","","    case .failure(let error):","        \/\/ Failed to access or parse the publication","    }","","case .failure(let error):","    \/\/ Failed to retrieve the asset","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"allowUserInteraction","type":"codeVoice"},{"text":" parameter is useful when supporting a DRM like Readium LCP. It indicates if the toolkit can prompt the user for credentials when the publication is protected.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"Open%20Publication.md","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Accessing the metadata of a publication","anchor":"Accessing-the-metadata-of-a-publication","type":"heading","level":2},{"inlineContent":[{"text":"After opening a publication, you may want to read its metadata to insert a new entity into your bookshelf database, for instance. The ","type":"text"},{"code":"publication.metadata","type":"codeVoice"},{"text":" object contains everything you need, including ","type":"text"},{"code":"title","type":"codeVoice"},{"text":", ","type":"text"},{"code":"authors","type":"codeVoice"},{"text":" and the ","type":"text"},{"code":"published","type":"codeVoice"},{"text":" date.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can retrieve the publication cover using "},{"type":"codeVoice","code":"await publication.cover()"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Rendering the publication on the screen (`ReadiumNavigator`)","anchor":"Rendering-the-publication-on-the-screen-ReadiumNavigator","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"You can use a Readium navigator to present the publication to the user. The "},{"type":"codeVoice","code":"Navigator"},{"type":"text","text":" renders resources on the screen and offers APIs and user interactions for navigating the contents."}],"type":"paragraph"},{"inlineContent":[{"text":"Please refer to the ","type":"text"},{"identifier":"Navigator\/Navigator.md","overridingTitleInlineContent":[{"type":"text","text":"Navigator guide"}],"isActive":true,"overridingTitle":"Navigator guide","type":"reference"},{"text":" for more information.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"generated":true}],"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"kind":"article","metadata":{"roleHeading":"Article","role":"article","title":"Getting started"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics.","type":"text"}],"references":{"doc://Readium/documentation/Readium/TTS":{"kind":"article","type":"topic","url":"\/documentation\/readium\/tts","title":"Text-to-speech","identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","abstract":[],"role":"article"},"doc://Readium/documentation/Readium/Search":{"role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","type":"topic","abstract":[{"text":"The Search API lets you look for a textual query in the content of a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":". EPUB and PDF publications are supported.","type":"text"}],"title":"Searching a publication","url":"\/documentation\/readium\/search","kind":"article"},"https://readium.org/webpub-manifest/#24-the-link-object":{"type":"link","title":"Link object","titleInlineContent":[{"type":"codeVoice","code":"Link"},{"text":" object","type":"text"}],"identifier":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object","url":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object"},"doc://Readium/documentation/Readium/Readium-LCP":{"abstract":[{"text":"You can use the Readium Swift toolkit to download and read publications that are protected with the ","type":"text"},{"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","isActive":true,"type":"reference"},{"text":" DRM.","type":"text"}],"kind":"article","url":"\/documentation\/readium\/readium-lcp","title":"Supporting Readium LCP","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","role":"article","type":"topic"},"doc://Readium/documentation/Readium/Migration-Guide":{"kind":"article","abstract":[{"text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file.","type":"text"}],"role":"article","type":"topic","title":"Migration Guide","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","url":"\/documentation\/readium\/migration-guide"},"doc://Readium/documentation/Readium/NavigatorOverview":{"abstract":[{"type":"text","text":"Learn about the architecture, configuration, and usage of the Readium Navigator."}],"identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","type":"topic","role":"article","kind":"article","title":"Navigator Overview","url":"\/documentation\/readium\/navigatoroverview"},"https://opds.io":{"url":"https:\/\/opds.io","identifier":"https:\/\/opds.io","titleInlineContent":[{"type":"text","text":"OPDS catalog feeds"}],"title":"OPDS catalog feeds","type":"link"},"https://readium.org/architecture/models/locators/":{"type":"link","title":"Locator object","titleInlineContent":[{"type":"codeVoice","code":"Locator"},{"text":" object","type":"text"}],"identifier":"https:\/\/readium.org\/architecture\/models\/locators\/","url":"https:\/\/readium.org\/architecture\/models\/locators\/"},"https://www.w3.org/TR/epub-a11y-11":{"url":"https:\/\/www.w3.org\/TR\/epub-a11y-11","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","titleInlineContent":[{"type":"text","text":"EPUB Accessibility"}],"title":"EPUB Accessibility","type":"link"},"Open%20Publication.md":{"type":"link","title":"See the dedicated user guide for more information","titleInlineContent":[{"type":"text","text":"See the dedicated user guide for more information"}],"identifier":"Open%20Publication.md","url":"Open%20Publication.md