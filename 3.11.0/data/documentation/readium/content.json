{"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"anchor":"Guides","generated":true,"title":"Guides"}],"metadata":{"role":"article","title":"Extracting the content of a publication","roleHeading":"Article"},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/Readium\/Content"},"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"aside","content":[{"inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"text":"The described feature is still experimental and the implementation incomplete.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Note"},{"type":"paragraph","inlineContent":[{"text":"Many high-level features require access to the raw content (text, media, etc.) of a publication, such as:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Text-to-speech"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Accessibility reader","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Basic search","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full-text search indexing"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Image or audio indexes","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ContentService"},{"type":"text","text":" provides a way to iterate through a publication’s content, extracted as semantic elements."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"First, request the publication’s "},{"type":"codeVoice","code":"Content"},{"type":"text","text":", starting from a given "},{"type":"codeVoice","code":"Locator"},{"type":"text","text":". If the locator is missing, the "},{"type":"codeVoice","code":"Content"},{"type":"text","text":" will be extracted from the beginning of the publication."}]},{"type":"codeListing","syntax":"swift","code":["guard let content = publication.content(from: startLocator) else {","    \/\/ Abort as the content cannot be extracted","    return","}"]},{"type":"heading","text":"Extracting the raw text content","anchor":"Extracting-the-raw-text-content","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Getting the whole raw text of a publication is such a common use case that a helper is available on "},{"code":"Content","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["let wholeText = content.text()"]},{"type":"paragraph","inlineContent":[{"text":"This is an expensive operation, proceed with caution and cache the result if you need to reuse it.","type":"text"}]},{"type":"heading","text":"Iterating through the content","anchor":"Iterating-through-the-content","level":2},{"type":"paragraph","inlineContent":[{"text":"The individual ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":" elements can be iterated through with a regular ","type":"text"},{"code":"for","type":"codeVoice"},{"text":" loop by converting it to a sequence:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["for element in content.sequence() {","    \/\/ Process element","}"]},{"type":"paragraph","inlineContent":[{"text":"Alternatively, you can get the whole list of elements with ","type":"text"},{"code":"content.elements()","type":"codeVoice"},{"text":", or use the lower level APIs to iterate the content manually:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let iterator = content.iterator()","while let element = try iterator.next() {","    print(element)","}"]},{"type":"paragraph","inlineContent":[{"text":"Some ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":" implementations support bidirectional iterations. To iterate backwards, use:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let iterator = content.iterator()","while let element = try iterator.previous() {","    print(element)","}"]},{"type":"heading","text":"Processing the elements","anchor":"Processing-the-elements","level":2},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"Content"},{"text":" iterator yields ","type":"text"},{"type":"codeVoice","code":"ContentElement"},{"text":" objects representing a single semantic portion of the publication, such as a heading, a paragraph or an embedded image.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every element has a "},{"type":"codeVoice","code":"locator"},{"type":"text","text":" property targeting it in the publication. You can use the locator, for example, to navigate to the element or to draw a "},{"type":"codeVoice","code":"Decoration"},{"type":"text","text":" on top of it."}]},{"type":"codeListing","syntax":"swift","code":["navigator.go(to: element.locator)"]},{"type":"heading","text":"Types of elements","anchor":"Types-of-elements","level":3},{"type":"paragraph","inlineContent":[{"text":"Depending on the actual implementation of ","type":"text"},{"type":"codeVoice","code":"ContentElement"},{"text":", more properties are available to access the actual data. The toolkit ships with a number of default implementations for common types of elements.","type":"text"}]},{"type":"heading","text":"Embedded media","anchor":"Embedded-media","level":4},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"EmbeddedContentElement"},{"text":" protocol is implemented by any element referencing an external resource. It contains an ","type":"text"},{"type":"codeVoice","code":"embeddedLink"},{"text":" property you can use to get the actual content of the resource.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["if let element = element as? EmbeddedContentElement {","    let bytes = try publication","        .get(element.embeddedLink)","        .read().get()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here are the default available implementations:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"AudioContentElement","type":"codeVoice"},{"text":" - audio clips","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"VideoContentElement"},{"type":"text","text":" - video clips"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ImageContentElement","type":"codeVoice"},{"type":"text","text":" - bitmap images, with the additional property:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"caption: String?"},{"type":"text","text":" - figure caption, when available"}]}]}]}]}]},{"type":"heading","text":"Text","anchor":"Text","level":4},{"type":"heading","text":"Textual elements","anchor":"Textual-elements","level":5},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"TextualContentElement","type":"codeVoice"},{"text":" protocol is implemented by any element which can be represented as human-readable text. This is useful when you want to extract the text content of a publication without caring for each individual type of elements.","type":"text"}]},{"syntax":"swift","code":["let wholeText = publication.content()","    .elements()","    .compactMap { ($0 as? TextualContentElement)?.text.takeIf { !$0.isEmpty } }","    .joined(separator: \"\\n\")"],"type":"codeListing"},{"level":5,"text":"Text elements","anchor":"Text-elements","type":"heading"},{"inlineContent":[{"text":"Actual text elements are instances of ","type":"text"},{"code":"TextContentElement","type":"codeVoice"},{"text":", which represent a single block of text such as a heading, a paragraph or a list item. It is comprised of a ","type":"text"},{"code":"role","type":"codeVoice"},{"text":" and a list of ","type":"text"},{"code":"segments","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"role"},{"type":"text","text":" is the nature of the text element in the document. For example a heading, body, footnote or a quote. It can be used to reconstruct part of the structure of the original document."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A text element is composed of individual segments with their own "},{"code":"locator","type":"codeVoice"},{"type":"text","text":" and "},{"code":"attributes","type":"codeVoice"},{"type":"text","text":". They are useful to associate attributes with a portion of a text element. For example, given the HTML paragraph:"}],"type":"paragraph"},{"syntax":"html","code":["<p>It is pronounced <span lang=\"fr\">croissant<\/span>.<\/p>"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The following "},{"type":"codeVoice","code":"TextContentElement"},{"type":"text","text":" will be produced:"}],"type":"paragraph"},{"syntax":"swift","code":["TextContentElement(","    role: .body,","    segments: [","        TextContentElement.Segment(text: \"It is pronounced \"),","        TextContentElement.Segment(text: \"croissant\", attributes: [ContentAttribute(key: .language, value: \"fr\")]),","        TextContentElement.Segment(text: \".\")","    ]",")"],"type":"codeListing"},{"inlineContent":[{"text":"If you are not interested in the segment attributes, you can also use ","type":"text"},{"code":"element.text","type":"codeVoice"},{"text":" to get the concatenated raw text.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Element attributes","anchor":"Element-attributes","type":"heading"},{"inlineContent":[{"text":"All types of ","type":"text"},{"type":"codeVoice","code":"ContentElement"},{"text":" can have associated attributes. Custom ","type":"text"},{"type":"codeVoice","code":"ContentService"},{"text":" implementations can use this as an extensibility point.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Use cases","anchor":"Use-cases","type":"heading"},{"level":3,"text":"An index of all images embedded in the publication","anchor":"An-index-of-all-images-embedded-in-the-publication","type":"heading"},{"inlineContent":[{"type":"text","text":"This example extracts all the embedded images in the publication and displays them in a SwiftUI list. Clicking on an image jumps to its location in the publication."}],"type":"paragraph"},{"syntax":"swift","code":["struct ImageIndex: View {","    struct Item: Hashable {","        let locator: Locator","        let text: String?","        let image: UIImage","    }","","    let publication: Publication","    let navigator: Navigator","    @State private var items: [Item] = []","","    init(publication: Publication, navigator: Navigator) {","        self.publication = publication","        self.navigator = navigator","    }","","    var body: some View {","        ScrollView {","            LazyVStack {","                ForEach(items, id: \\.self) { item in","                    VStack() {","                        Image(uiImage: item.image)","                        Text(item.text ?? \"No caption\")","                    }","                    .onTapGesture {","                        navigator.go(to: item.locator)","                    }","                }","            }","        }","        .onAppear {","            items = publication.content()?","                .elements()","                .compactMap { element in","                    guard","                        let element = element as? ImageContentElement,","                        let image = try? publication.get(element.embeddedLink)","                            .read().map(UIImage.init).get()","                    else {","                        return nil","                    }","","                    return Item(","                        locator: element.locator,","                        text: element.caption ?? element.accessibilityLabel,","                        image: image","                    )","                }","                ?? []","        }","    }","}"],"type":"codeListing"},{"level":2,"text":"References","anchor":"References","type":"heading"},{"items":[{"content":[{"inlineContent":[{"identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177","isActive":true,"type":"reference"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"kind":"article","references":{"https://www.edrlab.org/readium-lcp/":{"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","type":"link","titleInlineContent":[{"type":"text","text":"Readium LCP"}],"title":"Readium LCP","url":"https:\/\/www.edrlab.org\/readium-lcp\/"},"doc://Readium/documentation/Readium/Search":{"role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","type":"topic","abstract":[{"text":"The Search API lets you look for a textual query in the content of a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":". EPUB and PDF publications are supported.","type":"text"}],"title":"Searching a publication","url":"\/documentation\/readium\/search","kind":"article"},"doc://Readium/documentation/Readium/NavigatorOverview":{"abstract":[{"type":"text","text":"Learn about the architecture, configuration, and usage of the Readium Navigator."}],"identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","type":"topic","role":"article","kind":"article","title":"Navigator Overview","url":"\/documentation\/readium\/navigatoroverview"},"doc://Readium/documentation/Readium/Getting-Started":{"abstract":[{"text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics.","type":"text"}],"kind":"article","url":"\/documentation\/readium\/getting-started","type":"topic","title":"Getting started","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started"},"doc://Readium/documentation/Readium":{"type":"topic","url":"\/documentation\/readium","abstract":[{"text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin.","type":"text"}],"kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium","role":"collection","title":"Readium"},"doc://Readium/documentation/Readium/Migration-Guide":{"kind":"article","abstract":[{"text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file.","type":"text"}],"role":"article","type":"topic","title":"Migration Guide","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","url":"\/documentation\/readium\/migration-guide"},"doc://Readium/documentation/Readium/Accessibility":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","type":"topic","url":"\/documentation\/readium\/accessibility","kind":"article","abstract":[{"text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the ","type":"text"},{"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","isActive":true,"type":"reference"},{"text":" specification.","type":"text"}],"title":"Accessibility","role":"article"},"doc://Readium/documentation/Readium/Open-Publication":{"kind":"article","type":"topic","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","url":"\/documentation\/readium\/open-publication","abstract":[{"type":"text","text":"To open a publication with Readium, you need to instantiate a couple of components: an "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":"."}],"title":"Opening a publication"},"doc://Readium/documentation/Readium/TTS":{"kind":"article","type":"topic","url":"\/documentation\/readium\/tts","title":"Text-to-speech","identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","abstract":[],"role":"article"},"doc://Readium/documentation/Readium/Readium-LCP":{"abstract":[{"text":"You can use the Readium Swift toolkit to download and read publications that are protected with the ","type":"text"},{"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","isActive":true,"type":"reference"},{"text":" DRM.","type":"text"}],"kind":"article","url":"\/documentation\/readium\/readium-lcp","title":"Supporting Readium LCP","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","role":"article","type":"topic"},"https://github.com/readium/architecture/pull/177":{"title":"Content Iterator proposal","titleInlineContent":[{"text":"Content Iterator proposal","type":"text"}],"type":"link","identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177","url":"https:\/\/github.com\/readium\/architecture\/pull\/177"},"https://www.w3.org/TR/epub-a11y-11":{"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"link","titleInlineContent":[{"type":"text","text":"EPUB Accessibility"}],"title":"EPUB Accessibility","url":"https:\/\/www.w3.org\/TR\/epub-a11y-11"}}}