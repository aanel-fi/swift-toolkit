{"abstract":[{"text":"Errors while checking the status of the License, using the Status Document.","type":"text"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Readium\/s5ErrorP","doc:\/\/Readium\/s8SendableP"],"kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StatusError","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"For the case (revoked, returned, cancelled, expired), app should notify the","type":"text"},{"text":" ","type":"text"},{"text":"user and stop there. The message to the user must be clear about the status","type":"text"},{"text":" ","type":"text"},{"text":"of the license: don’t display “expired” if the status is “revoked”. The","type":"text"},{"text":" ","type":"text"},{"text":"date and time corresponding to the new status should be displayed (e.g.","type":"text"},{"text":" ","type":"text"},{"text":"“The license expired on 01 January 2018”).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the license has been revoked, the user message should display the number"},{"type":"text","text":" "},{"type":"text","text":"of devices which registered to the server. This count can be calculated"},{"type":"text","text":" "},{"type":"text","text":"from the number of “register” events in the status document. If no event is"},{"type":"text","text":" "},{"type":"text","text":"logged in the status document, no such message should appear (certainly not"},{"type":"text","text":" "},{"type":"text","text":"“The license was registered by 0 devices”)."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/readiumlcp\/statuserror"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"title":"Enumeration Cases","identifier